    # 🖨️ PRINT BLOCK
    print(f"\n{B}====== {T}ZONES{B} ====={X}")
    print(f"{S}sell:{X} {N}${zone_machine.sell_zone[0]:.4f}{X} - {N}${zone_machine.sell_zone[1]:.4f}{X}")
    print(f"{S}neutral:{X} {N}${zone_machine.neutral_zone[0]:.4f}{X} - {N}${zone_machine.neutral_zone[1]:.4f}{X}")
    print(f"{S}buy:{X} {N}${zone_machine.buy_zone[0]:.4f}{X} - {N}${zone_machine.buy_zone[1]:.4f}{X}")
    print(f"{B}====== {T}POSITION{B} =========={X}")
    print(f"{S}Zone:{X} {N}{zone}{X} {S}| Trend:{X} {N}{trend}{X}")
    print(f"{S}avg high:{X} {N}${avg_h:.4f}{X} {S}| avg low:{X} {N}${avg_l:.4f}{X}")
    print(f"{S}median price:{X} {N}${med:.4f}{X}")
    print(f"{B}====== {T}MARKET STATUS{B} ======{X}")
    print(f"{S}Status:{X} {N}{'ACTIVE' if active else 'WAITING'}{X} {S}| Last Action:{X} {N}{last_type}{X}")
    print(f"{S}active tokens:{X} {N}{amt:.8f}{X}")
    print(f"{S}entry price:{X} {N}${entry_price:.4f}{X} {S}| Current Price:{X} {N}${price:.4f}{X}")
