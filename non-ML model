# ========================== API / UTILITIES ==========================
def get_valid_kraken_pair(pair):
    variations = [pair, f"X{pair}", f"{pair}Z", f"X{pair}Z", pair.replace("USD", "ZUSD"), f"X{pair.replace('USD', '')}ZUSD"]
    for variation in variations:
        try:
            response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={variation}', timeout=5)
            data = response.json()
            if 'error' not in data or not data['error']: return variation
        except: continue
    return pair

def get_ohlc(pair, interval, lookback):
    since = int((time.time() - lookback * interval * 60) // 1)
    try:
        response = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC", params={'pair': pair, 'interval': interval, 'since': since}, timeout=10).json()
        if 'error' in response and response['error']: return []
        pair_key = list(response['result'].keys())[0]
        return [{'timestamp': float(r[0]), 'high': float(r[2]), 'low': float(r[3]), 'close': float(r[4])} for r in response['result'][pair_key]]
    except: return []

def get_ticker():
    try:
        response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={KRAKEN_PAIR}', timeout=5).json()
        if 'error' in response and response['error']: return None
        valid_pair = list(response['result'].keys())[0]
        return float(response['result'][valid_pair]['c'][0])
    except: return None

def get_order_book(pair, count=ORDERBOOK_DEPTH_LEVELS):
    try:
        resp = requests.get(f"{API_URL}/{API_VERSION}/public/Depth", params={'pair': pair, 'count': min(count, 500)}, timeout=10).json()
        if 'error' in resp and resp['error']: return None
        pair_key = list(resp['result'].keys())[0]
        ob = resp['result'][pair_key]
        return {'bids': [(float(p), float(v)) for p, v, *_ in ob.get('bids', [])], 'asks': [(float(p), float(v)) for p, v, *_ in ob.get('asks', [])]}
    except: return None

def simulate_market_fill(side, base_amount, order_book):
    if order_book is None: return False, None, None, 0
    levels = order_book['asks'] if side == 'buy' else order_book['bids']
    cum_base, used_quote, consumed = 0.0, 0.0, 0
    for price, available in levels:
        take = min(available, base_amount - cum_base)
        used_quote += take * price
        cum_base += take; consumed += 1
        if cum_base >= base_amount - 1e-12: break
    if cum_base + 1e-12 < base_amount: return False, None, None, consumed
    return True, used_quote / base_amount, used_quote, consumed

def dynamic_position_size(price, side, max_investment=INVESTMENT_AMOUNT):
    ob = get_order_book(KRAKEN_PAIR)
    if ob is None: return 0, None, None
    levels = ob['asks'] if side == 'buy' else ob['bids']
    total_base_available = sum(v for _, v in levels)
    if total_base_available == 0: return 0, None, None
    target_base = max_investment / price
    low, high = 0.0, min(target_base, total_base_available)
    best_base, best_price, best_slippage = 0.0, price, 0.0
    for _ in range(20):
        mid = (low + high) / 2
        if mid < 1e-12: break
        filled, exec_price, _, _ = simulate_market_fill('buy', mid, ob)
        if filled:
            slippage = abs(exec_price - price) / price
            if slippage <= MAX_SLIPPAGE_PCT:
                best_base, best_price, best_slippage = mid, exec_price, slippage
                low = mid
            else: high = mid
        else: high = mid
    if best_base * best_price < MIN_ORDER_USD: return 0, None, None
    return best_base, best_price, best_slippage

def calculate_precise_profit(entry, exit_price, amount):
    if entry is None or exit_price is None or amount is None: return 0.0
    return (amount * exit_price * (1 - FEE_RATE)) - (amount * entry * (1 + FEE_RATE))

def kraken_request(uri_path, data):
    headers = {'API-Key': API_KEY}
    nonce = str(int(time.time() * 1000))
    data['nonce'] = nonce
    postdata = urllib.parse.urlencode(data)
    encoded = (nonce + postdata).encode()
    message = uri_path.encode() + hashlib.sha256(encoded).digest()
    api_secret = API_SECRET.strip().replace('\n', '').replace(' ', '')
    if len(api_secret) % 4 != 0: api_secret += '=' * (4 - len(api_secret) % 4)
    try:
        secret = base64.b64decode(api_secret)
        headers['API-Sign'] = base64.b64encode(hmac.new(secret, message, hashlib.sha512).digest()).decode()
        for attempt in range(3):
            try:
                response = requests.post(API_URL + uri_path, data=data, headers=headers, timeout=10)
                if response.status_code == 429: time.sleep(min(60, 2**attempt + 1)); continue
                response.raise_for_status()
                return response.json()
            except: time.sleep(2**attempt)
        return {'error': ['Max retries exceeded']}
    except Exception as e:
        return {'error': [str(e)]}

def place_order(order_type, amount, price, ordertype='market', price2=None):
    amount = round(amount, BOND_DECIMALS)
    data = {'ordertype': ordertype, 'type': order_type, 'volume': str(amount), 'pair': KRAKEN_PAIR, 'validate': 'false'}
    if ordertype == 'limit': data['price'] = str(round(price, 8))
    elif ordertype == 'stop-loss-limit': data['price'], data['price2'] = str(round(price, 8)), str(round(price2, 8))
    try:
        result = kraken_request(f'/{API_VERSION}/private/AddOrder', data)
        if 'error' in result and result['error']:
            err = result['error'][0] if isinstance(result['error'], list) else str(result['error'])
            if "Insufficient funds" in err: print(f"{BORDER}❌ INSUFFICIENT FUNDS{RESET}")
            elif "Order too small" in err: print(f"{BORDER}❌ ORDER TOO SMALL{RESET}")
            else: print(f"{BORDER}❌ {err}{RESET}")
            return result
        return result
    except Exception as e: return {'error': [str(e)]}

def calculate_macd_proper(ohlc_data, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL):
    if len(ohlc_data) < slow + signal: return None, None, None
    closes = [c['close'] for c in ohlc_data]
    def ema(data, span):
        alpha = 2 / (span + 1); vals = [data[0]]
        for v in data[1:]: vals.append(alpha*v + (1-alpha)*vals[-1])
        return vals
    fast_ema, slow_ema = ema(closes, fast), ema(closes, slow)
    macd_line = [f-s for f,s in zip(fast_ema, slow_ema)]
    signal_line = ema(macd_line, signal)
    return macd_line[-1], signal_line[-1], None

# ========================== 🗺️ ZONE MACHINE ==========================
class BestValueZoneMachine4Dec:
    def __init__(self, pair):
        self.pair = pair
        self.buy_zone = self.neutral_zone = self.sell_zone = None
        self.median = 0.0
        self.in_sell_zone = self.in_buy_zone = False
        self.sell_highs, self.buy_lows = [], []
        self.best_sell_price = self.max_avg_high_seen = None
        self.best_buy_price = self.min_avg_low_seen = None

    def initialize_zones(self, ohlc_data):
        if not ohlc_data or len(ohlc_data) < 10: return False
        highs = np.array([x['high'] for x in ohlc_data]); lows = np.array([x['low'] for x in ohlc_data])
        self.median = float((np.median(highs) + np.median(lows)) / 2)
        nl, nu = round(self.median - ZONE_BUFFER/2, 4), round(self.median + ZONE_BUFFER/2, 4)
        self.neutral_zone = (nl, nu)
        self.buy_zone = (round(nl - BUY_ZONE_EXTRA, 4), nl)
        self.sell_zone = (nu, round(nu + SELL_ZONE_EXTRA, 4))
        self._reset_trackers()
        return True

    def _reset_trackers(self):
        self.sell_highs = self.buy_lows = []
        self.in_sell_zone = self.in_buy_zone = False
        self.best_sell_price = self.best_buy_price = self.max_avg_high_seen = self.min_avg_low_seen = None

    def price_zone(self, price):
        if self.buy_zone and self.buy_zone[0] <= price < self.buy_zone[1]: return "BUY"
        if self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]: return "NEUTRAL"
        if self.sell_zone and self.sell_zone[0] < price <= self.sell_zone[1]: return "SELL"
        return "OUTSIDE"

    def zones_expired(self, price):
        global outside_zone_since
        now = time.time()
        if self.price_zone(price) == "OUTSIDE":
            if outside_zone_since is None: outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME: outside_zone_since = None; return True
        else: outside_zone_since = None
        return False

    def track_best_buy(self, price):
        if self.price_zone(price) == "BUY":
            self.buy_lows.append(price)
            if not self.in_buy_zone: self.in_buy_zone = True; self.best_buy_price = price; self.min_avg_low_seen = price
            else:
                if price < self.best_buy_price: self.best_buy_price = price
                if self.min_avg_low_seen is None or np.mean(self.buy_lows) < self.min_avg_low_seen: self.min_avg_low_seen = np.mean(self.buy_lows)
            if BUY_AT_LOWEST_AVERAGE and self.min_avg_low_seen:
                ref = self.min_avg_low_seen
                return ref*(1-ENTRY_RANGE_PCT) <= price <= ref*(1+ENTRY_RANGE_PCT)
        else: self.in_buy_zone = False
        return False

    def track_best_sell(self, price, entry_price, token_amount):
        if self.price_zone(price) == "SELL":
            self.sell_highs.append(price)
            if not self.in_sell_zone: self.in_sell_zone = True; self.best_sell_price = price; self.max_avg_high_seen = price
            else:
                if price > self.best_sell_price: self.best_sell_price = price
                if self.max_avg_high_seen is None or np.mean(self.sell_highs) > self.max_avg_high_seen: self.max_avg_high_seen = np.mean(self.sell_highs)
            if SELL_AT_HIGHEST_AVERAGE and self.max_avg_high_seen:
                ref = self.max_avg_high_seen
                return ref*(1-ENTRY_RANGE_PCT) <= price <= ref*(1+ENTRY_RANGE_PCT)
        else:
            self.in_sell_zone = False
            return calculate_precise_profit(entry_price, self.best_sell_price, token_amount) >= MIN_PROFIT
        return False

