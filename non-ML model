                    entry_price = actual_entry
                    token_amount = amount
                    position_investment = amount * actual_entry
                    last_trade_time = time.time()
                   
            elif trigger == "SELL" and active_position:
                print(f"{COLOR_GREEN}💰 MANUAL SELL TRIGGERED! Price: ${price:.4f}{COLOR_RESET}")
                # For sell, we have exact token amount; just check liquidity
                depth_info = estimate_slippage_and_liquidity('sell', price, token_amount)
                if not depth_info['filled']:
                    print(f"{COLOR_RED}Insufficient liquidity to sell full position{COLOR_RESET}")
                    continue
                slippage = depth_info['slippage_pct']
                if slippage > MAX_SLIPPAGE_PCT:
                    print(f"{COLOR_RED}Manual sell skipped: slippage {slippage*100:.4f}% > limit{COLOR_RESET}")
                    continue
                order_result = place_order('sell', token_amount, depth_info['exec_price'])
                logging.info(f"Manual sell order_result: {order_result}")
                if 'error' in order_result and order_result['error']:
                    print(f"{COLOR_RED}Sell error: {order_result['error']}{COLOR_RESET}")
                else:
                    actual_exit = depth_info['exec_price']
                    profit = calculate_precise_profit(entry_price, actual_exit, token_amount)
                    print(f"{COLOR_GREEN}Sold {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ approx ${actual_exit:.4f}{COLOR_RESET}")
                    print(f"{COLOR_GREEN}Entry: ${entry_price:.4f} | Exit: ${actual_exit:.4f} | Profit: ${profit:.4f}{COLOR_RESET}")
