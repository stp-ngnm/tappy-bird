# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time, last_trend, last_trade_type, KRAKEN_PAIR
    
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zone_machine = BestValueZoneMachine4Dec(KRAKEN_PAIR)
    threading.Thread(target=config_monitor, daemon=True).start()
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")

    while True:
        try:
            while not manual_trigger_queue.empty():
                trigger = manual_trigger_queue.get()
                price = get_ticker()
                if not price: continue
                if trigger == "BUY" and not active_position:
                    amt, ep, _ = dynamic_position_size(price, 'buy')
                    if amt > 0 and not place_order('buy', amt, ep or price).get('error'): 
                        active_position = True; entry_price = ep or price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "MANUAL BUY"
                elif trigger == "SELL" and active_position:
                    if not place_order('sell', token_amount, price).get('error'): 
                        active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "MANUAL SELL"

            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 4)

            # 📊 FETCH 5-HOUR OHLC FOR DASHBOARD & ZONES
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 10:
                highs = [x['high'] for x in ohlc]
                lows = [x['low'] for x in ohlc]
                aH = np.max(highs)   # True 5-hour swing high
                aL = np.min(lows)    # True 5-hour swing low
                aM = float((np.median(highs) + np.median(lows)) / 2)
                if not zone_machine.buy_zone: zone_machine.initialize_zones(ohlc)
            else:
                aH = aL = aM = 0.0

            # MACD Trend (For display only, no execution gating)
            trend = "neutral"
            try:
                hour_ohlc = get_ohlc(KRAKEN_PAIR, 60, 100)
                if hour_ohlc:
                    macd, sig, _ = calculate_macd_proper(hour_ohlc)
                    if macd and sig: trend = "up" if macd > sig else "down"
            except: pass
            last_trend = trend

            if zone_machine.zones_expired(price): 
                if ohlc: zone_machine.initialize_zones(ohlc)
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # 🛡️ STOP-LOSS
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                place_order('sell', token_amount, price, ordertype='stop-loss-limit', price2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # Auto BUY (Trend-independent)
            if not active_position and (time.time() - last_trade_time > TRADE_MIN_INTERVAL):
                if zone_machine.track_best_buy(price):
                    amt, ep, slip = dynamic_position_size(price, 'buy')
                    if amt > 0 and (slip is None or slip <= MAX_SLIPPAGE_PCT):
                        if not place_order('buy', amt, ep or price).get('error'):
                            active_position = True; entry_price = ep or price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "AUTO BUY"

            # Auto SELL (Trend-independent Profit Exit)
            if active_position:
                if zone_machine.track_best_sell(price, entry_price, token_amount):
                    ob = get_order_book(KRAKEN_PAIR)
                    if ob:
                        filled, exec_price, _, _ = simulate_market_fill('sell', token_amount, ob)
                        slippage = abs(exec_price - price) / price if filled else 1.0
                        if sum(v for _, v in ob['bids']) >= token_amount * MIN_LIQUIDITY_RATIO and slippage <= MAX_SLIPPAGE_PCT:
                            if not place_order('sell', token_amount, exec_price).get('error'):
                                active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"

            profit_usd = calculate_precise_profit(entry_price, price, token_amount) if active_position else 0.0
            print_dashboard(price, zone_machine, last_trend, active_position, token_amount, profit_usd, last_trade_type, entry_price, aH, aL, aM)
            time.sleep(PRICE_CHECK_INTERVAL)
            
        except KeyboardInterrupt: print("\n⏹️ Exiting..."); sys.exit(0)
        except Exception as e: logging.error(f"Loop error: {e}"); time.sleep(10)

if __name__ == "__main__":
    main()