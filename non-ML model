                print(f"{COLOR_MAGENTA}Pivots — P: {zone_machine.pivots['pivot']:.4f} R1: {zone_machine.pivots['r1']:.4f} S1: {zone_machine.pivots['s1']:.4f}{COLOR_RESET}")
