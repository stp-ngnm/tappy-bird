def get_valid_kraken_pair(pair):
    variations = [pair, f"X{pair}", f"{pair}Z", f"X{pair}Z", pair.replace("USD", "ZUSD"), f"X{pair.replace('USD', '')}ZUSD"]
    for variation in variations:
        try:
            response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={variation}', timeout=5)
            data = response.json()
            if 'error' not in data or not data['error']:
                if DEBUG: print(f"{COLOR_GREEN}Using pair format: {variation}{COLOR_RESET}")
                return variation
        except Exception as e:
            logging.warning(f"Pair validation error: {str(e)}")
            continue
    print(f"{COLOR_RED}Could not validate pair format, using {pair}{COLOR_RESET}")
    return pair

def get_ohlc(pair, interval, lookback):
    since = int((time.time() - lookback * interval * 60) // 1)
    params = {'pair': pair, 'interval': interval, 'since': since}
    try:
        response = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC", params=params, timeout=10)
        data = response.json()
        if 'error' in data and data['error']: return []
        pair_key = list(data['result'].keys())[0]
        return [{'timestamp': float(r[0]), 'open': float(r[1]), 'high': float(r[2]), 'low': float(r[3]), 'close': float(r[4])} for r in data['result'][pair_key]]
    except Exception as e:
        logging.error(f"OHLC Error: {str(e)}")
        return []

def get_ticker():
    try:
        response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={KRAKEN_PAIR}', timeout=5)
        data = response.json()
        if 'error' in data and data['error']: return None
        valid_pair = list(data['result'].keys())[0]
        return float(data['result'][valid_pair]['c'][0])
    except Exception as e:
        logging.error(f"Ticker Error: {str(e)}")
        return None

def get_order_book(pair, count=ORDERBOOK_DEPTH_LEVELS):
    try:
        actual_count = min(count, 500)
        resp = requests.get(f"{API_URL}/{API_VERSION}/public/Depth", params={'pair': pair, 'count': actual_count}, timeout=10)
        data = resp.json()
        if 'error' in data and data['error']: return None
        pair_key = list(data['result'].keys())[0]
        ob = data['result'][pair_key]
        return {
            'bids': [(float(p), float(v)) for p, v, *_ in ob.get('bids', [])],
            'asks': [(float(p), float(v)) for p, v, *_ in ob.get('asks', [])]
        }
    except Exception as e:
        logging.error(f"Order book fetch error: {str(e)}")
        return None

def simulate_market_fill(side, base_amount, order_book):
    if order_book is None: return False, None, None, 0
    levels = order_book['asks'] if side == 'buy' else order_book['bids']
    cum_base, used_quote, consumed = 0.0, 0.0, 0
    for price, available in levels:
        take = min(available, base_amount - cum_base)
        used_quote += take * price
        cum_base += take; consumed += 1
        if cum_base >= base_amount - 1e-12: break
    if cum_base + 1e-12 < base_amount: return False, None, None, consumed
    return True, used_quote / base_amount, used_quote, consumed

def dynamic_position_size(price, side, max_investment=INVESTMENT_AMOUNT):
    ob = get_order_book(KRAKEN_PAIR, count=ORDERBOOK_DEPTH_LEVELS)
    if ob is None: return 0, None, None
    levels = ob['asks'] if side == 'buy' else ob['bids']
    total_base_available = sum(v for _, v in levels)
    if total_base_available == 0: return 0, None, None
    target_base = max_investment / price
    low, high = 0.0, min(target_base, total_base_available)
    best_base, best_price, best_slippage = 0.0, price, 0.0
    for _ in range(20):
        mid = (low + high) / 2
        if mid < 1e-12: break
        filled, exec_price, _, _ = simulate_market_fill('buy', mid, ob)
        if filled:
            slippage = abs(exec_price - price) / price
            if slippage <= MAX_SLIPPAGE_PCT:
                best_base, best_price, best_slippage = mid, exec_price, slippage
                low = mid
            else: high = mid
        else: high = mid
    if best_base * best_price < MIN_ORDER_USD: return 0, None, None
    return best_base, best_price, best_slippage

def calculate_precise_profit(entry, exit_price, amount):
    if entry is None or exit_price is None or amount is None: return 0.0
    cost_basis = amount * entry * (1 + FEE_RATE)
    net_proceeds = amount * exit_price * (1 - FEE_RATE)
    return net_proceeds - cost_basis

def kraken_request(uri_path, data):
    headers = {'API-Key': API_KEY}
    nonce = str(int(time.time() * 1000))
    data['nonce'] = nonce
    postdata = urllib.parse.urlencode(data)
    encoded = (nonce + postdata).encode()
    message = uri_path.encode() + hashlib.sha256(encoded).digest()
    
    api_secret = API_SECRET.strip().replace('\n', '').replace(' ', '')
    if len(api_secret) % 4 != 0: api_secret += '=' * (4 - len(api_secret) % 4)
        
    try:
        secret = base64.b64decode(api_secret)
        mac = hmac.new(secret, message, hashlib.sha512)
        headers['API-Sign'] = base64.b64encode(mac.digest()).decode()
        
        for attempt in range(3):
            try:
                response = requests.post(API_URL + uri_path, data=data, headers=headers, timeout=10)
                if response.status_code == 429:
                    wait = min(60, 2**attempt + 1)
                    logging.warning(f"⏳ Rate limited. Backing off {wait}s...")
                    time.sleep(wait)
                    continue
                response.raise_for_status()
                return response.json()
            except Exception as e:
                if attempt == 2: logging.error(f"❌ Request failed after retries: {e}")
                time.sleep(2**attempt)
        return {'error': ['Max retries exceeded']}
    except Exception as e:
        logging.error(f"🔑 API Signing Error: {str(e)}")
        return {'error': [str(e)]}

def place_order(order_type, amount, price, ordertype='market', price2=None):
    amount = round(amount, BOND_DECIMALS)
    data = {'ordertype': ordertype, 'type': order_type, 'volume': str(amount), 'pair': KRAKEN_PAIR, 'validate': 'false'}
    if ordertype == 'limit': data['price'] = str(round(price, 8))
    elif ordertype == 'stop-loss-limit':
        data['price'] = str(round(price, 8))
        data['price2'] = str(round(price2, 8))
        
    print(f"{COLOR_YELLOW}📤 Placing {order_type.upper()} ({ordertype}) for {amount:.4f} @ ${price:.4f}{COLOR_RESET}")
    try:
        result = kraken_request(f'/{API_VERSION}/private/AddOrder', data)
        if 'error' in result and result['error']:
            err = result['error'][0] if isinstance(result['error'], list) else str(result['error'])
            if "Insufficient funds" in err: print(f"{COLOR_RED}❌ INSUFFICIENT FUNDS: Check quote balance.{COLOR_RESET}")
            elif "Order too small" in err: print(f"{COLOR_RED}❌ ORDER TOO SMALL: Below Kraken min.{COLOR_RESET}")
            else: print(f"{COLOR_RED}❌ Order Rejected: {err}{COLOR_RESET}")
            return result
        print(f"{COLOR_GREEN}✅ Order Placed Successfully.{COLOR_RESET}")
        return result
    except Exception as e:
        print(f"{COLOR_RED}❌ Order Exception: {str(e)}{COLOR_RESET}")
        return {'error': [str(e)]}

# ========================== 🤖 ML TRADING ADVISOR ==========================
class MLTradingAdvisor:
    def __init__(self):
        from sklearn.ensemble import RandomForestClassifier, GradientBoostingRegressor
        from sklearn.model_selection import TimeSeriesSplit, RandomizedSearchCV
        from sklearn.preprocessing import StandardScaler
        from scipy.stats import randint, uniform
        
        self.RandomForestClassifier = RandomForestClassifier
        self.GradientBoostingRegressor = GradientBoostingRegressor
        self.TimeSeriesSplit = TimeSeriesSplit
        self.RandomizedSearchCV = RandomizedSearchCV
        self.StandardScaler = StandardScaler
        self.randint = randint
        self.uniform = uniform

        self.entry_model = None
        self.exit_model = None
        self.scaler = self.StandardScaler()
        self.feature_history = deque(maxlen=100)
        self.trade_history = []
        self.models_trained = False
        self.feature_names = [
            'price_momentum_5', 'price_momentum_10', 'volatility',
            'zone_buy', 'zone_sell', 'zone_neutral', 'zone_depth',
            'trend_up', 'trend_down', 'spread_pct', 'order_imbalance',
            'liquidity_score', 'current_pnl_pct', 'hold_time_min'
        ]
        self.load_models()

    def extract_features(self, price, zone_machine, trend, order_book, position_state):
        features = {}
        if self.feature_history:
            prev_prices = [f['price'] for f in self.feature_history]
            features['price_momentum_5'] = (price - prev_prices[-5]) / prev_prices[-5] if len(prev_prices) >= 5 else 0
            features['price_momentum_10'] = (price - prev_prices[-10]) / prev_prices[-10] if len(prev_prices) >= 10 else 0
            features['volatility'] = np.std(prev_prices[-20:]) / np.mean(prev_prices[-20:]) if len(prev_prices) >= 20 else 0
        else:
            features['price_momentum_5'] = features['price_momentum_10'] = features['volatility'] = 0

        zone = zone_machine.price_zone(price)
        features['zone_buy'] = 1 if zone == "BUY" else 0
        features['zone_sell'] = 1 if zone == "SELL" else 0
        features['zone_neutral'] = 1 if zone == "NEUTRAL" else 0
        if zone_machine.buy_zone and zone == "BUY":
            features['zone_depth'] = (price - zone_machine.buy_zone[0]) / (zone_machine.buy_zone[1] - zone_machine.buy_zone[0])
        elif zone_machine.sell_zone and zone == "SELL":
            features['zone_depth'] = (zone_machine.sell_zone[1] - price) / (zone_machine.sell_zone[1] - zone_machine.sell_zone[0])
        else:
            features['zone_depth'] = 0.5

        features['trend_up'] = 1 if trend == 'up' else 0
        features['trend_down'] = 1 if trend == 'down' else 0

        if order_book and order_book['bids'] and order_book['asks']:
            bid_vol = sum(v for _, v in order_book['bids'][:10])
            ask_vol = sum(v for _, v in order_book['asks'][:10])
            features['spread_pct'] = (order_book['asks'][0][0] - order_book['bids'][0][0]) / order_book['bids'][0][0]
            features['order_imbalance'] = (bid_vol - ask_vol) / (bid_vol + ask_vol)
            features['liquidity_score'] = (bid_vol + ask_vol) / price
        else:
            features['spread_pct'] = features['order_imbalance'] = features['liquidity_score'] = 0

        if position_state['active']:
            features['current_pnl_pct'] = (price - position_state['entry_price']) / position_state['entry_price']
            features['hold_time_min'] = (time.time() - position_state['entry_time']) / 60
        else:
            features['current_pnl_pct'] = features['hold_time_min'] = 0

        self.feature_history.append({**features, 'price': price})
        return features

    def _features_to_vector(self, features):
        return [features.get(k, 0) for k in self.feature_names]

    def predict_entry_confidence(self, features):
        if not self.models_trained or self.entry_model is None: return 0.5
        vec = self._features_to_vector(features).reshape(1, -1)
        vec = self.scaler.transform(vec)
        return self.entry_model.predict_proba(vec)[0][1]

    def predict_expected_profit(self, features):
        if not self.models_trained or self.exit_model is None:
            return features.get('current_pnl_pct', 0) * 100
        vec = self._features_to_vector(features).reshape(1, -1)
        vec = self.scaler.transform(vec)
        return float(self.exit_model.predict(vec)[0])

    def record_outcome(self, entry_features, exit_price, entry_price, amount):
        profit = calculate_precise_profit(entry_price, exit_price, amount)
        self.trade_history.append({
            'features': entry_features,
            'profit': profit,
            'label': 1 if profit >= MIN_PROFIT else 0
        })
        if len(self.trade_history) >= ML_RETRAIN_INTERVAL:
            self._train_and_tune()

    def _train_and_tune(self):
        import os
        os.makedirs(ML_MODEL_PATH, exist_ok=True)
        if len(self.trade_history) < 30: return
        X = np.array([self._features_to_vector(t['features']) for t in self.trade_history])
        y_entry = np.array([t['label'] for t in self.trade_history])
        y_exit = np.array([t['profit'] for t in self.trade_history])

        # Walk-Forward Validation Setup (TimeSeriesSplit)
        tscv = self.TimeSeriesSplit(n_splits=3)
        
        # Hyperparameter Tuning: Entry Model
        entry_param_dist = {'n_estimators': self.randint(50, 200), 'max_depth': self.randint(3, 10), 'min_samples_split': self.randint(2, 8)}
        entry_search = self.RandomizedSearchCV(self.RandomForestClassifier(random_state=42), entry_param_dist, n_iter=15, cv=tscv, scoring='accuracy', random_state=42)
        
        # Hyperparameter Tuning: Exit Model
        exit_param_dist = {'n_estimators': self.randint(50, 200), 'learning_rate': self.uniform(0.01, 0.2), 'max_depth': self.randint(2, 6)}
        exit_search = self.RandomizedSearchCV(self.GradientBoostingRegressor(random_state=42), exit_param_dist, n_iter=15, cv=tscv, scoring='neg_mean_squared_error', random_state=42)

        print(f"\n{COLOR_MAGENTA}🧠 ML Retraining (Walk-Forward + Hyperparameter Tuning)...{COLOR_RESET}")
        try:
            entry_search.fit(self.scaler.fit_transform(X), y_entry)
            exit_search.fit(self.scaler.transform(X), y_exit)
            
            self.entry_model = entry_search.best_estimator_
            self.exit_model = exit_search.best_estimator_
            self.models_trained = True
            
            print(f"{COLOR_GREEN}✅ Entry Acc: {entry_search.best_score_:.2%} | Exit MSE: {-exit_search.best_score_:.4f}{COLOR_RESET}")
            print(f"{COLOR_BLUE}Best Entry Params: {entry_search.best_params_}{COLOR_RESET}")
            print(f"{COLOR_BLUE}Best Exit Params: {exit_search.best_params_}{COLOR_RESET}")
            
            joblib.dump(self.entry_model, f"{ML_MODEL_PATH}entry.pkl")
            joblib.dump(self.exit_model, f"{ML_MODEL_PATH}exit.pkl")
            joblib.dump(self.scaler, f"{ML_MODEL_PATH}scaler.pkl")
            self.trade_history = self.trade_history[-200:]  # Keep recent
        except Exception as e:
            logging.error(f"ML Training failed: {e}")

    def load_models(self):
        import os
        try:
            if os.path.exists(f"{ML_MODEL_PATH}entry.pkl"):
                self.entry_model = joblib.load(f"{ML_MODEL_PATH}entry.pkl")
                self.exit_model = joblib.load(f"{ML_MODEL_PATH}exit.pkl")
                self.scaler = joblib.load(f"{ML_MODEL_PATH}scaler.pkl")
                self.models_trained = True
                print(f"{COLOR_GREEN}📦 ML Models loaded from {ML_MODEL_PATH}{COLOR_RESET}")
        except Exception as e:
            print(f"{COLOR_YELLOW}⚠️ No ML models found. Will train on first {ML_RETRAIN_INTERVAL} trades.{COLOR_RESET}")

# ========================== 🗺️ ZONE MACHINE ==========================
class BestValueZoneMachine4Dec:
    def __init__(self, pair):
        self.pair = pair
        self.buy_zone = self.neutral_zone = self.sell_zone = None
        self.in_sell_zone = self.in_buy_zone = False
        self.sell_highs, self.sell_lows, self.buy_highs, self.buy_lows = [], [], [], []
        self.best_sell_price = self.best_buy_price = None
        self.max_avg_high_seen = self.min_avg_low_seen = None

    def initialize_zones(self):
        print(f"{COLOR_CYAN}Calculating Zones...{COLOR_RESET}")
        ohlc_data = get_ohlc(self.pair, interval=1, lookback=MEDIAN_LOOKBACK)
        if not ohlc_data or len(ohlc_data) < 10:
            print(f"{COLOR_RED}Insufficient OHLC data!{COLOR_RESET}"); return False
        highs = np.array([x['high'] for x in ohlc_data]); lows = np.array([x['low'] for x in ohlc_data])
        median = float((np.median(highs) + np.median(lows)) / 2)
        nl = round(median - ZONE_BUFFER / 2, 4); nu = round(median + ZONE_BUFFER / 2, 4)
        self.neutral_zone = (nl, nu)
        self.buy_zone = (round(nl - BUY_ZONE_EXTRA, 4), nl)
        self.sell_zone = (nu, round(nu + SELL_ZONE_EXTRA, 4))
        self._reset_trackers()
        print(f"{COLOR_MAGENTA}✅ ZONES SET: BUY {self.buy_zone} | SELL {self.sell_zone}{COLOR_RESET}")
        return True

    def _reset_trackers(self):
        self.sell_highs = self.sell_lows = self.buy_highs = self.buy_lows = []
        self.in_sell_zone = self.in_buy_zone = False
        self.best_sell_price = self.best_buy_price = self.max_avg_high_seen = self.min_avg_low_seen = None

    def price_zone(self, price):
        if price is None: return "INVALID"
        if self.buy_zone and self.buy_zone[0] <= price < self.buy_zone[1]: return "BUY"
        if self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]: return "NEUTRAL"
        if self.sell_zone and self.sell_zone[0] < price <= self.sell_zone[1]: return "SELL"
        return "OUTSIDE"

    def zones_expired(self, price):
        global outside_zone_since
        s = self.price_zone(price); now = time.time()
        if s == "OUTSIDE":
            if outside_zone_since is None: outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME:
                print(f"{COLOR_YELLOW}⏱ Outside zones > {ZONE_RESET_HOLD_TIME}s. Resetting...{COLOR_RESET}")
                outside_zone_since = None; return True
        else: outside_zone_since = None
        return False

    def track_best_buy(self, price):
        if self.price_zone(price) == "BUY":
            self.buy_lows.append(price)
            if not self.in_buy_zone: self.in_buy_zone = True; self.best_buy_price = price; self.min_avg_low_seen = price
            else:
                if price < self.best_buy_price: self.best_buy_price = price
                avg = np.mean(self.buy_lows)
                if self.min_avg_low_seen is None or avg < self.min_avg_low_seen: self.min_avg_low_seen = avg
            if BUY_AT_LOWEST_AVERAGE and self.min_avg_low_seen:
                ref = self.min_avg_low_seen
                if ref*(1-ENTRY_RANGE_PCT) <= price <= ref*(1+ENTRY_RANGE_PCT): return ref
        else: self.in_buy_zone = False
        return None

    def track_best_sell(self, price, entry_price, token_amount):
        if self.price_zone(price) == "SELL":
            self.sell_highs.append(price)
            if not self.in_sell_zone: self.in_sell_zone = True; self.best_sell_price = price; self.max_avg_high_seen = price
            else:
                if price > self.best_sell_price: self.best_sell_price = price
                avg = np.mean(self.sell_highs)
                if self.max_avg_high_seen is None or avg > self.max_avg_high_seen: self.max_avg_high_seen = avg
            if SELL_AT_HIGHEST_AVERAGE and self.max_avg_high_seen:
                ref = self.max_avg_high_seen
                if ref*(1-ENTRY_RANGE_PCT) <= price <= ref*(1+ENTRY_RANGE_PCT): return ref
        else:
            self.in_sell_zone = False
            if calculate_precise_profit(entry_price, self.best_sell_price, token_amount) >= MIN_PROFIT:
                return self.best_sell_price
        return None

