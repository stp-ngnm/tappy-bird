        if zone_status == "SELL":
            avg_high = np.mean(zone_machine.sell_highs) if zone_machine.sell_highs else None
            print(f"{COLOR_BLUE}Tracked SELL avg_high: {avg_high}, max_avg_high_seen: {zone_machine.max_avg_high_seen}{COLOR_RESET}")

        # Zone reset check
        if zone_machine.zones_expired(price):
