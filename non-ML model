        price = round(price, 4)
       
        # UPDATE GLOBAL MIN/MAX TRACKERS
        if price < global_min_price:
            global_min_price = price
        if price > global_max_price:
            global_max_price = price

        # Fetch 1‑hour OHLC for MACD and support/resistance (we do this every cycle)
        hour_ohlc = get_ohlc(KRAKEN_PAIR, interval=60, lookback=100)  # enough for MACD
        if hour_ohlc:
            macd_line, signal_line, hist = calculate_macd(hour_ohlc, MACD_FAST, MACD_SLOW, MACD_SIGNAL)
            # Determine trend: if macd_line > signal_line, trend up; else down.
            if macd_line is not None:
                trend = 'up' if macd_line > signal_line else 'down'
            else:
                trend = None
            # Also refresh pivot points if we haven't or if it's been a while
            if zone_machine.pivots is None or (time.time() - zone_machine.zone_set_time > 24 * 3600):
                zone_machine.pivots = get_pivot_points(hour_ohlc)
        else:
            trend = None

        zone_status = zone_machine.price_zone(price)
       
        if DEBUG:
            print(f"\n{COLOR_CYAN}↗ Current Market Price: ${price:.4f} | Zone: {zone_status} | Trend: {trend}{COLOR_RESET}")
