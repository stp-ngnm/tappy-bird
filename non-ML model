# ========================== MAIN ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time, last_trend, last_trade_type, trading_paused, KRAKEN_PAIR
    
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zm = ZoneMachine()
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}")
    
    while True:
        try:
            # ======== PAUSED STATE (Priority Input Loop) ========
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    continue
                if cmd == 'r': trading_paused = False; print(f"{PROF_P}▶️ RESUMED{RESET}"); continue
                elif cmd == 'q': print("👋 Exiting..."); sys.exit(0)
                elif cmd in ('b', 's'): execute_manual(cmd); continue
                else: print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}")
                continue

            # ======== RUNNING STATE ========
            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 4)

            # 1. Fetch OHLC & Analyze Market State
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            market_state, aH, aL, momentum = analyze_market_state(ohlc, price)
            aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2) if ohlc else 0.0
            if not zm.buy_zone and ohlc: zm.init(ohlc)

            # 2. Trend Calculation (Display only)
            trend = market_state.replace("_", " ") if market_state != "neutral" else "neutral"
            last_trend = trend

            # 3. Stop Loss Check (Overrides All)
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                res = place_order('sell', token_amount, price, ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                if res and not res.get('error'):
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL); continue

            current_profit = calc_profit(entry_price, price, token_amount) if active_position else 0.0
            zone = zm.zone(price) if zm.buy_zone else "OUTSIDE"
            ob = get_order_book(KRAKEN_PAIR)

            # 🔵 CONSERVATIVE BUY LOGIC ("Afraid to Buy")
            # Requires: In BUY zone + Holding above avg_low + Not in strong down + Tight spread + Cooldown met
            can_buy = False
            if not active_position and (time.time() - last_trade_time) > AUTO_COOLDOWN_SEC:
                if zone == "BUY" and price >= aL * 0.995 and market_state not in ["strong_down", "weak_down"]:
                    if ob and ob['bids'] and ob['asks']:
                        spread = (ob['asks'][0][0] - ob['bids'][0][0]) / price
                        if spread <= MAX_BID_ASK_SPREAD_PCT:
                            can_buy = True
            
            if can_buy:
                amt = INVESTMENT_AMOUNT / price
                if amt * price >= MIN_ORDER_USD:
                    res = place_order('buy', amt, price)
                    if res and not res.get('error'):
                        active_position = True; entry_price = price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                        print_ticket("BUY", "SUCCESS", price, amt, trade_type="AUTO")

            # 🔴 SMART SELL LOGIC ("Smart to Sell")
            # Priority 1: Profit Target Met -> EXIT
            # Priority 2: In SELL Zone -> EXIT
            # Priority 3: Trend Reversal Down + In Profit -> EXIT (Protect gains)
            if active_position:
                can_sell = False
                if current_profit >= MIN_PROFIT: can_sell = True
                elif zone == "SELL": can_sell = True
                elif current_profit > 0 and market_state in ["weak_down", "strong_down"]: can_sell = True
                
                if can_sell:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                        print_ticket("SELL", "SUCCESS", price, token_amount, trade_type="AUTO")

            # 4. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount, current_profit, last_trade_type, entry_price, aH, aL, aM)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}"); time.sleep(10)

if __name__ == "__main__": main()