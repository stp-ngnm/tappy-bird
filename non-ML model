                    # Determine optimal buy amount using dynamic position sizing
                    amount, exec_price, slippage = dynamic_position_size(price, 'buy')
                    if amount <= 0:
                        logging.info("Auto-buy skipped: insufficient liquidity")
                    elif slippage is not None and slippage > MAX_SLIPPAGE_PCT:
                        logging.info(f"Auto-buy skipped: estimated slippage {slippage*100:.4f}% > MAX_SLIPPAGE_PCT")
