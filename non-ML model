def get_order_book(pair, count=ORDERBOOK_DEPTH_LEVELS):
    """
    Fetch order book depth. Kraken's public Depth endpoint returns up to 500 levels per side.
    """
    try:
        actual_count = min(count, 500)
        resp = requests.get(f"{API_URL}/{API_VERSION}/public/Depth", params={'pair': pair, 'count': actual_count}, timeout=10)
        data = resp.json()
        if 'error' in data and data['error']:
            logging.error(f"Depth error: {data['error']}")
            return None
        pair_key = list(data['result'].keys())[0]
        ob = data['result'][pair_key]
        bids = [(float(p), float(v)) for p, v, *_ in ob.get('bids', [])]
        asks = [(float(p), float(v)) for p, v, *_ in ob.get('asks', [])]
        return {'bids': bids, 'asks': asks}
    except Exception as e:
        logging.error(f"Order book fetch error: {str(e)}")
        return None

def simulate_market_fill(side, base_amount, order_book):
    """
    Simulate executing a market order consuming the order_book.
    side: 'buy' (consume asks) or 'sell' (consume bids)
    base_amount: amount of base asset to buy/sell
    order_book: dict from get_order_book()
    Returns:
    (filled: bool, executed_price_avg: float, used_quote_volume: float, consumed_levels)
    """
    if order_book is None:
        return False, None, None, 0
   
    levels = order_book['asks'] if side == 'buy' else order_book['bids']
    cum_base = 0.0
    used_quote = 0.0
    consumed = 0
   
    for price, available in levels:
        take = min(available, base_amount - cum_base)
        used_quote += take * price
        cum_base += take
        consumed += 1
        if cum_base >= base_amount - 1e-12:
            break
           
    if cum_base + 1e-12 < base_amount:
        return False, None, None, consumed
       
    executed_avg = used_quote / base_amount
    return True, executed_avg, used_quote, consumed

def estimate_slippage_and_liquidity(side, price_ref, base_amount):
    """
    Fetch order book and estimate:
    - whether the orderbook can fill base_amount within fetched depth
    - weighted avg execution price
    - slippage_pct relative to price_ref
    Returns dict with keys:
    'filled' (bool), 'exec_price' (float), 'slippage_pct' (float), 'levels_consumed' (int), 'available_base' (float)
    """
    ob = get_order_book(KRAKEN_PAIR, count=ORDERBOOK_DEPTH_LEVELS)
    if ob is None:
        return {'filled': False, 'reason': 'no_orderbook'}
   
    side_name = 'buy' if side == 'buy' else 'sell'
    filled, exec_price, used_quote, consumed = simulate_market_fill(side_name, base_amount, ob)
    available_base = sum([v for _, v in (ob['asks'] if side == 'buy' else ob['bids'])])
   
    if not filled:
        return {'filled': False, 'reason': 'insufficient_depth', 'available_base': available_base}
   
    # slippage vs reference price
    if price_ref is None or price_ref == 0:
        slippage = 0.0
    else:
        slippage = (exec_price - price_ref) / price_ref if side == 'buy' else (price_ref - exec_price) / price_ref
       
    return {
        'filled': True,
        'exec_price': float(exec_price),
        'slippage_pct': float(slippage),
        'levels_consumed': consumed,
        'available_base': available_base
    }

def kraken_request(uri_path, data):
    headers = {}
    headers['API-Key'] = API_KEY
    nonce = str(int(time.time() * 1000))
    data['nonce'] = nonce
    postdata = urllib.parse.urlencode(data)
    encoded = (nonce + postdata).encode()
    message = uri_path.encode() + hashlib.sha256(encoded).digest()
    api_secret = API_SECRET
    if len(api_secret) % 4 != 0:
        api_secret += '=' * (4 - len(api_secret) % 4)
    try:
        secret = base64.b64decode(api_secret)
        mac = hmac.new(secret, message, hashlib.sha512)
        headers['API-Sign'] = base64.b64encode(mac.digest()).decode()
        response = requests.post(API_URL + uri_path, data=data, headers=headers, timeout=10)
        try:
            return response.json()
        except Exception:
            return {'error': [f'Non-JSON response: {response.text}']}
    except Exception as e:
        logging.error(f"API Error: {str(e)}")
        return {'error': [str(e)]}

def place_order(order_type, amount, price):
    amount = round(amount, BOND_DECIMALS)
    data = {
        'ordertype': 'market',
        'type': order_type,
        'volume': amount,
        'pair': KRAKEN_PAIR,
        'validate': 'false'
    }
    print(f"{COLOR_YELLOW}Placing {order_type} order for {amount} at ${price:.4f}{COLOR_RESET}")
    try:
        result = kraken_request(f'/{API_VERSION}/private/AddOrder', data)
        logging.info(f"Order result: {result}")
        if 'error' in result and result['error']:
            logging.error(f"Order error details: {result['error']}")
        return result  # always return a dict
    except Exception as e:
        logging.error(f"Order placement exception: {str(e)}")
        return {'error': [str(e)]}

def calculate_precise_profit(entry, exit_price, amount):
    """
    Calculates net profit accounting for 0.36% fee on BOTH entry and exit.
    Formula: (Exit_Value * (1 - Fee)) - (Entry_Cost * (1 + Fee))
    """
    if entry is None or exit_price is None or amount is None:
        return None
    cost_basis = amount * entry * (1 + FEE_RATE)
    net_proceeds = amount * exit_price * (1 - FEE_RATE)
    return net_proceeds - cost_basis

def dynamic_position_size(price, side, max_investment=INVESTMENT_AMOUNT):
    """
    Determine the maximum base amount we can trade within the slippage limit.
    For buys: we want to spend up to max_investment quote, but stop if slippage exceeds MAX_SLIPPAGE_PCT.
    For sells: we want to sell up to max_investment/price base, but again bound by slippage.
    Returns (base_amount, estimated_exec_price, estimated_slippage) or (0, None, None) if impossible.
    """
    ob = get_order_book(KRAKEN_PAIR, count=ORDERBOOK_DEPTH_LEVELS)
    if ob is None:
        return 0, None, None

    # For buys, we consume asks; for sells, we consume bids.
    levels = ob['asks'] if side == 'buy' else ob['bids']
    # Determine maximum possible base that can be filled from the book (full depth)
    total_base_available = sum(v for _, v in levels)
    if total_base_available == 0:
        return 0, None, None

    # The maximum base we would like to trade (in terms of investment)
    target_base = max_investment / price  # for buys, this is the base we'd get if no slippage
    # For sells, the base is exactly the token amount we hold (which is fixed when we are in a position)
    # However, this function is called both for opening a position (where we don't know token amount yet)
    # and for closing (where token amount is known). We'll treat it generically:
    # For a buy, we try to spend up to max_investment; for a sell, we try to sell up to the held token amount.
    # But when called for a sell in auto-sell, we already have token_amount, so we will just check if we can sell that amount.
    # We'll handle the sell case separately by using estimate_slippage_and_liquidity for the exact amount.
    # This function is mainly for determining the optimal amount to open a position.
    # So for now, we assume side is 'buy' for position opening.
    if side != 'buy':
        # For sell, we should just check the exact amount using estimate_slippage_and_liquidity
        # But we can also compute max sellable if needed.
        # For simplicity, we return the full target_base and rely on the caller to check slippage.
        return target_base, price, 0.0

    # Binary search to find the largest base amount with slippage <= MAX_SLIPPAGE_PCT
    low, high = 0.0, min(target_base, total_base_available)
    best_base = 0.0
    best_price = price
    best_slippage = 0.0

    for _ in range(20):  # 20 iterations enough for double precision
        mid = (low + high) / 2
        if mid < 1e-12:
            break
        filled, exec_price, _, _ = simulate_market_fill('buy', mid, ob)
        if filled:
            slippage = (exec_price - price) / price
            if slippage <= MAX_SLIPPAGE_PCT:
                best_base = mid
                best_price = exec_price
                best_slippage = slippage
                low = mid
            else:
                high = mid
        else:
            high = mid

    return best_base, best_price, best_slippage

# ---- MACD calculation ----
def calculate_macd(ohlc_data, fast=12, slow=26, signal=9):
    """
    Calculate MACD from a list of OHLC objects (must have 'close').
    Returns (macd_line, signal_line, histogram) for the last available candle.
    """
    if len(ohlc_data) < slow + signal:
        return None, None, None
    closes = [c['close'] for c in ohlc_data]
    # Manual EMA implementation (no pandas)
    def ema(data, span):
        alpha = 2 / (span + 1)
        ema_values = [data[0]]
        for val in data[1:]:
            ema_values.append(alpha * val + (1 - alpha) * ema_values[-1])
        return ema_values
    fast_ema = ema(closes, fast)
    slow_ema = ema(closes, slow)
    macd_line = [f - s for f, s in zip(fast_ema, slow_ema)]
    signal_line = ema(macd_line, signal)
    histogram = [m - s for m, s in zip(macd_line, signal_line)]
    return macd_line[-1], signal_line[-1], histogram[-1]

# ---- Support/Resistance using pivot points ----
def get_pivot_points(ohlc_data):
    """
    Calculate pivot points (classic) using high, low, close of the last day (or lookback period).
    Returns (pivot, r1, r2, s1, s2) or None if insufficient data.
    """
    if len(ohlc_data) < S_R_LOOKBACK_DAYS * 24:
        return None
    # Use the last S_R_LOOKBACK_DAYS days of 1‑hour candles
    last_day = ohlc_data[-24:]  # assuming 1‑hour interval
    high = max([c['high'] for c in last_day])
    low = min([c['low'] for c in last_day])
    close = last_day[-1]['close']
    pivot = (high + low + close) / 3
    r1 = 2 * pivot - low
    r2 = pivot + (high - low)
    s1 = 2 * pivot - high
    s2 = pivot - (high - low)
    return {'pivot': pivot, 'r1': r1, 'r2': r2, 's1': s1, 's2': s2}

# ---- Zone Machine with integrated support/resistance ----
class BestValueZoneMachine4Dec:
    def __init__(self, pair):
        self.pair = pair
        self.zone_initialized = False
        self.buy_zone = None
        self.neutral_zone = None
        self.sell_zone = None
        self.median = None
        self.zone_set_time = None
        # support/resistance levels
        self.pivots = None
       
        # SELL zone tracking
        self.in_sell_zone = False
        self.sell_highs = []
        self.sell_lows = []
        self.best_sell_price = None
        self.max_avg_high_seen = None
       
        # BUY zone tracking
        self.in_buy_zone = False
        self.buy_highs = []
        self.buy_lows = []
        self.best_buy_price = None
        self.min_avg_low_seen = None

    def initialize_zones(self, use_bollinger=False):
        print(f"{COLOR_CYAN}Calculating Zones...{COLOR_RESET}")
        ohlc_data = get_ohlc(self.pair, interval=1, lookback=MEDIAN_LOOKBACK)
        if not ohlc_data or len(ohlc_data) < 10:
            print(f"{COLOR_RED}Insufficient OHLC data for zone calculation!{COLOR_RESET}")
            return False
           
        if use_bollinger:
            closes = np.array([row['close'] for row in ohlc_data[-20:] if row.get('close') is not None])
            if len(closes) < 20:
                print(f"{COLOR_RED}Insufficient data for Bollinger zones!{COLOR_RESET}")
                return False
            sma = np.mean(closes)
            std = np.std(closes)
            upper = sma + 2 * std
            lower = sma - 2 * std
            self.median = float(np.mean([lower, upper]))
            neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
            neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
            self.neutral_zone = (neutral_lower, neutral_upper)
            self.buy_zone = (round(lower, 4), neutral_lower)
            self.sell_zone = (neutral_upper, round(upper, 4))
        else:
            highs = np.array([x['high'] for x in ohlc_data])
            lows = np.array([x['low'] for x in ohlc_data])
            self.median = float((np.median(highs) + np.median(lows)) / 2)
            neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
            neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
            self.neutral_zone = (neutral_lower, neutral_upper)
            self.buy_zone = (round(neutral_lower - BUY_ZONE_EXTRA, 4), neutral_lower)
            self.sell_zone = (neutral_upper, round(neutral_upper + SELL_ZONE_EXTRA, 4))
           
        self.zone_initialized = True
        self.zone_set_time = time.time()
       
        # reset trackers & averages
        self.sell_highs = []
        self.sell_lows = []
        self.buy_highs = []
        self.buy_lows = []
        self.in_sell_zone = False
        self.in_buy_zone = False
        self.best_sell_price = None
        self.best_buy_price = None
        self.max_avg_high_seen = None
        self.min_avg_low_seen = None
       
        print(f"{COLOR_MAGENTA}=== ZONES INITIALIZED ==={COLOR_RESET}")
        print(f"Median:      ${self.median:.4f}")
        print(f"Buy Zone:    [${self.buy_zone[0]:.4f} - ${self.buy_zone[1]:.4f}]")
        print(f"Neutral Zone:[${self.neutral_zone[0]:.4f} - ${self.neutral_zone[1]:.4f}]")
        print(f"Sell Zone:   [${self.sell_zone[0]:.4f} - ${self.sell_zone[1]:.4f}]")
        print(f"{COLOR_MAGENTA}========================={COLOR_RESET}")

        # Also compute pivot points for this session
        hour_ohlc = get_ohlc(self.pair, interval=60, lookback=24)
        if hour_ohlc:
            self.pivots = get_pivot_points(hour_ohlc)
            if self.pivots:
                print(f"{COLOR_CYAN}Pivot points: P=${self.pivots['pivot']:.4f} R1=${self.pivots['r1']:.4f} S1=${self.pivots['s1']:.4f}{COLOR_RESET}")

    def price_zone(self, price):
        if price is None:
            return "INVALID"
        if self.buy_zone and self.buy_zone[0] <= price < self.buy_zone[1]:
            return "BUY"
        elif self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]:
            return "NEUTRAL"
        elif self.sell_zone and self.sell_zone[0] < price <= self.sell_zone[1]:
            return "SELL"
        else:
            return "OUTSIDE"

    def zones_expired(self, price):
        global outside_zone_since
        zone_status = self.price_zone(price)
        now = time.time()
        if zone_status == "OUTSIDE":
            if outside_zone_since is None:
                outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME:
                print(f"{COLOR_YELLOW}Price outside all zones for >{ZONE_RESET_HOLD_TIME} seconds. Resetting zones...{COLOR_RESET}")
                outside_zone_since = None
                return True
        else:
            outside_zone_since = None
        return False

    def track_best_sell(self, price, entry_price, token_amount):
        if price is None:
            return None
           
        zone = self.price_zone(price)
       
        if zone == "SELL":
            self.sell_highs.append(price)
            self.sell_lows.append(price)
           
            if not self.in_sell_zone:
                self.in_sell_zone = True
                self.best_sell_price = price
                self.max_avg_high_seen = np.mean(self.sell_highs) if self.sell_highs else price
                if DEBUG:
                    print(f"{COLOR_BLUE}Entered SELL zone. Tracking highs. initial avg_high={self.max_avg_high_seen:.4f}{COLOR_RESET}")
            else:
                if price > self.best_sell_price:
                    self.best_sell_price = price
               
                avg_high = np.mean(self.sell_highs) if self.sell_highs else self.best_sell_price
                if self.max_avg_high_seen is None or avg_high > self.max_avg_high_seen:
                    self.max_avg_high_seen = avg_high
                   
                if DEBUG:
                    print(f"{COLOR_BLUE}New max_avg_high_seen: ${self.max_avg_high_seen:.4f}{COLOR_RESET}")
           
            if SELL_AT_HIGHEST_AVERAGE and self.max_avg_high_seen is not None:
                lower_thr = self.max_avg_high_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.max_avg_high_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr:
                    if DEBUG:
                        print(f"{COLOR_GREEN}SELL range condition met: price ${price:.4f} in [{lower_thr:.4f}, {upper_thr:.4f}]. Signaling sell at ref ${self.max_avg_high_seen:.4f}{COLOR_RESET}")
                    return float(self.max_avg_high_seen)
            return None
           
        else:
            if self.in_sell_zone:
                avg_high = np.mean(self.sell_highs) if self.sell_highs else None
                avg_low = np.mean(self.sell_lows) if self.sell_lows else None
                best_profit = calculate_precise_profit(entry_price, self.best_sell_price, token_amount)
               
                if DEBUG:
                    print(f"{COLOR_GREEN}Exited SELL zone. Best SELL price: ${self.best_sell_price:.4f}, Avg High: {avg_high:.4f}, Avg Low: {avg_low:.4f}, Best Profit: ${best_profit:.4f}{COLOR_RESET}")
               
                self.in_sell_zone = False
                self.sell_highs = []
                self.sell_lows = []
                tmp = self.max_avg_high_seen
                self.max_avg_high_seen = None
               
                if best_profit is not None and best_profit >= MIN_PROFIT:
                    return float(self.best_sell_price)
                else:
                    if DEBUG:
                        print(f"{COLOR_YELLOW}Exit-based sell condition not met (profit {best_profit}).{COLOR_RESET}")
                    return None
        return None

    def track_best_buy(self, price):
        if price is None:
            return None
           
        zone = self.price_zone(price)
       
        if zone == "BUY":
            self.buy_highs.append(price)
            self.buy_lows.append(price)
           
            if not self.in_buy_zone:
                self.in_buy_zone = True
                self.best_buy_price = price
                self.min_avg_low_seen = np.mean(self.buy_lows) if self.buy_lows else price
                if DEBUG:
                    print(f"{COLOR_BLUE}Entered BUY zone. Tracking lows. initial avg_low={self.min_avg_low_seen:.4f}{COLOR_RESET}")
            else:
                if price < self.best_buy_price:
                    self.best_buy_price = price
               
                avg_low = np.mean(self.buy_lows) if self.buy_lows else self.best_buy_price
                if self.min_avg_low_seen is None or avg_low < self.min_avg_low_seen:
                    self.min_avg_low_seen = avg_low
                   
                if DEBUG:
                    print(f"{COLOR_BLUE}New min_avg_low_seen: ${self.min_avg_low_seen:.4f}{COLOR_RESET}")
           
            if BUY_AT_LOWEST_AVERAGE and self.min_avg_low_seen is not None:
                lower_thr = self.min_avg_low_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.min_avg_low_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr:
                    if DEBUG:
                        print(f"{COLOR_GREEN}BUY range condition met: price ${price:.4f} in [{lower_thr:.4f}, {upper_thr:.4f}]. Signaling buy at ref ${self.min_avg_low_seen:.4f}{COLOR_RESET}")
                    return float(self.min_avg_low_seen)
            return None
           
        else:
            if self.in_buy_zone:
                avg_high = np.mean(self.buy_highs) if self.buy_highs else None
                avg_low = np.mean(self.buy_lows) if self.buy_lows else None
               
                if DEBUG:
                    print(f"{COLOR_GREEN}Exited BUY zone. Tracked best low: ${self.best_buy_price:.4f}, Avg High: {avg_high:.4f}, Avg Low: {avg_low:.4f}{COLOR_RESET}")
               
                self.in_buy_zone = False
                self.buy_highs = []
                self.buy_lows = []
                tmp = self.min_avg_low_seen
                self.min_avg_low_seen = None
               
                buy_zone_mid = np.mean(self.buy_zone)
                if tmp is not None and tmp < buy_zone_mid:
                    if DEBUG:
                        print(f"{COLOR_GREEN}Exit-based buy condition met. Signaling buy at ${tmp:.4f}{COLOR_RESET}")
                    return float(tmp)
                else:
                    if DEBUG:
                        print(f"{COLOR_YELLOW}Exit-based buy condition NOT met. Holding.{COLOR_RESET}")
                    return None
        return None

