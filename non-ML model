# ========================== IMMEDIATE MANUAL EXECUTION ==========================
def execute_manual(side):
    global active_position, entry_price, token_amount, last_trade_time, last_trade_type
    price = get_ticker()
    if not price:
        print_ticket(side, "FAILED", 0.0, 0.0, error="Could not fetch market price")
        return
    price = round(price, 4)

    if side == "b":
        if active_position:
            print_ticket("BUY", "BLOCKED", price, 0.0, error="Already in position")
            return
        
        amt = INVESTMENT_AMOUNT / price
        if amt * price < MIN_ORDER_USD:
            print_ticket("BUY", "FAILED", price, amt, error="Below Kraken min order ($10)")
            return

        print(f"{NUM}🚀 Sending MANUAL BUY for {amt:.8f} @ ~${price:.4f}...{RESET}")
        res = place_order('buy', amt, price)
        
        # ✅ CRITICAL FIX: Update state IMMEDIATELY on API success
        if res and not res.get('error'):
            active_position = True
            entry_price = price
            token_amount = amt
            last_trade_time = time.time()
            last_trade_type = "MANUAL BUY"
            
            # Safely parse txid for ticket only
            txid = "N/A"
            try:
                txid_list = res.get('result', {}).get('txid', [])
                if isinstance(txid_list, list) and len(txid_list) > 0:
                    txid = txid_list[0]
            except: pass
            print_ticket("BUY", "SUCCESS", price, amt, txid=txid)
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("BUY", "REJECTED", price, amt, error=err)

    elif side == "s":
        if not active_position or token_amount <= 0:
            print_ticket("SELL", "BLOCKED", price, 0.0, error="No active position")
            return

        print(f"{NUM}💰 Sending MANUAL SELL for {token_amount:.8f} @ ~${price:.4f}...{RESET}")
        res = place_order('sell', token_amount, price)
        
        if res and not res.get('error'):
            active_position = False
            token_amount = 0
            last_trade_time = time.time()
            last_trade_type = "MANUAL SELL"
            
            txid = "N/A"
            try:
                txid_list = res.get('result', {}).get('txid', [])
                if isinstance(txid_list, list) and len(txid_list) > 0:
                    txid = txid_list[0]
            except: pass
            print_ticket("SELL", "SUCCESS", price, amt, txid=txid)
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("SELL", "REJECTED", price, token_amount, error=err)

# ========================== ZONE MACHINE ==========================
class ZoneMachine:
    def __init__(self):
        self.buy_zone = self.neutral_zone = self.sell_zone = None
        self.median = 0.0

    def init(self, ohlc):
        if not ohlc or len(ohlc) < 10: return False
        h = np.array([x['high'] for x in ohlc])
        l = np.array([x['low'] for x in ohlc])
        self.median = float((np.median(h) + np.median(l)) / 2)
        nl = round(self.median - ZONE_BUFFER/2, 4)
        nu = round(self.median + ZONE_BUFFER/2, 4)
        self.neutral_zone = (nl, nu)
        self.buy_zone = (round(nl - BUY_ZONE_EXTRA, 4), nl)
        self.sell_zone = (nu, round(nu + SELL_ZONE_EXTRA, 4))
        return True

    def zone(self, p):
        if self.buy_zone and self.buy_zone[0] <= p < self.buy_zone[1]: return "BUY"
        if self.neutral_zone and self.neutral_zone[0] <= p <= self.neutral_zone[1]: return "NEUTRAL"
        if self.sell_zone and self.sell_zone[0] < p <= self.sell_zone[1]: return "SELL"
        return "OUTSIDE"

    def buy_sig(self, p): return self.zone(p) == "BUY"
    def sell_sig(self, p, ep, amt):
        profit = calc_profit(ep, p, amt)
        return self.zone(p) == "SELL" or profit >= MIN_PROFIT

