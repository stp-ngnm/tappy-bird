        print(f"{Y}sell: N/A | neutral: N/A | buy: N/A{R}")
    print(f"{B}==========================={R}")
    print(f"{B}====== POSITION =========={R}")
    print(f"{Y}Zone: {current_zone} | Trend: {trend}{R}")
    print(f"{P}Status: {'ACTIVE' if active else 'WAITING'} | Last Action: {last_type}{R}")
    print(f"{profit_color}profit margin: ${profit_str}{R}")
    print(f"{B}==========================={R}")

# ========================== 🎛️ CONTROL PANEL ==========================
def config_monitor():
    global INVESTMENT_AMOUNT, TRADING_PAIR, KRAKEN_PAIR, MAX_SLIPPAGE_PCT, MIN_PROFIT
    print(f"\n{COLOR_MAGENTA}🎛️ CONFIGURATION ACTIVE{COLOR_RESET}")
    print(f"Commands: b=buy, s=sell, i=invest, t=pair, m=min_profit, l=slippage, c=config, q=quit")
    while True:
        try:
            cmd = input(f"{COLOR_MAGENTA}Config> {COLOR_RESET}").strip().lower()
            if cmd == 'q': print(f"{COLOR_YELLOW}Exiting config monitor...{COLOR_RESET}"); break
            elif cmd == 'b': manual_trigger_queue.put("BUY")
            elif cmd == 's': manual_trigger_queue.put("SELL")
            elif cmd == 'i':
                try:
                    INVESTMENT_AMOUNT = float(input("New Investment ($): "))
                    print(f"{COLOR_GREEN}Updated: ${INVESTMENT_AMOUNT:.2f}{COLOR_RESET}")
                except: print(f"{COLOR_RED}Invalid{COLOR_RESET}")
            elif cmd == 't':
                TRADING_PAIR = input("New pair: ").upper()
                KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
                print(f"{COLOR_GREEN}Pair: {KRAKEN_PAIR}{COLOR_RESET}")
            elif cmd == 'm':
                try: MIN_PROFIT = float(input("New Min Profit ($): ")); print(f"{COLOR_GREEN}Updated: ${MIN_PROFIT:.2f}{COLOR_RESET}")
                except: print(f"{COLOR_RED}Invalid{COLOR_RESET}")
            elif cmd == 'l':
                try:
                    MAX_SLIPPAGE_PCT = float(input("New Max Slippage (%): ")) / 100.0
                    print(f"{COLOR_GREEN}Updated: {MAX_SLIPPAGE_PCT*100:.4f}%{COLOR_RESET}")
                except: print(f"{COLOR_RED}Invalid{COLOR_RESET}")
            elif cmd == 'c':
                print(f"\n{COLOR_MAGENTA}Current Config:{COLOR_RESET}")
                print(f"Investment: ${INVESTMENT_AMOUNT:.2f} | Pair: {TRADING_PAIR}")
                print(f"Min Profit: ${MIN_PROFIT:.2f} | Max Slippage: {MAX_SLIPPAGE_PCT*100:.4f}%")
        except (EOFError, KeyboardInterrupt): break
        except Exception as e: logging.error(f"Config error: {e}")

# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time, \
           last_trend, last_trade_type, profit_margin_usd, \
           KRAKEN_PAIR, global_min_price, global_max_price
    
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zone_machine = BestValueZoneMachine4Dec(KRAKEN_PAIR)
    if not zone_machine.initialize_zones(): return
    
    ml_advisor = MLTradingAdvisor()
    threading.Thread(target=config_monitor, daemon=True).start()
    print(f"{COLOR_CYAN}🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...{COLOR_RESET}")

    while True:
        try:
            # Manual Triggers
            while not manual_trigger_queue.empty():
                trigger = manual_trigger_queue.get()
                price = get_ticker()
                if not price: continue
                if trigger == "BUY" and not active_position:
                    amt, ep, slip = dynamic_position_size(price, 'buy')
                    if amt > 0:
                        res = place_order('buy', amt, ep or price)
                        if res and not res.get('error'):
                            active_position = True; entry_price = ep or price; token_amount = amt
                            last_trade_time = time.time(); last_trade_type = "MANUAL BUY"
                elif trigger == "SELL" and active_position:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        active_position = False; token_amount = 0
                        last_trade_time = time.time(); last_trade_type = "MANUAL SELL"

            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 4)
            global_min_price = min(global_min_price, price)
            global_max_price = max(global_max_price, price)

            # MACD Trend
            trend = "neutral"
            try:
                hour_ohlc = get_ohlc(KRAKEN_PAIR, 60, 100)
                if hour_ohlc:
                    closes = [c['close'] for c in hour_ohlc]
                    if len(closes) >= MACD_SLOW + MACD_SIGNAL:
                        fast_ema = closes[-1] # Simplified for speed
                        slow_ema = np.mean(closes[-MACD_SLOW:])
                        trend = "up" if fast_ema > slow_ema else "down"
            except: pass
            last_trend = trend

            # Zone Reset
            if zone_machine.zones_expired(price):
                zone_machine.initialize_zones(); time.sleep(PRICE_CHECK_INTERVAL); continue

            # 🛡️ STOP-LOSS
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                trig = price; lim = price * (1 - STOP_LOSS_LIMIT_BUFFER)
                print(f"{COLOR_RED}🔻 Stop-Loss Triggered @ ${price:.4f} | Limit: ${lim:.4f}{COLOR_RESET}")
                res = place_order('sell', token_amount, price, ordertype='stop-loss-limit', price2=trig)
                if res and not res.get('error'):
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # Extract Features for ML
            ob = get_order_book(KRAKEN_PAIR)
            pos_state = {'active': active_position, 'entry_price': entry_price, 'entry_time': last_trade_time}
            features = ml_advisor.extract_features(price, zone_machine, trend, ob, pos_state)
            entry_confidence = ml_advisor.predict_entry_confidence(features)
            expected_exit = ml_advisor.predict_expected_profit(features)

            # Auto BUY (ML-Gated)
            if not active_position and (time.time() - last_trade_time > TRADE_MIN_INTERVAL):
                bp = zone_machine.track_best_buy(price)
                if bp is not None and entry_confidence > ML_CONFIDENCE_THRESHOLD and trend != "down":
                    amt, ep, slip = dynamic_position_size(price, 'buy')
                    if amt > 0 and (slip is None or slip <= MAX_SLIPPAGE_PCT):
                        res = place_order('buy', amt, ep or price)
                        if res and not res.get('error'):
                            active_position = True; entry_price = ep or price; token_amount = amt
                            last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                            ml_advisor.record_outcome(features, ep or price, ep or price, amt)

            # Auto SELL (ML-Predicted Profit Gate)
            if active_position:
                sp = zone_machine.track_best_sell(price, entry_price, token_amount)
                # 🔑 FIX: Removed trend gate. ML predicts profit directly.
                if sp is not None and expected_exit >= MIN_PROFIT:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        profit = calculate_precise_profit(entry_price, price, token_amount)
                        print(f"{COLOR_GREEN}💰 ML EXIT @ ${price:.4f} | Profit: ${profit:.2f} | Expected: ${expected_exit:.2f}{COLOR_RESET}")
                        active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                        ml_advisor.record_outcome(features, price, entry_price, token_amount)

            # Update Dashboard Profit
            profit_usd = calculate_precise_profit(entry_price, price, token_amount) if active_position else 0.0

            print_dashboard(price, zone_machine, last_trend, active_position, token_amount, profit_usd, last_trade_type)
            time.sleep(PRICE_CHECK_INTERVAL)
            
        except KeyboardInterrupt:
            print(f"\n{COLOR_YELLOW}⏹️ Ctrl+C detected. Exiting gracefully...{COLOR_RESET}")
            sys.exit(0)
        except Exception as e:
            logging.error(f"Loop error: {e}"); time.sleep(10)

if __name__ == "__main__":
    main()