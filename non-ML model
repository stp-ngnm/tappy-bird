def config_monitor():
    global INVESTMENT_AMOUNT, TRADING_PAIR, KRAKEN_PAIR, MAX_SLIPPAGE_PCT, MIN_PROFIT
    print("\n🎛️ CONFIGURATION ACTIVE | Commands: b=buy, s=sell, i=invest, t=pair, m=min_profit, l=slippage, c=config, q=quit")
    while True:
        try:
            cmd = input("Config> ").strip().lower()
            if cmd == 'q': break
            elif cmd == 'b': manual_trigger_queue.put("BUY")
            elif cmd == 's': manual_trigger_queue.put("SELL")
            elif cmd == 'i':
                try: INVESTMENT_AMOUNT = float(input("New Investment ($): ")); print(f"Updated: ${INVESTMENT_AMOUNT:.2f}")
                except: print("Invalid")
            elif cmd == 't':
                TRADING_PAIR = input("New pair: ").upper(); KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR); print(f"Pair: {KRAKEN_PAIR}")
            elif cmd == 'm':
                try: MIN_PROFIT = float(input("New Min Profit ($): ")); print(f"Updated: ${MIN_PROFIT:.2f}")
                except: print("Invalid")
            elif cmd == 'l':
                try: MAX_SLIPPAGE_PCT = float(input("New Max Slippage (%): "))/100.0; print(f"Updated: {MAX_SLIPPAGE_PCT*100:.4f}%")
                except: print("Invalid")
        except (EOFError, KeyboardInterrupt): break

# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time, last_trend, last_trade_type, KRAKEN_PAIR
    
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zone_machine = BestValueZoneMachine4Dec(KRAKEN_PAIR)
    if not zone_machine.initialize_zones(): return
    
    threading.Thread(target=config_monitor, daemon=True).start()
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")

    while True:
        try:
            while not manual_trigger_queue.empty():
                trigger = manual_trigger_queue.get()
                price = get_ticker()
                if not price: continue
                if trigger == "BUY" and not active_position:
                    amt, ep, _ = dynamic_position_size(price, 'buy')
                    if amt > 0:
                        res = place_order('buy', amt, ep or price)
                        if res and not res.get('error'): active_position = True; entry_price = ep or price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "MANUAL BUY"
                elif trigger == "SELL" and active_position:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'): active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "MANUAL SELL"

            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 4)

            trend = "neutral"
            try:
                hour_ohlc = get_ohlc(KRAKEN_PAIR, 60, 100)
                if hour_ohlc:
                    macd, sig, _ = calculate_macd(hour_ohlc)
                    if macd and sig: trend = "up" if macd > sig else "down"
            except: pass
            last_trend = trend

            if zone_machine.zones_expired(price): zone_machine.initialize_zones(); time.sleep(PRICE_CHECK_INTERVAL); continue

            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                trig = price; lim = price * (1 - STOP_LOSS_LIMIT_BUFFER)
                res = place_order('sell', token_amount, price, ordertype='stop-loss-limit', price2=trig)
                if res and not res.get('error'): active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                time.sleep(PRICE_CHECK_INTERVAL); continue

            if not active_position and (time.time() - last_trade_time > TRADE_MIN_INTERVAL):
                bp = zone_machine.track_best_buy(price)
                if bp is not None and trend != "down":
                    amt, ep, slip = dynamic_position_size(price, 'buy')
                    if amt > 0 and (slip is None or slip <= MAX_SLIPPAGE_PCT):
                        res = place_order('buy', amt, ep or price)
                        if res and not res.get('error'): active_position = True; entry_price = ep or price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "AUTO BUY"

            if active_position:
                sp = zone_machine.track_best_sell(price, entry_price, token_amount)
                if sp is not None:
                    best_profit = calculate_precise_profit(entry_price, sp, token_amount)
                    if best_profit >= MIN_PROFIT:
                        ob = get_order_book(KRAKEN_PAIR)
                        if ob:
                            filled, exec_price, _, _ = simulate_market_fill('sell', token_amount, ob)
                            slippage = abs(exec_price - price) / price if filled else 1.0
                            if sum(v for _, v in ob['bids']) >= token_amount * MIN_LIQUIDITY_RATIO and slippage <= MAX_SLIPPAGE_PCT:
                                res = place_order('sell', token_amount, exec_price)
                                if res and not res.get('error'): active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"

            profit_usd = calculate_precise_profit(entry_price, price, token_amount) if active_position else 0.0
            print_dashboard(price, zone_machine, last_trend, active_position, token_amount, profit_usd, last_trade_type, entry_price)
            time.sleep(PRICE_CHECK_INTERVAL)
            
        except KeyboardInterrupt: print("\n⏹️ Exiting..."); sys.exit(0)
        except Exception as e: logging.error(f"Loop error: {e}"); time.sleep(10)

if __name__ == "__main__":
    main()