# ========== Zone Machine (avg-entry with symmetric range) ==========
class BestValueZoneMachine4Dec:
    def __init__(self, pair):
        self.pair = pair
        self.zone_initialized = False
        self.buy_zone = None
        self.neutral_zone = None
        self.sell_zone = None
        self.median = None
        self.zone_set_time = None

        # SELL zone tracking
        self.in_sell_zone = False
        self.sell_highs = []
        self.sell_lows = []
        self.best_sell_price = None
        self.max_avg_high_seen = None

        # BUY zone tracking
        self.in_buy_zone = False
        self.buy_highs = []
        self.buy_lows = []
        self.best_buy_price = None
        self.min_avg_low_seen = None

    def initialize_zones(self, use_bollinger=False):
        print(f"{COLOR_CYAN}Calculating Zones...{COLOR_RESET}")
        ohlc_data = get_ohlc(self.pair, interval=1, lookback=MEDIAN_LOOKBACK)
        if not ohlc_data or len(ohlc_data) < 10:
            print(f"{COLOR_RED}Insufficient OHLC data for zone calculation!{COLOR_RESET}")
            return False

        if use_bollinger:
            closes = np.array([row['close'] for row in ohlc_data[-20:] if row.get('close') is not None])
            if len(closes) < 20:
                print(f"{COLOR_RED}Insufficient data for Bollinger zones!{COLOR_RESET}")
                return False
            sma = np.mean(closes)
            std = np.std(closes)
            upper = sma + 2 * std
            lower = sma - 2 * std
            self.median = float(np.mean([lower, upper]))
            neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
            neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
            self.neutral_zone = (neutral_lower, neutral_upper)
            self.buy_zone = (round(lower, 4), neutral_lower)
            self.sell_zone = (neutral_upper, round(upper, 4))
        else:
            highs = np.array([x['high'] for x in ohlc_data])
            lows = np.array([x['low'] for x in ohlc_data])
            self.median = float((np.median(highs) + np.median(lows)) / 2)
            neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
            neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
            self.neutral_zone = (neutral_lower, neutral_upper)
            self.buy_zone = (round(neutral_lower - BUY_ZONE_EXTRA, 4), neutral_lower)
            self.sell_zone = (neutral_upper, round(neutral_upper + SELL_ZONE_EXTRA, 4))

        self.zone_initialized = True
        self.zone_set_time = time.time()
        # reset trackers & averages
        self.sell_highs = []
        self.sell_lows = []
        self.buy_highs = []
        self.buy_lows = []
        self.in_sell_zone = False
        self.in_buy_zone = False
        self.best_sell_price = None
        self.best_buy_price = None
        self.max_avg_high_seen = None
        self.min_avg_low_seen = None

        print(f"{COLOR_MAGENTA}=== ZONES INITIALIZED ==={COLOR_RESET}")
        print(f"Median:      ${self.median:.4f}")
        print(f"Buy Zone:    [${self.buy_zone[0]:.4f} - ${self.buy_zone[1]:.4f}]")
        print(f"Neutral Zone:[${self.neutral_zone[0]:.4f} - ${self.neutral_zone[1]:.4f}]")
        print(f"Sell Zone:   [${self.sell_zone[0]:.4f} - ${self.sell_zone[1]:.4f}]")
        print(f"{COLOR_MAGENTA}========================={COLOR_RESET}")

    def price_zone(self, price):
        if price is None:
            return "INVALID"
        if self.buy_zone and self.buy_zone[0] <= price < self.buy_zone[1]:
            return "BUY"
        elif self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]:
            return "NEUTRAL"
        elif self.sell_zone and self.sell_zone[0] < price <= self.sell_zone[1]:
            return "SELL"
        else:
            return "OUTSIDE"

    def zones_expired(self, price):
        global outside_zone_since
        zone_status = self.price_zone(price)
        now = time.time()
        if zone_status == "OUTSIDE":
            if outside_zone_since is None:
                outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME:
                print(f"{COLOR_YELLOW}Price outside all zones for >{ZONE_RESET_HOLD_TIME} seconds. Resetting zones...{COLOR_RESET}")
                outside_zone_since = None
                return True
        else:
            outside_zone_since = None
        return False

    # SELL tracking (same as previous avg-entry, returns reference sell price when condition met)
    def track_best_sell(self, price, entry_price, token_amount):
        if price is None:
            return None

        zone = self.price_zone(price)

        if zone == "SELL":
            self.sell_highs.append(price)
            self.sell_lows.append(price)
            if not self.in_sell_zone:
                self.in_sell_zone = True
                self.best_sell_price = price
                self.max_avg_high_seen = np.mean(self.sell_highs) if self.sell_highs else price
                if DEBUG:
                    print(f"{COLOR_BLUE}Entered SELL zone. Tracking highs. initial avg_high={self.max_avg_high_seen:.4f}{COLOR_RESET}")
            else:
                if price > self.best_sell_price:
                    self.best_sell_price = price
                avg_high = np.mean(self.sell_highs) if self.sell_highs else self.best_sell_price
                if self.max_avg_high_seen is None or avg_high > self.max_avg_high_seen:
                    self.max_avg_high_seen = avg_high
                    if DEBUG:
                        print(f"{COLOR_BLUE}New max_avg_high_seen: ${self.max_avg_high_seen:.4f}{COLOR_RESET}")

            if SELL_AT_HIGHEST_AVERAGE and self.max_avg_high_seen is not None:
                lower_thr = self.max_avg_high_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.max_avg_high_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr:
                    if DEBUG:
                        print(f"{COLOR_GREEN}SELL range condition met: price ${price:.4f} in [{lower_thr:.4f}, {upper_thr:.4f}]. Signaling sell at ref ${self.max_avg_high_seen:.4f}{COLOR_RESET}")
                    return float(self.max_avg_high_seen)
            return None

        else:
            if self.in_sell_zone:
                avg_high = np.mean(self.sell_highs) if self.sell_highs else None
                avg_low = np.mean(self.sell_lows) if self.sell_lows else None
                best_profit = calculate_precise_profit(entry_price, self.best_sell_price, token_amount)
                if DEBUG:
                    print(f"{COLOR_GREEN}Exited SELL zone. Best SELL price: ${self.best_sell_price:.4f}, Avg High: {avg_high:.4f}, Avg Low: {avg_low:.4f}, Best Profit: ${best_profit:.4f}{COLOR_RESET}")
                self.in_sell_zone = False
                self.sell_highs = []
                self.sell_lows = []
                tmp = self.max_avg_high_seen
                self.max_avg_high_seen = None
                if best_profit is not None and best_profit >= MIN_PROFIT:
                    return float(self.best_sell_price)
                else:
                    if DEBUG:
                        print(f"{COLOR_YELLOW}Exit-based sell condition not met (profit {best_profit}).{COLOR_RESET}")
            return None

    # BUY tracking (returns reference buy price when condition met)
    def track_best_buy(self, price):
        if price is None:
            return None

        zone = self.price_zone(price)

        if zone == "BUY":
            self.buy_highs.append(price)
            self.buy_lows.append(price)
            if not self.in_buy_zone:
                self.in_buy_zone = True
                self.best_buy_price = price
                self.min_avg_low_seen = np.mean(self.buy_lows) if self.buy_lows else price
                if DEBUG:
                    print(f"{COLOR_BLUE}Entered BUY zone. Tracking lows. initial avg_low={self.min_avg_low_seen:.4f}{COLOR_RESET}")
            else:
                if price < self.best_buy_price:
                    self.best_buy_price = price
                avg_low = np.mean(self.buy_lows) if self.buy_lows else self.best_buy_price
                if self.min_avg_low_seen is None or avg_low < self.min_avg_low_seen:
                    self.min_avg_low_seen = avg_low
                    if DEBUG:
                        print(f"{COLOR_BLUE}New min_avg_low_seen: ${self.min_avg_low_seen:.4f}{COLOR_RESET}")

            if BUY_AT_LOWEST_AVERAGE and self.min_avg_low_seen is not None:
                lower_thr = self.min_avg_low_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.min_avg_low_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr:
                    if DEBUG:
                        print(f"{COLOR_GREEN}BUY range condition met: price ${price:.4f} in [{lower_thr:.4f}, {upper_thr:.4f}]. Signaling buy at ref ${self.min_avg_low_seen:.4f}{COLOR_RESET}")
                    return float(self.min_avg_low_seen)
            return None

        else:
            if self.in_buy_zone:
                avg_high = np.mean(self.buy_highs) if self.buy_highs else None
                avg_low = np.mean(self.buy_lows) if self.buy_lows else None
                if DEBUG:
                    print(f"{COLOR_GREEN}Exited BUY zone. Tracked best low: ${self.best_buy_price:.4f}, Avg High: {avg_high:.4f}, Avg Low: {avg_low:.4f}{COLOR_RESET}")
                self.in_buy_zone = False
                self.buy_highs = []
                self.buy_lows = []
                tmp = self.min_avg_low_seen
                self.min_avg_low_seen = None
                buy_zone_mid = np.mean(self.buy_zone)
                if tmp is not None and tmp < buy_zone_mid:
                    if DEBUG:
                        print(f"{COLOR_GREEN}Exit-based buy condition met. Signaling buy at ${tmp:.4f}{COLOR_RESET}")
                    return float(tmp)
                else:
                    if DEBUG:
                        print(f"{COLOR_YELLOW}Exit-based buy condition NOT met. Holding.{COLOR_RESET}")
            return None


# ====== Startup ======
print(f"{COLOR_CYAN}Starting Depth-Aware Trading Bot (avg-entry ±{ENTRY_RANGE_PCT*100:.2f}%){COLOR_RESET}")

KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
zone_machine = BestValueZoneMachine4Dec(KRAKEN_PAIR)
zone_machine.initialize_zones()

config_thread = threading.Thread(target=config_monitor, daemon=True)
config_thread.start()

last_trade_time = 0
TRADE_MIN_INTERVAL = 60
all_prices = []

# ========== Main Loop ==========
while True:
    try:
        # Process manual triggers first
        while not manual_trigger_queue.empty():
            trigger = manual_trigger_queue.get()
            logging.info(f"Manual trigger dequeued: {trigger}")
            price = get_ticker()
            if price is None:
                logging.warning("Manual trigger: failed to fetch ticker price.")
                continue
            price = round(price, 4)
            if trigger == "BUY" and not active_position:
                print(f"{COLOR_GREEN}🚀 MANUAL BUY TRIGGERED! Price: ${price:.4f}{COLOR_RESET}")
                amount = dynamic_position_size(price)
                order_result = place_order('buy', amount, price)
                logging.info(f"Manual buy order_result: {order_result}")
                if 'error' in order_result and order_result['error']:
                    print(f"{COLOR_RED}Buy error: {order_result['error']}{COLOR_RESET}")
                else:
                    print(f"{COLOR_GREEN}Bought {amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ ${price:.4f}{COLOR_RESET}")
                    active_position = True
                    entry_price = price
                    token_amount = amount
                    position_investment = INVESTMENT_AMOUNT
                    last_trade_time = time.time()
            elif trigger == "SELL" and active_position:
                print(f"{COLOR_GREEN}💰 MANUAL SELL TRIGGERED! Price: ${price:.4f}{COLOR_RESET}")
                current_profit = calculate_precise_profit(entry_price, price, token_amount)
                if current_profit is None:
                    print(f"{COLOR_RED}Profit calculation error, skipping sell.{COLOR_RESET}")
                    continue
                order_result = place_order('sell', token_amount, price)
                logging.info(f"Manual sell order_result: {order_result}")
                if 'error' in order_result and order_result['error']:
                    print(f"{COLOR_RED}Sell error: {order_result['error']}{COLOR_RESET}")
                else:
                    print(f"{COLOR_GREEN}Sold {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} for ${price*token_amount:.4f}{COLOR_RESET}")
                    print(f"{COLOR_GREEN}Entry: ${entry_price:.4f} | Exit: ${price:.4f} | Profit: ${current_profit:.4f}{COLOR_RESET}")
                    active_position = False
                    position_investment = 0
                    last_trade_time = time.time()

        price = get_ticker()
        if price is None:
            print(f"{COLOR_YELLOW}Failed to get market price. Retrying...{COLOR_RESET}")
            time.sleep(PRICE_CHECK_INTERVAL)
            continue
        price = round(price, 4)
        all_prices.append(price)

        ohlc_data = get_ohlc(KRAKEN_PAIR, interval=1, lookback=20)
        if not ohlc_data:
            print(f"{COLOR_RED}No OHLC data, skipping tick.{COLOR_RESET}")
            time.sleep(PRICE_CHECK_INTERVAL)
            continue

        trend = get_trend(ohlc_data, window=10)
        zone_status = zone_machine.price_zone(price)

        if DEBUG:
            print(f"\n{COLOR_CYAN}↗ Current Market Price: ${price:.4f} | Zone: {zone_status} | Trend: {trend}{COLOR_RESET}")
            print(f"{COLOR_MAGENTA}Zones — BUY: {zone_machine.buy_zone}, NEUTRAL: {zone_machine.neutral_zone}, SELL: {zone_machine.sell_zone}{COLOR_RESET}")
            print(f"{COLOR_MAGENTA}Active Position: {active_position} | Entry: ${entry_price:.4f} | TokenAmt: {token_amount:.8f}{COLOR_RESET}")
            if zone_status == "BUY":
                avg_low = np.mean(zone_machine.buy_lows) if zone_machine.buy_lows else None
                print(f"{COLOR_BLUE}Tracked BUY avg_low: {avg_low}, min_avg_low_seen: {zone_machine.min_avg_low_seen}{COLOR_RESET}")
            if zone_status == "SELL":
                avg_high = np.mean(zone_machine.sell_highs) if zone_machine.sell_highs else None
                print(f"{COLOR_BLUE}Tracked SELL avg_high: {avg_high}, max_avg_high_seen: {zone_machine.max_avg_high_seen}{COLOR_RESET}")

        # Zone reset check
        if zone_machine.zones_expired(price):
            distance_pct = abs(price - zone_machine.median) / zone_machine.median if zone_machine.median else 0
            if distance_pct > 0.08:
                print(f"{COLOR_YELLOW}Price far from median ({distance_pct*100:.1f}%). Recalculating zones using Bollinger...{COLOR_RESET}")
                zone_machine.initialize_zones(use_bollinger=True)
            else:
                zone_machine.initialize_zones()
            continue

        now = time.time()

        # Auto BUY path (depth-aware)
        if not active_position:
            best_buy_price = zone_machine.track_best_buy(price)
            if best_buy_price is not None and now - last_trade_time > TRADE_MIN_INTERVAL:
                # Require trend == up to avoid buying into downtrend
                if trend != 'up':
                    logging.info(f"Auto-buy skipped because trend != up (trend={trend})")
                else:
                    # compute intended base amount
                    base_amount = dynamic_position_size(best_buy_price)
                    # estimate depth impact vs reference price (use current ticker price as more conservative ref)
                    depth_info = estimate_slippage_and_liquidity('buy', price, base_amount)
                    if not depth_info['filled']:
                        logging.info(f"Auto-buy skipped: insufficient orderbook depth (available_base={depth_info.get('available_base')})")
                    else:
                        slippage = depth_info['slippage_pct']
                        available = depth_info['available_base']
                        # require at least MIN_LIQUIDITY_RATIO of requested base available in the fetched depth
                        if available < base_amount * MIN_LIQUIDITY_RATIO:
                            logging.info(f"Auto-buy skipped: not enough liquidity within depth (available {available:.8f} < required_ratio*base_amount {base_amount*MIN_LIQUIDITY_RATIO:.8f})")
                        elif slippage > MAX_SLIPPAGE_PCT:
                            logging.info(f"Auto-buy skipped: estimated slippage {slippage*100:.2f}% > MAX_SLIPPAGE_PCT {MAX_SLIPPAGE_PCT*100:.2f}% (exec_price {depth_info['exec_price']:.4f} vs ref {price:.4f})")
                        else:
                            # Acceptable — place order (we keep current logic: place market order)
                            logging.info(f"Auto-buy proceeding: estimated exec_price={depth_info['exec_price']:.4f}, slippage={slippage*100:.3f}%, levels={depth_info['levels_consumed']}")
                            amount = base_amount
                            order_result = place_order('buy', amount, depth_info['exec_price'])
                            logging.info(f"Auto buy order_result: {order_result}")
                            if 'error' in order_result and order_result['error']:
                                print(f"{COLOR_RED}Buy error: {order_result['error']}{COLOR_RESET}")
                            else:
                                print(f"{COLOR_GREEN}Bought {amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ approx ${depth_info['exec_price']:.4f}{COLOR_RESET}")
                                active_position = True
                                entry_price = depth_info['exec_price']
                                token_amount = amount
                                position_investment = INVESTMENT_AMOUNT
                                last_trade_time = now

        # Stop-loss
        if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
            print(f"{COLOR_RED}Stop-loss triggered! Selling position at ${price:.4f}.{COLOR_RESET}")
            order_result = place_order('sell', token_amount, price)
            logging.info(f"Stop-loss order_result: {order_result}")
            if 'error' in order_result and order_result['error']:
                print(f"{COLOR_RED}Stop-loss sell error: {order_result['error']}{COLOR_RESET}")
            else:
                print(f"{COLOR_GREEN}Sold {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} for ${price*token_amount:.4f} (Stop-loss){COLOR_RESET}")
                print(f"{COLOR_GREEN}Entry: ${entry_price:.4f} | Exit: ${price:.4f} | Profit: {calculate_precise_profit(entry_price, price, token_amount):.4f}{COLOR_RESET}")
                active_position = False
                position_investment = 0
                last_trade_time = now
            time.sleep(PRICE_CHECK_INTERVAL)
            continue

        # Auto SELL path (depth-aware; sells on first down tick if conditions met)
        if active_position:
            best_sell_price = zone_machine.track_best_sell(price, entry_price, token_amount)
            if best_sell_price is not None:
                best_profit = calculate_precise_profit(entry_price, best_sell_price, token_amount)
                if best_profit is None:
                    logging.warning("Auto-sell: profit calculation returned None; skipping sell.")
                else:
                    # As requested: trigger on first 'down' tick that satisfies profit/fee/average-high
                    if trend == 'down':
                        # estimate depth for selling token_amount (we will simulate consuming bids)
                        depth_info = estimate_slippage_and_liquidity('sell', price, token_amount)
                        if not depth_info['filled']:
                            logging.info("Auto-sell skipped: insufficient bid depth to fill sell")
                        else:
                            slippage = depth_info['slippage_pct']
                            available = depth_info['available_base']
                            if available < token_amount * MIN_LIQUIDITY_RATIO:
                                logging.info("Auto-sell skipped: not enough liquidity within depth")
                            elif slippage > MAX_SLIPPAGE_PCT:
                                logging.info(f"Auto-sell skipped: estimated slippage {slippage*100:.2f}% > MAX_SLIPPAGE_PCT")
                            elif best_profit < MIN_PROFIT:
                                logging.info(f"Auto-sell skipped: best_profit ${best_profit:.4f} < MIN_PROFIT ${MIN_PROFIT:.4f}")
                            else:
                                logging.info(f"Auto-sell proceeding: estimated exec_price={depth_info['exec_price']:.4f}, slippage={slippage*100:.3f}%")
                                order_result = place_order('sell', token_amount, depth_info['exec_price'])
                                logging.info(f"Auto sell order_result: {order_result}")
                                if 'error' in order_result and order_result['error']:
                                    print(f"{COLOR_RED}Sell error: {order_result['error']}{COLOR_RESET}")
                                else:
                                    print(f"{COLOR_GREEN}Sold {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ approx ${depth_info['exec_price']:.4f}{COLOR_RESET}")
                                    print(f"{COLOR_GREEN}Entry: ${entry_price:.4f} | Exit: ${depth_info['exec_price']:.4f} | Profit: ${best_profit:.4f}{COLOR_RESET}")
                                    active_position = False
                                    position_investment = 0
                                    last_trade_time = now
                    else:
                        logging.info(f"Auto-sell waiting for trend down (current trend={trend})")

        # Per-tick active position profit log
        if active_position:
            current_profit = calculate_precise_profit(entry_price, price, token_amount)
            print(f"{COLOR_BLUE}Position: {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ ${entry_price:.4f}")
            print(f"{COLOR_MAGENTA}Current Profit: ${current_profit:.4f}{COLOR_RESET}")

        time.sleep(PRICE_CHECK_INTERVAL)

    except KeyboardInterrupt:
        print("\n\n" + "="*60)
        print(f"{COLOR_MAGENTA}Entering configuration mode... (type 'q' to resume trading){COLOR_RESET}")
        print("="*60)
        while config_thread.is_alive():
            time.sleep(1)
        config_thread = threading.Thread(target=config_monitor, daemon=True)
        config_thread.start()

    except Exception as e:
        logging.error(f"Main loop error: {str(e)}")
        print(f"{COLOR_RED}Main loop error: {str(e)}{COLOR_RESET}")
        import traceback
        traceback.print_exc()
        time.sleep(20)