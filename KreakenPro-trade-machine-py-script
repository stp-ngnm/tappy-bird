def get_valid_kraken_pair(pair):
    variations = [
        pair,
        f"X{pair}",
        f"{pair}Z",
        f"X{pair}Z",
        pair.replace("USD", "ZUSD"),
        f"X{pair.replace('USD', '')}ZUSD"
    ]
    for variation in variations:
        try:
            response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={variation}', timeout=5)
            data = response.json()
            if 'error' not in data or not data['error']:
                if DEBUG:
                    print(f"{COLOR_GREEN}Using pair format: {variation}{COLOR_RESET}")
                return variation
        except Exception as e:
            logging.warning(f"Pair validation error: {str(e)}")
            continue
    print(f"{COLOR_RED}Could not validate pair format, using {pair}{COLOR_RESET}")
    return pair


def get_ohlc(pair, interval, lookback):
    since = int((time.time() - lookback * interval * 60) // 1)
    params = {'pair': pair, 'interval': interval, 'since': since}
    try:
        response = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC", params=params, timeout=10)
        data = response.json()
        if 'error' in data and data['error']:
            logging.error(f"Kraken OHLC error: {data['error']}")
            return []
        pair_key = list(data['result'].keys())[0]
        ohlc_data = data['result'][pair_key]
        results = []
        for row in ohlc_data:
            try:
                results.append({
                    'timestamp': float(row[0]),
                    'open': float(row[1]),
                    'high': float(row[2]),
                    'low': float(row[3]),
                    'close': float(row[4])
                })
            except Exception as e:
                logging.warning(f"OHLC row parsing error: {str(e)}")
        return results
    except Exception as e:
        logging.error(f"OHLC Error: {str(e)}")
        return []


def get_ticker():
    try:
        response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={KRAKEN_PAIR}', timeout=5)
        data = response.json()
        if 'error' in data and data['error']:
            logging.error(f"Ticker error: {data['error']}")
            return None
        valid_pair = list(data['result'].keys())[0]
        ticker = data['result'][valid_pair]
        last_price = float(ticker['c'][0])
        return last_price
    except Exception as e:
        logging.error(f"Ticker Error: {str(e)}")
        return None


def get_order_book(pair, count=ORDERBOOK_DEPTH_LEVELS):
    """
    Fetch order book (depth) from Kraken public API.
    Returns dict with 'bids' and 'asks', each a list of (price: float, volume: float).
    """
    try:
        resp = requests.get(f"{API_URL}/{API_VERSION}/public/Depth", params={'pair': pair, 'count': count}, timeout=10)
        data = resp.json()
        if 'error' in data and data['error']:
            logging.error(f"Depth error: {data['error']}")
            return None
        pair_key = list(data['result'].keys())[0]
        ob = data['result'][pair_key]
        # bids are [price, volume, timestamp] - bids sorted highest->lowest
        bids = [(float(p), float(v)) for p, v, *_ in ob.get('bids', [])]
        # asks are [price, volume, timestamp] - asks sorted lowest->highest
        asks = [(float(p), float(v)) for p, v, *_ in ob.get('asks', [])]
        return {'bids': bids, 'asks': asks}
    except Exception as e:
        logging.error(f"Order book fetch error: {str(e)}")
        return None


def simulate_market_fill(side, base_amount, order_book):
    """
    Simulate executing a market order consuming the order_book.

    side: 'buy' (we consume asks) or 'sell' (we consume bids)
    base_amount: amount of base asset to buy/sell
    order_book: dict from get_order_book()

    Returns:
      (filled: bool, executed_price_avg: float, used_quote_volume: float, consumed_levels)
    - filled: False if cumulative available base volume < base_amount
    - executed_price_avg: weighted average price expected if filled
    - used_quote_volume: total quote currency spent (for buy) or received (for sell)
    - consumed_levels: number of depth levels consumed (for logging)
    """
    if order_book is None:
        return False, None, None, 0

    levels = order_book['asks'] if side == 'buy' else order_book['bids']
    cum_base = 0.0
    used_quote = 0.0
    consumed = 0
    for price, available in levels:
        take = min(available, base_amount - cum_base)
        used_quote += take * price
        cum_base += take
        consumed += 1
        if cum_base >= base_amount - 1e-12:
            break
    if cum_base + 1e-12 < base_amount:
        return False, None, None, consumed
    executed_avg = used_quote / base_amount
    return True, executed_avg, used_quote, consumed


def estimate_slippage_and_liquidity(side, price_ref, base_amount):
    """
    Fetch order book and estimate:
      - whether the orderbook can fill base_amount within fetched depth
      - weighted avg execution price
      - slippage_pct relative to price_ref (price_ref should be current ticker or tracked reference)

    Returns dict with keys:
      'filled' (bool), 'exec_price' (float), 'slippage_pct' (float), 'levels_consumed' (int), 'available_base' (float)
    """
    ob = get_order_book(KRAKEN_PAIR, count=ORDERBOOK_DEPTH_LEVELS)
    if ob is None:
        return {'filled': False, 'reason': 'no_orderbook'}

    side_name = 'buy' if side == 'buy' else 'sell'
    filled, exec_price, used_quote, consumed = simulate_market_fill(side_name, base_amount, ob)
    available_base = sum([v for _, v in (ob['asks'] if side == 'buy' else ob['bids'])])
    if not filled:
        return {'filled': False, 'reason': 'insufficient_depth', 'available_base': available_base}

    # slippage vs reference price
    if price_ref is None or price_ref == 0:
        slippage = 0.0
    else:
        slippage = (exec_price - price_ref) / price_ref if side == 'buy' else (price_ref - exec_price) / price_ref

    return {
        'filled': True,
        'exec_price': float(exec_price),
        'slippage_pct': float(slippage),
        'levels_consumed': consumed,
        'available_base': available_base
    }


def kraken_request(uri_path, data):
    import hashlib, hmac, base64, urllib.parse
    headers = {}
    headers['API-Key'] = API_KEY
    nonce = str(int(time.time() * 1000))
    data['nonce'] = nonce
    postdata = urllib.parse.urlencode(data)
    encoded = (nonce + postdata).encode()
    message = uri_path.encode() + hashlib.sha256(encoded).digest()
    api_secret = API_SECRET
    if len(api_secret) % 4 != 0:
        api_secret += '=' * (4 - len(api_secret) % 4)
    try:
        secret = base64.b64decode(api_secret)
        mac = hmac.new(secret, message, hashlib.sha512)
        headers['API-Sign'] = base64.b64encode(mac.digest()).decode()
        response = requests.post(API_URL + uri_path, data=data, headers=headers, timeout=10)
        try:
            return response.json()
        except Exception:
            return {'error': [f'Non-JSON response: {response.text}']}
    except Exception as e:
        logging.error(f"API Error: {str(e)}")
        return {'error': [str(e)]}


def place_order(order_type, amount, price):
    amount = round(amount, BOND_DECIMALS)
    data = {
        'ordertype': 'market',
        'type': order_type,
        'volume': amount,
        'pair': KRAKEN_PAIR,
        'validate': 'false'
    }
    print(f"{COLOR_YELLOW}Placing {order_type} order for {amount} at ${price:.4f}{COLOR_RESET}")
    try:
        result = kraken_request(f'/{API_VERSION}/private/AddOrder', data)
        logging.info(f"Order result: {result}")
        if 'error' in result and result['error']:
            logging.error(f"Order error details: {result['error']}")
        return result
    except Exception as e:
        logging.error(f"Order placement exception: {str(e)}")
        return {'error': [str(e)]}


def calculate_precise_profit(entry, exit, amount):
    if entry is None or exit is None or amount is None:
        logging.warning("Profit calculation with None value.")
        return None
    buy_fee = amount * entry * FEE_RATE
    effective_buy = amount * (1 - FEE_RATE)
    net_proceeds = effective_buy * exit * (1 - FEE_RATE)
    return net_proceeds - (amount * entry - buy_fee)


def dynamic_position_size(price):
    if price is None or price <= 0:
        logging.warning("Dynamic position size received invalid price.")
        return 0.0
    return INVESTMENT_AMOUNT / price


# ---- Added missing get_trend function ----
def get_trend(ohlc_data, window=10):
    """
    Simple trend detector: compare last close to mean of previous `window` closes.
    Returns 'up' or 'down' or None if insufficient data.
    """
    try:
        closes = [row['close'] for row in ohlc_data[-window:] if row.get('close') is not None]
    except Exception:
        return None
    if len(closes) < window:
        return None
    return 'up' if closes[-1] > np.mean(closes) else 'down'
# ---- end get_trend ----


