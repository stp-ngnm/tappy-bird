def calc_profit(entry: float, exit_p: float, amt: float) -> float:
    if entry and exit_p and amt: return (amt * exit_p * (1 - FEE_RATE)) - (amt * entry * (1 + FEE_RATE))
    return 0.0

# ========================== NUMERICALLY STABLE MACD ==========================
def calc_macd(ohlc: List[Dict], f: int = MACD_FAST, s: int = MACD_SLOW, sig: int = MACD_SIGNAL) -> Tuple:
    """Calculate MACD with numerically stable EMA and SMA warmup."""
    if len(ohlc) < s + sig: return None, None, None
    closes = np.array([x['close'] for x in ohlc], dtype=np.float64)

    def ema_stable(data: np.ndarray, span: int) -> np.ndarray:
        ema_values = np.full(len(data), np.nan)
        if len(data) < span: return ema_values
        alpha = 2.0 / (span + 1)
        ema_values[span-1] = np.mean(data[:span])
        for i in range(span, len(data)):
            ema_values[i] = alpha * data[i] + (1 - alpha) * ema_values[i-1]
        return ema_values

    ema_fast = ema_stable(closes, f)
    ema_slow = ema_stable(closes, s)
    macd_line = np.where(np.isnan(ema_slow), np.nan, ema_fast - ema_slow)
    
    valid_mask = ~np.isnan(macd_line)
    valid_macd = macd_line[valid_mask]
    signal_line = np.full(len(macd_line), np.nan)
    
    if len(valid_macd) >= sig:
        sig_ema = np.zeros(len(valid_macd))
        alpha_sig = 2.0 / (sig + 1)
        sig_ema[sig-1] = np.mean(valid_macd[:sig])
        for i in range(sig, len(valid_macd)):
            sig_ema[i] = alpha_sig * valid_macd[i] + (1 - alpha_sig) * sig_ema[i-1]
        start_idx = np.argmax(valid_mask)
        signal_line[start_idx:] = sig_ema

    histogram = macd_line - signal_line
    return float(macd_line[-1]), float(signal_line[-1]), float(histogram[-1])

def simulate_fill(side: str, amt: float, ob: Dict) -> Tuple:
    if not ob: return False, None, None, 0
    levels = ob['asks'] if side == 'buy' else ob['bids']
    levels = sorted(levels, key=lambda x: x[0]) if side == 'buy' else sorted(levels, key=lambda x: -x[0])
    cum, used, cons = 0.0, 0.0, 0
    for p, a in levels:
        take = min(a, amt - cum); used += take * p; cum += take; cons += 1
        if cum >= amt - EPS: break
    if cum >= amt - EPS: return (True, used / amt if cum > 0 else 0, used, cons)
    return (False, None, None, cons)

def dyn_size(price: float, side: str, ob: Dict, max_inv: float = BASE_INVESTMENT) -> Tuple:
    if not ob: return 0, None, None
    levels = ob['asks'] if side == 'buy' else ob['bids']
    total = sum(v for _, v in levels)
    if total == 0: return 0, None, None
    tgt = max_inv / price; low, high = 0.0, min(tgt, total)
    best, bp, bs = 0.0, price, 0.0
    for _ in range(20):
        mid = (low + high) / 2
        if mid < EPS: break
        f, ep, _, _ = simulate_fill(side, mid, ob)
        if f:
            sl = abs(ep - price) / price
            if sl <= MAX_SLIPPAGE_PCT: best, bp, bs = mid, ep, sl; low = mid
            else: high = mid
        else: high = mid
    if best * bp >= MIN_ORDER_USD:
        rounded = round(best, 4) if bp < 1.0 else round(best, BOND_DECIMALS)
        if rounded > 0: return (rounded, bp, bs)
    return (0, None, None)

# ========================== MARKET INDICATORS ==========================
def calc_bollinger(ohlc: List[Dict], period: int = BOLLINGER_PERIOD, num_std: float = BOLLINGER_STD) -> Tuple:
    if not ohlc or len(ohlc) < period: return None, None, None
    closes = np.array([x['close'] for x in ohlc[-period:]])
    mid = np.mean(closes); std = np.std(closes)
    return mid, mid + num_std * std, mid - num_std * std

def calc_iqr(ohlc: List[Dict], lookback: int = IQR_ML_LOOKBACK) -> Tuple:
    if not ohlc or len(ohlc) < lookback: return None, None, None
    closes = np.array([x['close'] for x in ohlc[-lookback:]])
    q1 = np.percentile(closes, 25); q3 = np.percentile(closes, 75)
    return q1, q3, q3 - q1

def calc_spring_trap(ohlc: List[Dict], price: float) -> float:
    if not ohlc or len(ohlc) < SPRING_LOOKBACK: return 0.5
    scores = []
    _, _, bb_lower = calc_bollinger(ohlc)
    if bb_lower is not None and bb_lower > 0:
        compression = max(0.0, min(1.0, 1.0 - (price - bb_lower) / (bb_lower * 0.02 + EPS)))
        scores.append(compression)
    if len(ohlc) >= SPRING_MOMENTUM_WINDOW + 1:
        recent = np.array([x['close'] for x in ohlc[-SPRING_MOMENTUM_WINDOW - 1:]])
        mom = (recent[-1] - recent[0]) / recent[0]
        scores.append(min(1.0, abs(mom) / 0.005) if mom < 0 else 0.0)
    if len(ohlc) >= SPRING_VOLUME_WINDOW:
        vols = np.array([x['volume'] for x in ohlc[-SPRING_VOLUME_WINDOW:]])
        if np.mean(vols) > 0:
            half = len(vols) // 2
            vol_trend = (np.mean(vols[half:]) - np.mean(vols[:half])) / (np.mean(vols) + EPS)
            scores.append(min(1.0, abs(vol_trend)) if vol_trend < 0 else 0.0)
    if not scores: return 0.5
    weights = [0.4, 0.35, 0.25][:len(scores)]
    return max(0.0, min(1.0, sum(s * w for s, w in zip(scores, weights))))

# ========================== FEATURE CALCULATION LAYER ==========================
def calculate_all_features(price: float, zm: Any, trend: str, ob: Optional[Dict], pos: Dict, ohlc: List[Dict]) -> Dict[str, float]:
    features: Dict[str, float] = {}
    if ohlc and len(ohlc) >= 10:
        closes = [x['close'] for x in ohlc]
        features['mom5'] = (closes[-1] - closes[-5]) / (closes[-5] + EPS)
        features['mom10'] = (closes[-1] - closes[-10]) / (closes[-10] + EPS)
        if len(ohlc) >= VOL_TREND_LOOKBACK:
            vols = np.array([x['volume'] for x in ohlc[-VOL_TREND_LOOKBACK:]])
            half = len(vols) // 2
            features['volTrend'] = (np.mean(vols[half:]) - np.mean(vols[:half])) / (np.mean(vols) + EPS)
            features['vol'] = float(vols[-1])
        else: features['volTrend'] = 0.0; features['vol'] = float(ohlc[-1]['volume'])
    else: features['mom5'] = features['mom10'] = features['vol'] = features['volTrend'] = 0.0

    zone = zm.zone(price) if zm else 'OUTSIDE'
    features['zBuy'] = 1.0 if zone == 'BUY' else 0.0
    features['zSell'] = 1.0 if zone == 'SELL' else 0.0
    features['zNeu'] = 1.0 if zone == 'NEUTRAL' else 0.0
    if zone == 'BUY' and zm and zm.buy_zone: features['zDep'] = abs(price - zm.buy_zone[1]) / price if price > 0 else 0.0
    elif zone == 'SELL' and zm and zm.sell_zone: features['zDep'] = abs(price - zm.sell_zone[0]) / price if price > 0 else 0.0
    else: features['zDep'] = 0.0

    features['tUp'] = 1.0 if trend == "UP" else 0.0
    features['tDn'] = 1.0 if trend == "DOWN" else 0.0

    if ob:
        bids = ob.get('bids', [])[:20]; asks = ob.get('asks', [])[:20]
        if bids and asks:
            features['sprd'] = (asks[0][0] - bids[0][0]) / price if price > 0 else 0.0
            bid_vol = sum(v for _, v in bids); ask_vol = sum(v for _, v in asks)
            features['imb'] = (bid_vol - ask_vol) / (bid_vol + ask_vol + EPS)
            features['liq'] = (bid_vol + ask_vol) / 1000.0  # Pure volume
        else: features['sprd'] = features['imb'] = features['liq'] = 0.0
    else: features['sprd'] = features['imb'] = features['liq'] = 0.0

    if pos.get('active'):
        features['pnl'] = calc_profit(pos['entry'], price, pos['amt']) if pos.get('amt') else 0.0
        features['hold'] = (time.time() - pos['time']) / 3600.0 if pos.get('time') else 0.0
    else: features['pnl'] = features['hold'] = 0.0

    features['spring'] = calc_spring_trap(ohlc, price)
    for k, v in features.items():
        if isinstance(v, float) and (math.isnan(v) or math.isinf(v)): features[k] = 0.0
    return features

# ========================== LOGIC-FIRST FILTERS ==========================
def pre_ml_filters(features: Dict[str, float], price: float, zm: Any, ob: Optional[Dict], pos: Dict, ml: Any = None) -> Tuple[bool, bool, str]:
    if features['volTrend'] < -0.5 and (features['vol'] * price) < 1000: return False, False, "Low volume (USD) + declining"
    if features['zBuy'] == 1.0 and features['mom5'] < -0.001: return False, False, "Buy zone but negative momentum"
    if features['zSell'] == 1.0 and features['mom5'] > 0.001: return False, False, "Sell zone but positive momentum"
    if features['spring'] > 0.7 and features['zBuy'] == 1.0: return False, False, "Spring trap in buy zone"
    if features['liq'] < 50.0 and features['sprd'] > 0.005: return False, False, "Thin book + wide spread"
    if features['tUp'] == 1.0 and features['mom10'] < -0.002: return False, False, "MACD up but 10-candle momentum down"
    
    if pos.get('active'):
        entry_val = pos.get('entry', 0) * pos.get('amt', 0)
        if ml and ml.check_ml_stop_loss(pos['entry'], price, features['pnl']): return False, True, "ML Early Stop Loss"
        if features['spring'] > 0.8 and features['volTrend'] < -0.3: return False, True, "Spring + volume decline = exit"
        if zm and zm.sell_sig(price) and features['pnl'] >= MIN_PROFIT: return False, True, "Zone Sell + Min Profit"
        if features['mom5'] < 0 and features['pnl'] > 0.05 * entry_val: return False, True, "Take Profit (5%) + Momentum Stall"
        
    if zm and zm.buy_sig(price):
        if features.get('zDep', 0.0) > ZDEP_MAX: return False, False, "Too deep in buy zone"
        buy_confidence = 0.0
        buy_confidence += max(0.0, min(1.0, (features['mom5'] + 0.01) * 50.0)) * 0.3
        buy_confidence += (1 - features['spring']) * 0.4
        buy_confidence += max(0.0, min(1.0, features['volTrend'] + 0.5)) * 0.2
        buy_confidence += max(0.0, min(1.0, features['imb'] + 0.5)) * 0.1
        if buy_confidence > 0.5: return True, False, f"Zone buy + confidence {buy_confidence:.2f}"
    return False, False, "No signal"

# ========================== ML VALIDATION LAYER ==========================
def trade_decision(features: Dict[str, float], price: float, zm: Any, ob: Optional[Dict], pos: Dict, ml: Any) -> Tuple[bool, bool, str]:
    should_buy, should_sell, logic_reason = pre_ml_filters(features, price, zm, ob, pos, ml)
    if ml and ml.trained:
        entry_prob = ml.pred_entry(features)
        exit_pred = ml.pred_exit(features)
        if should_buy and entry_prob < ML_CONFIDENCE:
            logging.info(f"ML VETO: Buy blocked (prob={entry_prob:.3f} < {ML_CONFIDENCE})")
            should_buy = False
        if should_sell and exit_pred is not None:
            current_profit = features.get('pnl', 0.0)
            if exit_pred > current_profit * 1.2:
                logging.info(f"ML VETO: Sell blocked (exit_pred={exit_pred:.2f} > current={current_profit:.2f} * 1.2)")
                should_sell = False
            elif exit_pred < current_profit * 0.5:
                logging.info(f"ML BOOST: Sell encouraged (exit_pred={exit_pred:.2f})")
    return should_buy, should_sell, logic_reason

# ========================== KELLY SIZING ==========================
def get_kelly_bet(ml: Any) -> float:
    if not USE_KELLY_SIZING: return BASE_INVESTMENT
    if not ml or len(ml.trades) < KELLY_LOOKBACK_TRADES:
        logging.info("Kelly: insufficient trades, falling back to BASE_INVESTMENT"); return BASE_INVESTMENT
    recent = list(ml.trades)[-KELLY_LOOKBACK_TRADES:]
    wins = [t['p'] for t in recent if t['l'] == 1]; losses = [t['p'] for t in recent if t['l'] == 0]
    if not wins or not losses:
        logging.info("Kelly: no wins or losses, falling back to BASE_INVESTMENT"); return BASE_INVESTMENT
    win_rate = len(wins) / len(recent); avg_win = np.mean(wins); avg_loss = abs(np.mean(losses))
    if avg_loss == 0: return BASE_INVESTMENT
    b = avg_win / avg_loss; p, q = win_rate, 1 - win_rate
    kelly_f = (b * p - q) / b
    safe_f = max(KELLY_MIN_REDUCE_PCT, min(kelly_f * 0.5, MAX_KELLY_INCREASE_PCT))
    bet_size = BASE_INVESTMENT * (1 + safe_f)
    if bet_size < MIN_ORDER_USD:
        logging.info(f"KELLY BLOCKED: Bet size ${bet_size:.2f} < ${MIN_ORDER_USD:.2f} minimum"); return 0
    return bet_size

# ========================== ML ADVISOR ==========================
class MLAdvisor:
    def __init__(self):
        self.entry_model = None; self.exit_model = None; self.scaler = RobustScaler()
        self.hist = deque(maxlen=100); self.trades = []; self.trained = False
        self.best_entry_params = {}; self.best_exit_params = {}
        self.fnames = ['mom5', 'mom10', 'vol', 'zBuy', 'zSell', 'zNeu', 'zDep', 'tUp', 'tDn', 'sprd', 'imb', 'liq', 'pnl', 'hold', 'spring', 'volTrend']
        self._load()

    def _vec(self, f: Dict) -> np.ndarray:
        missing = [name for name in self.fnames if name not in f]
        if missing: logging.warning(f"Missing features in prediction: {missing}. Defaulting to 0.0")
        return np.array([[f.get(name, 0.0) for name in self.fnames]])

    def pred_entry(self, f: Dict) -> float:
        if not self.trained or self.entry_model is None: return 0.9
        try:
            proba = self.entry_model.predict_proba(self.scaler.transform(self._vec(f)))
            if proba.shape[1] < 2: return 0.9
            return float(proba[0][1])
        except Exception as e: logging.error(f"ML entry prediction failed: {e}"); return 0.9

    def pred_exit(self, f: Dict) -> Optional[float]:
        if not self.trained or self.exit_model is None: return None
        try: return float(self.exit_model.predict(self.scaler.transform(self._vec(f)))[0])
        except Exception as e: logging.error(f"ML exit prediction failed: {e}"); self.trained = False; return None

    def check_ml_stop_loss(self, entry_price: float, current_price: float, current_profit: float) -> bool:
        if not self.trained or len(self.trades) < ML_MIN_SAMPLES or entry_price == 0: return False
        loss_pct = (entry_price - current_price) / entry_price
        if 0.02 <= loss_pct <= 0.13 and self.hist:
            last = self.hist[-1]
            if last.get('spring', 0.5) > 0.7 and current_profit < 0: return True
            if last.get('volTrend', 0.0) < -0.5 and current_profit < 0: return True
        return False

    def record(self, ef: Dict, ep: float, xp: float, amt: float) -> None:
        p = calc_profit(ep, xp, amt)
        self.trades.append({'f': ef.copy(), 'p': p, 'l': 1 if p >= MIN_PROFIT else 0})
        if len(self.trades) > ML_MAX_SAMPLES: self.trades = self.trades[-ML_MAX_SAMPLES:]
        if len(self.trades) % ML_RETRAIN == 0 or len(self.trades) == ML_MIN_SAMPLES:
            with open("ml_trade_samples.log", "a") as f: f.write(f"{time.time()},{p},{1 if p >= MIN_PROFIT else 0},{json.dumps(ef)}\n")
        if len(self.trades) >= ML_MIN_SAMPLES and len(self.trades) % ML_RETRAIN == 0: self._train()

    def _entry_pipeline(self, params: Dict = None) -> Pipeline:
        p = params or {}
        return Pipeline([('scaler', RobustScaler()), ('model', HistGradientBoostingClassifier(max_iter=p.get('max_iter', 100), max_leaf_nodes=p.get('max_leaf_nodes', 15), learning_rate=p.get('learning_rate', 0.08), l2_regularization=p.get('l2_regularization', 1.0), random_state=42))])

    def _exit_pipeline(self, params: Dict = None) -> Pipeline:
        p = params or {}
        return Pipeline([('scaler', RobustScaler()), ('model', GradientBoostingRegressor(n_estimators=p.get('n_estimators', 100), learning_rate=p.get('learning_rate', 0.08), max_depth=p.get('max_depth', 3), random_state=42))])

    def walk_forward_validate(self, X: np.ndarray, y_entry: np.ndarray, y_exit: np.ndarray) -> Optional[Dict]:
        tscv = TimeSeriesSplit(n_splits=ML_WF_SPLITS); accs, rmses = [], []; skipped_folds = 0
        for train_idx, test_idx in tscv.split(X):
            X_tr, X_te = X[train_idx], X[test_idx]
            ye_tr, ye_te = y_entry[train_idx], y_entry[test_idx]
            yx_tr, yx_te = y_exit[train_idx], y_exit[test_idx]
            if len(np.unique(ye_tr)) < 2 or len(test_idx) == 0: skipped_folds += 1; continue
            pe = self._entry_pipeline(self.best_entry_params); pe.fit(X_tr, ye_tr); accs.append(float(np.mean(pe.predict(X_te) == ye_te)))
            px = self._exit_pipeline(self.best_exit_params); px.fit(X_tr, yx_tr); pred = px.predict(X_te); rmses.append(float(np.sqrt(np.mean((pred - yx_te) ** 2))))
        if skipped_folds == ML_WF_SPLITS or not accs or not rmses:
            logging.warning("WF validation: no valid folds. Rejecting model."); return None
        wf = {'folds': len(accs), 'entry_accuracy_oos': float(np.mean(accs)), 'exit_rmse_oos': float(np.mean(rmses))}
        if wf['entry_accuracy_oos'] < 0.6 or wf['exit_rmse_oos'] > 0.5:
            logging.warning(f"WF validation failed (acc={wf['entry_accuracy_oos']:.2f}, rmse={wf['exit_rmse_oos']:.2f}). Rejecting model."); return None
        return wf

    def _train(self) -> None:
        if len(self.trades) < ML_MIN_SAMPLES: return
        X = np.array([self._vec(t['f'])[0] for t in self.trades])
        y_entry = np.array([t['l'] for t in self.trades]); y_exit = np.array([t['p'] for t in self.trades])
        if len(np.unique(y_entry)) < 2: logging.warning("ML training skipped: need both win and loss samples."); return
        
        entry_search = RandomizedSearchCV(self._entry_pipeline(), param_distributions={'model__max_iter': randint(50, 200), 'model__max_leaf_nodes': randint(7, 31), 'model__learning_rate': uniform(0.02, 0.15), 'model__l2_regularization': uniform(0.0, 5.0)}, n_iter=ML_TUNING_ITERATIONS, cv=TimeSeriesSplit(3), scoring='accuracy', random_state=42, n_jobs=-1)
        entry_search.fit(X, y_entry); self.best_entry_params = entry_search.best_params_
        logging.info(f"Entry CV accuracy: {entry_search.best_score_:.3f}")

        exit_search = RandomizedSearchCV(self._exit_pipeline(), param_distributions={'model__n_estimators': randint(50, 200), 'model__learning_rate': uniform(0.01, 0.2), 'model__max_depth': randint(2, 6)}, n_iter=ML_TUNING_ITERATIONS, cv=TimeSeriesSplit(3), scoring='neg_mean_squared_error', random_state=42, n_jobs=-1)
        exit_search.fit(X, y_exit); self.best_exit_params = exit_search.best_params_
        logging.info(f"Exit CV RMSE: {-exit_search.best_score_:.3f}")

        wf = self.walk_forward_validate(X, y_entry, y_exit)
        if wf is None: return
        logging.info(f"WALK-FORWARD: {wf}")

        final_entry = self._entry_pipeline(self.best_entry_params).fit(X, y_entry)
        final_exit = self._exit_pipeline(self.best_exit_params).fit(X, y_exit)
        self.scaler = final_entry.named_steps['scaler']; self.entry_model = final_entry.named_steps['model']; self.exit_model = final_exit.named_steps['model']
        self.trained = True
        logging.info(f"ML trained on {len(self.trades)} samples. Entry params: {self.best_entry_params}")
        if hasattr(self.entry_model, 'feature_importances_'):
            importances = dict(zip(self.fnames, self.entry_model.feature_importances_))
            logging.info(f"Entry feature importances: {importances}")

        try:
            os.makedirs(ML_PATH, exist_ok=True)
            try: joblib.dump(self.entry_model, os.path.join(ML_PATH, 'entry_model.pkl'))
            except Exception as e: logging.error(f"Failed to save entry model: {e}")
            try: joblib.dump(self.exit_model, os.path.join(ML_PATH, 'exit_model.pkl'))
            except Exception as e: logging.error(f"Failed to save exit model: {e}")
            try: joblib.dump(self.scaler, os.path.join(ML_PATH, 'scaler.pkl'))
            except Exception as e: logging.error(f"Failed to save scaler: {e}")
            with open(os.path.join(ML_PATH, 'tuning_report.json'), 'w') as f:
                json.dump({'entry_params': {k: float(v) if isinstance(v, (np.floating, float)) else int(v) for k, v in self.best_entry_params.items()}, 'exit_params': {k: float(v) if isinstance(v, (np.floating, float)) else int(v) for k, v in self.best_exit_params.items()}, 'walk_forward': wf, 'trained_at': time.time(), 'samples': len(self.trades)}, f, indent=2)
        except Exception as e: logging.error(f"Failed to save ML tuning report: {e}")

    def _load(self) -> None:
        try:
            ep = os.path.join(ML_PATH, 'entry_model.pkl'); xp = os.path.join(ML_PATH, 'exit_model.pkl'); sp = os.path.join(ML_PATH, 'scaler.pkl')
            if os.path.exists(ep) and os.path.exists(xp) and os.path.exists(sp):
                self.entry_model = joblib.load(ep); self.exit_model = joblib.load(xp); self.scaler = joblib.load(sp)
                self.trained = True; logging.info("Loaded existing ML models.")
                rp = os.path.join(ML_PATH, 'tuning_report.json')
                if os.path.exists(rp):
                    with open(rp) as f: report = json.load(f)
                    self.best_entry_params = report.get('entry_params', {}); self.best_exit_params = report.get('exit_params', {})
        except Exception as e: logging.warning(f"Could not load ML models: {e}")

# ========================== ZONE MACHINE (STATIC CAGE) ==========================
class ZoneMachine:
    def __init__(self):
        self.buy_zone = None; self.sell_zone = None; self.neutral_zone = None; self.median = 0.0; self.last_rebuild_time = 0
        self.buy_prices = deque(maxlen=250); self.sell_prices = deque(maxlen=250); self.neutral_prices = deque(maxlen=250)

    def init(self, ohlc: List[Dict]) -> bool:
        if not ohlc or len(ohlc) < 10: return False
        self.median = np.median([x['close'] for x in ohlc])
        self.neutral_zone = (self.median - ZONE_BUFFER, self.median + ZONE_BUFFER)
        self.buy_zone = (self.median - ZONE_BUFFER - BUY_ZONE_EXTRA, self.median - ZONE_BUFFER)
        self.sell_zone = (self.median + ZONE_BUFFER, self.median + ZONE_BUFFER + SELL_ZONE_EXTRA)
        self.last_rebuild_time = time.time(); return True

    def zone(self, price: float) -> str:
        if self.buy_zone and self.buy_zone[0] <= price <= self.buy_zone[1]: return 'BUY'
        elif self.sell_zone and self.sell_zone[0] <= price <= self.sell_zone[1]: return 'SELL'
        elif self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]: return 'NEUTRAL'
        return 'OUTSIDE'

    def buy_sig(self, price: float) -> bool:
        z = self.zone(price)
        if z == 'BUY':
            self.buy_prices.append(price)
            avg = np.mean(self.buy_prices) if self.buy_prices else self.median
            return abs(price - avg) / avg <= ENTRY_RANGE_PCT if avg > 0 else False
        return False

    def sell_sig(self, price: float) -> bool:
        z = self.zone(price)
        if z == 'SELL':
            self.sell_prices.append(price)
            avg = np.mean(self.sell_prices) if self.sell_prices else self.median
            return abs(price - avg) / avg <= ENTRY_RANGE_PCT if avg > 0 else False
        return False

    def check_redefinition(self, price: float, ohlc: List[Dict]) -> bool:
        z = self.zone(price)
        if z == 'OUTSIDE' and time.time() - self.last_rebuild_time > ZONE_OUTSIDE_TIMEOUT:
            if ohlc and len(ohlc) >= 60:
                recent_med = np.median([x['close'] for x in ohlc[-20:]])
                older_med = np.median([x['close'] for x in ohlc[-60:-20]])
                if older_med != 0 and abs(recent_med - older_med) / older_med > AVG_SHIFT_PCT: return True
        return False

