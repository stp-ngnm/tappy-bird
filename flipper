    print(f"{SUB}buy:{RESET} {NUM}$${zm.buy_zone[0]:.4f}{RESET} - {NUM}$${zm.buy_zone[1]:.4f}{RESET}", flush=True)
    print(f"{BORDER}====== {TITLE}PLOT OVERLAY{BORDER} ====={RESET}", flush=True)
    print(f"{SUB}Bollinger(50,2\u03c3):{RESET} {NUM}$${bb_lower:.4f}{RESET} / {NUM}$${bb_mid:.4f}{RESET} / {NUM}${bb_upper:.4f}{RESET} {SUB}| pos:{RESET} {NUM}{bb_pos}{RESET}", flush=True)
    print(f"{SUB}IQR(60min):{RESET} {NUM}$${iqr_q1:.4f}{RESET} - {NUM}$${iqr_q3:.4f}{RESET} {SUB}| spread:{RESET} {NUM}${iqr_val:.4f}{RESET} {SUB}| pos:{RESET} {NUM}{iqr_pos}{RESET}", flush=True)
