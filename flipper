        print(f"{SUB}Note: Color output disabled for this terminal environment.{RESET}")
    
    while True:
        try:
            # ======== PAUSED STATE ========
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt): continue
                if cmd == 'r': trading_paused = False; print(f"{PROF_P}▶️ RESUMED{RESET}"); continue
                elif cmd == 'q': print("👋 Exiting..."); sys.exit(0)
                elif cmd in ('b', 's'): 
                    price = get_ticker()
                    if not price: continue
                    if cmd == "b" and not active_position:
                        amt = BASE_INVESTMENT / price
                        if amt * price >= MIN_ORDER_USD:
                            res = place_order('buy', amt, price)
                            if res and not res.get('error'):
                                active_position = True; entry_price = price; token_amount = amt
                                last_trade_time = time.time(); last_trade_type = "MANUAL BUY"
                                txid = "N/A"
                                try: 
                                    txid_list = res.get('result', {}).get('txid', [])
                                    if isinstance(txid_list, list) and len(txid_list) > 0: txid = txid_list[0]
                                except: pass
                                print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="MANUAL")
                    elif cmd == "s" and active_position:
                        res = place_order('sell', token_amount, price)
                        if res and not res.get('error'):
                            active_position = False; token_amount = 0
                            last_trade_time = time.time(); last_trade_type = "MANUAL SELL"
                            txid = "N/A"
                            try: 
                                txid_list = res.get('result', {}).get('txid', [])
                                if isinstance(txid_list, list) and len(txid_list) > 0: txid = txid_list[0]
                            except: pass
                            print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="MANUAL")
                    continue
                else: print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}"); continue

            # ======== RUNNING STATE ========
            price = get_ticker()
            if not price: 
                time.sleep(PRICE_CHECK_INTERVAL)
                continue
            price = round(price, 4)
            
            # 1. Fetch OHLC & Analyze Market State
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 10:
                aH = np.max([x['high'] for x in ohlc])
                aL = np.min([x['low'] for x in ohlc])
                aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2)
                if not zm.buy_zone: 
                    zm.init(ohlc)
            else:
                aH = aL = aM = 0.0
                
            trend = "neutral"
            try:
                ho = get_ohlc(KRAKEN_PAIR, 60, 100)
                if ho: 
                    m, s, _ = calc_macd(ho)
                    if m and s: trend = "up" if m > s else "down"
            except: pass
            last_trend = trend
            
            # 2. Stop Loss Check (Overrides All)
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                res = place_order('sell', token_amount, price, ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                if res and not res.get('error'):
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL); continue
                
            # 3. ML Feature Extraction
            pos = {'active': active_position, 'entry': entry_price, 'time': last_trade_time}
            ob_data = get_order_book(KRAKEN_PAIR)
            ef = ml.extract(price, zm, trend, ob_data, pos) if ml else {}
            ec = ml.pred_entry(ef) if ml else 0.5
            ee = ml.pred_exit(ef) if ml else 999.0
            
            current_profit = calc_profit(entry_price, price, token_amount) if active_position else 0.0
            
            # 4. Auto BUY
            if not active_position and (time.time() - last_trade_time > AUTO_COOLDOWN_SEC):
                if zm.zone(price) == "BUY" and ec > ML_CONFIDENCE:
                    amt = BASE_INVESTMENT / price
                    if amt * price >= MIN_ORDER_USD:
                        res = place_order('buy', amt, price)
                        if res and not res.get('error'):
                            active_position = True; entry_price = price; token_amount = amt
                            last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                            txid = "N/A"
                            try: 
                                txid_list = res.get('result', {}).get('txid', [])
                                if isinstance(txid_list, list) and len(txid_list) > 0: txid = txid_list[0]
                            except: pass
                            print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="AUTO")
                            if ml: ml.record(ef, price, price, amt)
                            
            # 5. Auto SELL (Trend-Independent + ML Fallback)
            if active_position:
                logic_gate = zm.sell_sig(price, entry_price, token_amount)
                ml_gate = (ee >= MIN_PROFIT) if (ml and ml.trained) else True
                
                if logic_gate and ml_gate:
                    ob = ob_data if ob_data else get_order_book(KRAKEN_PAIR)
                    if ob:
                        f_fill, ep_fill, _, _ = simulate_fill('sell', token_amount, ob)
                        sl = abs(ep_fill - price) / price if f_fill else 1.0
                        if sum(v for _, v in ob['bids']) >= token_amount * MIN_LIQUIDITY_RATIO and sl <= MAX_SLIPPAGE_PCT:
                            res = place_order('sell', token_amount, ep_fill)
                            if res and not res.get('error'):
                                active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                                txid = "N/A"
                                try: 
                                    txid_list = res.get('result', {}).get('txid', [])
                                    if isinstance(txid_list, list) and len(txid_list) > 0: txid = txid_list[0]
                                except: pass
                                print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")
                                if ml: ml.record(ef, price, entry_price, token_amount)
                                
            # 6. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount, current_profit, last_trade_type, entry_price, aH, aL, aM)
            time.sleep(PRICE_CHECK_INTERVAL)
            
        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}"); time.sleep(10)

if __name__ == "__main__":
    main()