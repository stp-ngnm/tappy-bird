def get_valid_kraken_pair(pair: str) -> str:
    variations = [pair, f"X{pair}", f"{pair}Z", f"X{pair}Z", pair.replace("USD", "ZUSD"), f"X{pair.replace('USD', '')}ZUSD"]
    for variation in variations:
        try:
            rate_limit()
            response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={variation}', timeout=5)
            data = response.json()
            if 'error' not in data or not data['error']:
                if variation != pair: logging.info(f"Resolved pair {pair} to {variation}")
                return variation
        except Exception: continue
    logging.warning(f"Could not validate pair {pair}. Proceeding with original.")
    return pair

