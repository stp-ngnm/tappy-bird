    print(f"{BORDER}====== {TITLE}MARKET STATUS{BORDER} ======{RESET}", flush=True)
    print(f"{SUB}Current Price:{RESET} {NUM}$${price:.4f}{RESET} {SUB}| last entry price:{RESET} {NUM}$${ep:.4f}{RESET}", flush=True)
    print(f"{SUB}active tokens:{RESET} {NUM}{amt:.8f}{RESET} {SUB}| spent amount:{RESET} {NUM}${spent:.2f}{RESET}", flush=True)
    print(f"{SUB}Status:{RESET} {NUM}{'ACTIVE' if act else 'WAITING'}{RESET} {SUB}| Last Action:{RESET} {NUM}{lt}{RESET}", flush=True)
    print(f"{pc}profit margin: {prof:+.2f}{RESET}", flush=True)
    print(f"{BORDER}==========================={RESET}\n", flush=True)

# ========================== MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time
    global last_trend, last_trade_type, trading_paused, KRAKEN_PAIR, failed_ticks

    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    logging.info(f"Validated pair: {KRAKEN_PAIR}")

    zm = ZoneMachine()
    ml = MLAdvisor() if ML_ENABLED else None
    pos = {'active': False, 'entry': 0.0, 'time': 0.0}

    # --- Initial zone build ---
    ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
    if not zm.init(ohlc):
        logging.error("Could not initialize zones. Retrying in 30s...")
        time.sleep(30)
        ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
        if not zm.init(ohlc):
            logging.critical("Zone init failed after retry. Exiting.")
            sys.exit(1)

    logging.info(f"Zones initialized. Median: ${zm.median:.4f}")
    print(f"\n{BORDER}\U0001f680 Bot Started. Monitoring {KRAKEN_PAIR}...{RESET}")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}\n", flush=True)

    time.sleep(PRICE_CHECK_INTERVAL)

    # --- Main loop ---
    while True:
        try:
            # ======== PAUSED STATE ========
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}\u23f8 [PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    continue
                if cmd == 'r':
                    trading_paused = False
                    print(f"{PROF_P}\u25b6 RESUMED{RESET}", flush=True)
                    continue
                elif cmd == 'q':
                    if active_position:
                        logging.warning(f"Position still active! Entry: ${entry_price:.4f} | Amt: {token_amount:.8f}")
                    print("\n\U0001f44b Exiting...", flush=True)
                    sys.exit(0)
                elif cmd in ('b', 's'):
                    execute_manual(cmd)
                    continue
                else:
                    print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}", flush=True)
                    continue

            # ======== RUNNING STATE ========

            # Cooldown check
            if time.time() - last_trade_time < AUTO_COOLDOWN_SEC and last_trade_type != "NONE":
                time.sleep(PRICE_CHECK_INTERVAL)
                continue

            # Fetch live price
            price = get_ticker()
            if not price:
                backoff = min(60, 5 * (failed_ticks + 1))
                logging.warning(f"Ticker fetch failed. Retrying in {backoff}s...")
                time.sleep(backoff)
                failed_ticks += 1
                continue
            failed_ticks = 0
            price = round(price, 4)

            # Fetch OHLC
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)

            # Fetch order book
            ob = get_order_book(KRAKEN_PAIR)

            # MACD trend
            macd_line, signal_line, _ = calc_macd(ohlc)
            if macd_line is not None and signal_line is not None:
                last_trend = "UP" if macd_line > signal_line else "DOWN"
            else:
                last_trend = "UNKNOWN"

            # Real Bollinger Bands
            bb_mid, bb_upper, bb_lower = calc_bollinger(ohlc)

            # Real IQR
            iqr_q1, iqr_q3, iqr_val = calc_iqr(ohlc, IQR_ML_LOOKBACK)

            # Spring trap value
            spring_val = calc_spring_trap(ohlc, price)

            # --- Zone redefinition check ---
            if ohlc and len(ohlc) >= 10:
                if zm.check_redefinition(price, ohlc):
                    logging.info("\U0001f504 Zones redefined (avg shift or >3min outside).")
                    zm.init(ohlc)

            # Dashboard display values
            if ohlc:
                aH = float(np.max([x['high'] for x in ohlc]))
                aL = float(np.min([x['low'] for x in ohlc]))
                aM = zm.median
            else:
                aH = aL = aM = 0.0

            # --- Position state ---
            if active_position:
                pos['active'] = True
                pos['entry'] = entry_price
                pos['time'] = last_trade_time
                prof = calc_profit(entry_price, price, token_amount)
            else:
                pos['active'] = False
                prof = 0.0

            # --- ML feature extraction ---
            feat = ml.extract(price, zm, last_trend, ob, pos, ohlc) if ml else None

            # --- STOP LOSS (highest priority) ---
            if active_position:
                sl_price = entry_price * (1 - STOP_LOSS_PCT)
                if price <= sl_price:
                    logging.warning(f"STOP LOSS HIT: ${price:.4f} <= ${sl_price:.4f}")
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        exit_p = price
                        txid = "N/A"
                        try:
                            txid_list = res.get('result', {}).get('txid', [])
                            if isinstance(txid_list, list) and len(txid_list) > 0:
                                txid = txid_list[0]
                        except:
                            pass
                        print_ticket("SELL", "STOP LOSS", exit_p, token_amount,
                                     txid=txid, trade_type="AUTO")
                        if ml and feat is not None:
                            ml.record(feat, entry_price, exit_p, token_amount)
                        active_position = False
                        token_amount = 0.0
                        last_trade_time = time.time()
                        last_trade_type = "STOP LOSS SELL"
                    else:
                        err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                        print_ticket("SELL", "STOP LOSS FAILED", price, token_amount,
                                     error=err, trade_type="AUTO")
                    time.sleep(PRICE_CHECK_INTERVAL)
                    continue

            # --- BUY LOGIC ---
            if not active_position and not trading_paused:
                zone_buy = zm.buy_sig(price)
                if zone_buy:
                    if ml:
                        entry_prob = ml.pred_entry(feat)
                        if entry_prob < ML_CONFIDENCE:
                            logging.info(f"ML blocked buy: prob={entry_prob:.3f} < {ML_CONFIDENCE} | spring={spring_val:.2f}")
                        else:
                            bet = get_kelly_bet(ml)
                            amt, avg_price, slippage = dyn_size(price, 'buy', ob, max_inv=bet)
                            if amt > 0:
                                res = place_order('buy', amt, avg_price)
                                if res and not res.get('error'):
                                    active_position = True
                                    entry_price = avg_price
                                    token_amount = amt
                                    last_trade_time = time.time()
                                    last_trade_type = "AUTO BUY"
                                    txid = "N/A"
                                    try:
                                        txid_list = res.get('result', {}).get('txid', [])
                                        if isinstance(txid_list, list) and len(txid_list) > 0:
                                            txid = txid_list[0]
                                    except:
                                        pass
                                    print_ticket("BUY", "SUCCESS", avg_price, amt,
                                                 txid=txid, trade_type="AUTO")
                                    logging.info(f"ML prob: {entry_prob:.3f} | "
                                                 f"Kelly bet: ${bet:.2f} | "
                                                 f"Slippage: {slippage:.4%} | "
                                                 f"Spring: {spring_val:.2f}")
                                else:
                                    err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                                    print_ticket("BUY", "REJECTED", price, 0.0,
                                                 error=err, trade_type="AUTO")
                            else:
                                logging.info("Insufficient liquidity for buy.")
                    else:
                        amt, avg_price, slippage = dyn_size(price, 'buy', ob)
                        if amt > 0:
                            res = place_order('buy', amt, avg_price)
                            if res and not res.get('error'):
                                active_position = True
                                entry_price = avg_price
                                token_amount = amt
                                last_trade_time = time.time()
                                last_trade_type = "AUTO BUY (no ML)"
                                print_ticket("BUY", "SUCCESS", avg_price, amt,
                                             trade_type="AUTO (no ML)")
                            else:
                                err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                                print_ticket("BUY", "REJECTED", price, 0.0,
                                             error=err, trade_type="AUTO")

            # --- SELL LOGIC (zone exit + ML early exit) ---
            if active_position:
                zone_sell = zm.sell_sig(price)
                current_profit = calc_profit(entry_price, price, token_amount)

                # Primary exit: zone + min profit (the cage)
                if zone_sell and current_profit >= MIN_PROFIT:
                    execute_sell = True

                # Secondary exit: ML early-exit (active after 25+ trades)
                elif ml and ml.trained and len(ml.trades) >= 25 and current_profit > 0:
                    _exit_pred = ml.pred_exit(feat)
                    if _exit_pred < current_profit * 0.4:
                        logging.info(f"ML early exit: pred={_exit_pred:.2f} < "
                                     f"current={current_profit:.2f} * 0.4")
                        execute_sell = True
                    else:
                        execute_sell = False
                else:
                    execute_sell = False

                if execute_sell:
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        exit_p = price
                        txid = "N/A"
                        try:
                            txid_list = res.get('result', {}).get('txid', [])
                            if isinstance(txid_list, list) and len(txid_list) > 0:
                                txid = txid_list[0]
                        except:
                            pass
                        print_ticket("SELL", "SUCCESS", exit_p, token_amount,
                                     txid=txid, trade_type="ZONE/ML EXIT")
                        if ml and feat is not None:
                            ml.record(feat, entry_price, exit_p, token_amount)
                        active_position = False
                        token_amount = 0.0
                        last_trade_time = time.time()
                        last_trade_type = f"EXIT (P&L: {current_profit:+.2f})"
                    else:
                        err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                        print_ticket("SELL", "REJECTED", price, token_amount,
                                     error=err, trade_type="EXIT")

            # --- Dashboard ---
            print_dash(price, zm, last_trend, active_position, token_amount,
                       prof, last_trade_type, entry_price, aH, aL, aM,
                       bb_mid or 0, bb_upper or 0, bb_lower or 0,
                       iqr_q1 or 0, iqr_q3 or 0, iqr_val or 0, spring_val)

            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}\u23f8 PAUSED{RESET} | Commands: "
                  f"{SUB}r{RESET}=resume {SUB}q{RESET}=quit "
                  f"{SUB}b{RESET}=buy {SUB}s{RESET}=sell{RESET}", flush=True)
        except Exception as e:
            logging.error(f"Loop error: {e}", exc_info=True)
            time.sleep(10)


