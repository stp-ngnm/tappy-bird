# ========================== ENTRY POINT ==========================
if __name__ == "__main__":
    import signal
    # REMOVED: signal.signal(signal.SIGINT, lambda s, f: sys.exit(0))
    # This allows Ctrl+C to raise KeyboardInterrupt, which is caught 
    # by the except block in the main loop to trigger the pause state.
    
    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))
    main()