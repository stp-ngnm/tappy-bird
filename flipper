def calculate_iqr_overlay(ohlc, median_price):
    """Calculates the dynamic 'rubber band' trigger lines inside the static zones."""
    if not ohlc or len(ohlc) < 50: return median_price, median_price, 0.0
    closes = np.array([x['close'] for x in ohlc])
    roll_std = np.std(closes[-60:]) if len(closes) >= 60 else np.std(closes)
    q25, q75 = np.percentile(closes[-min(300, len(closes)):], [25, 75])
    iqr = q75 - q25
    vol_factor = max(roll_std, iqr * 0.5)
    if vol_factor == 0: vol_factor = median_price * 0.001 
    buy_trigger = median_price - (vol_factor * IQR_MULTIPLIER_MATH)
    sell_trigger = median_price + (vol_factor * IQR_MULTIPLIER_MATH)
    return buy_trigger, sell_trigger, vol_factor

def hurst_exponent(prices, max_lag=20):
    """Rescaled Range Analysis for Market Regime Classification"""
    n = len(prices)
    if n < max_lag * 2: return 0.5
    lags = np.arange(2, max_lag)
    tau = []
    for lag in lags:
        diff = prices[lag:] - prices[:-lag]
        std_val = np.std(diff)
        tau.append(std_val if std_val > 0 else 1e-9)
    tau = np.array(tau)
    poly = np.polyfit(np.log(lags), np.log(tau), 1)
    return poly[0] * 2.0

def classify_market_regime(h):
    if h > HURST_TREND_THRESHOLD: return "trending"
    elif h < HURST_MEAN_REVERT_THRESHOLD: return "mean_reverting"
    else: return "random_walk"

def calculate_ou_exit_threshold(prices, entry_price):
    """Ornstein-Uhlenbeck Optimal Stopping Threshold"""
    if len(prices) < 20: return MIN_PROFIT, 0.0
    recent = np.array(prices)
    mean = np.mean(recent)
    sigma = np.std(recent)
    if sigma == 0: return MIN_PROFIT, 0.0
    dynamic_target = mean + (OU_K_FACTOR * sigma)
    trailing_stop = mean - (OU_K_FACTOR * 0.6 * sigma)
    target_profit = max(dynamic_target - entry_price, MIN_PROFIT)
    return target_profit, trailing_stop

def kelly_position_size(base_bet, win_rate, avg_win, avg_loss):
    """Fractional Kelly Criterion for Dynamic Position Sizing"""
    if avg_loss == 0 or win_rate == 0: return base_bet
    b = avg_win / avg_loss
    p = win_rate; q = 1 - p
    kelly_f = (b * p - q) / b
    safe_f = min(max(kelly_f * KELLY_FRACTION, 0.01), MAX_KELLY_INCREASE_PCT)
    return base_bet * (1 + safe_f)

