    pc = PROF_P if prof >= 0 else PROF_N
    spent = ep * amt if act else 0.00

    bb_pos = "N/A"
    if bb_upper and bb_lower and bb_upper != bb_lower:
        raw_pos = (price - bb_lower) / (bb_upper - bb_lower)
        bb_pos = f"{raw_pos:.2f}" + (" \u2191" if raw_pos > 1 else " \u2193" if raw_pos < 0 else "")

    iqr_pos = "N/A"
