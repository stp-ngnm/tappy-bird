    return None

def kraken_req(path, data):
    h = {'API-Key': API_KEY}
    sec = API_SECRET.strip().replace('\n', '').replace(' ', '')
    if len(sec) % 4:
        sec += '=' * (4 - len(sec) % 4)
    
    for a in range(3):
        try:
            n = str(int(time.time() * 1000))
            data['nonce'] = n
            msg = path.encode() + hashlib.sha256((n + urllib.parse.urlencode(data)).encode()).digest()
            h['API-Sign'] = base64.b64encode(
                hmac.new(base64.b64decode(sec), msg, hashlib.sha512).digest()
            ).decode()
            
            r = requests.post(API_URL + path, data=data, headers=h, timeout=10)
            if r.status_code == 429:
                time.sleep(min(60, 2 ** a + 1))
                continue
            return r.json()
        except Exception:
            time.sleep(2 ** a)
    return {'error': ['Max retries']}

def place_order(otype, amt, price, ot='market', p2=None):
    if price < 1.0:
        amt = round(amt, 4)
    else:
        amt = round(amt, BOND_DECIMALS)
    d = {'ordertype': ot, 'type': otype, 'volume': str(amt),
         'pair': KRAKEN_PAIR, 'validate': 'false'}
    if ot == 'limit':
        d['price'] = str(round(price, 8))
    elif ot == 'stop-loss-limit':
        d['price'] = str(round(price, 8))
        d['price2'] = str(round(p2, 8))
    return kraken_req(f'/{API_VERSION}/private/AddOrder', d)

def calc_profit(entry, exit_p, amt):
    if entry and exit_p and amt:
        return (amt * exit_p * (1 - FEE_RATE)) - (amt * entry * (1 + FEE_RATE))
    return 0.0

def calc_macd(ohlc, f=MACD_FAST, s=MACD_SLOW, sig=MACD_SIGNAL):
    if len(ohlc) < s + sig:
        return None, None, None
    c = [x['close'] for x in ohlc]
    def ema(d, sp):
        a = 2 / (sp + 1)
        v = [d[0]]
        for val in d[1:]:
            v.append(a * val + (1 - a) * v[-1])
        return v
    ml = [x - y for x, y in zip(ema(c, f), ema(c, s))]
    sl = ema(ml, sig)
    return ml[-1], sl[-1], ml[-1] - sl[-1]

def simulate_fill(side, amt, ob):
    if not ob:
        return False, None, None, 0
    levels = ob['asks'] if side == 'buy' else ob['bids']
    cum, used, cons = 0.0, 0.0, 0
    for p, a in levels:
        take = min(a, amt - cum)
        used += take * p
        cum += take
        cons += 1
        if cum >= amt - 1e-12:
            break
    if cum >= amt - 1e-12:
        return (True, used / amt if cum > 0 else 0, used, cons)
    return (False, None, None, cons)

def dyn_size(price, side, ob, max_inv=BASE_INVESTMENT):
    if not ob:
        return 0, None, None
    levels = ob['asks'] if side == 'buy' else ob['bids']
    total = sum(v for _, v in levels)
    if total == 0:
        return 0, None, None
    tgt = max_inv / price
    low, high = 0.0, min(tgt, total)
    best, bp, bs = 0.0, price, 0.0
    for _ in range(20):
        mid = (low + high) / 2
        if mid < 1e-12:
            break
        f, ep, _, _ = simulate_fill(side, mid, ob)
        if f:
            sl = abs(ep - price) / price
            if sl <= MAX_SLIPPAGE_PCT:
                best, bp, bs = mid, ep, sl
                low = mid
            else:
                high = mid
        else:
            high = mid
    if best * bp >= MIN_ORDER_USD:
        rounded = round(best, 4) if bp < 1.0 else round(best, BOND_DECIMALS)
        if rounded > 0:
            return (rounded, bp, bs)
    return (0, None, None)

# ========================== MARKET INDICATORS ==========================
def calc_bollinger(ohlc, period=BOLLINGER_PERIOD, num_std=BOLLINGER_STD):
    if not ohlc or len(ohlc) < period:
        return None, None, None
    closes = np.array([x['close'] for x in ohlc[-period:]])
    mid = np.mean(closes)
    std = np.std(closes)
    return mid, mid + num_std * std, mid - num_std * std

def calc_iqr(ohlc, lookback=IQR_ML_LOOKBACK):
    if not ohlc or len(ohlc) < lookback:
        return None, None, None
    closes = np.array([x['close'] for x in ohlc[-lookback:]])
    q1 = np.percentile(closes, 25)
    q3 = np.percentile(closes, 75)
    return q1, q3, q3 - q1

def calc_spring_trap(ohlc, price):
    if not ohlc or len(ohlc) < SPRING_LOOKBACK:
        return 0.5
    scores = []
    _, _, bb_lower = calc_bollinger(ohlc)
    if bb_lower is not None and bb_lower > 0:
        compression = max(0.0, min(1.0, 1.0 - (price - bb_lower) / (bb_lower * 0.02 + 1e-8)))
        scores.append(compression)
    if len(ohlc) >= SPRING_MOMENTUM_WINDOW + 1:
        recent = np.array([x['close'] for x in ohlc[-SPRING_MOMENTUM_WINDOW - 1:]])
        mom = (recent[-1] - recent[0]) / recent[0]
        momentum_score = min(1.0, abs(mom) / 0.005) if mom < 0 else 0.0
        scores.append(momentum_score)
    if len(ohlc) >= SPRING_VOLUME_WINDOW:
        vols = np.array([x['volume'] for x in ohlc[-SPRING_VOLUME_WINDOW:]])
        if np.mean(vols) > 0:
            half = len(vols) // 2
            vol_trend = (np.mean(vols[half:]) - np.mean(vols[:half])) / (np.mean(vols) + 1e-8)
            volume_score = min(1.0, abs(vol_trend)) if vol_trend < 0 else 0.0
            scores.append(volume_score)
    if not scores:
        return 0.5
    weights = [0.4, 0.35, 0.25][:len(scores)]
    spring_tension = sum(s * w for s, w in zip(scores, weights))
    return max(0.0, min(1.0, spring_tension))

# ========================== FEATURE CALCULATION LAYER ==========================
def calculate_all_features(price, zm, trend, ob, pos, ohlc):
    features = {}
    
    # --- Momentum & Volume Features ---
    if ohlc and len(ohlc) >= 10:
        closes = [x['close'] for x in ohlc]
        features['mom5'] = (closes[-1] - closes[-5]) / (closes[-5] + 1e-8)
        features['mom10'] = (closes[-1] - closes[-10]) / (closes[-10] + 1e-8)
        
        # FIX: Volume trend bug - correctly slice last 20 candles and use dynamic half
        if len(ohlc) >= 20:
            vols = np.array([x['volume'] for x in ohlc[-20:]])
            half = len(vols) // 2
            features['volTrend'] = (np.mean(vols[half:]) - np.mean(vols[:half])) / (np.mean(vols) + 1e-8)
            features['vol'] = float(vols[-1])
        else:
            features['volTrend'] = 0.0
            features['vol'] = float(ohlc[-1]['volume'])
    else:
        features['mom5'] = 0.0
        features['mom10'] = 0.0
        features['vol'] = 0.0
        features['volTrend'] = 0.0

    # --- Zone Features ---
    zone = zm.zone(price) if zm else 'OUTSIDE'
    features['zBuy'] = 1.0 if zone == 'BUY' else 0.0
    features['zSell'] = 1.0 if zone == 'SELL' else 0.0
    features['zNeu'] = 1.0 if zone == 'NEUTRAL' else 0.0
    
    if zone == 'BUY' and zm and zm.buy_zone:
        features['zDep'] = abs(price - zm.buy_zone[1]) / price if price > 0 else 0.0
    elif zone == 'SELL' and zm and zm.sell_zone:
        features['zDep'] = abs(price - zm.sell_zone[0]) / price if price > 0 else 0.0
    else:
        features['zDep'] = 0.0

    # --- Trend Features ---
    features['tUp'] = 1.0 if trend == "UP" else 0.0
    features['tDn'] = 1.0 if trend == "DOWN" else 0.0

    # --- Order Book Features ---
    if ob:
        bids = ob.get('bids', [])[:20]
        asks = ob.get('asks', [])[:20]
        if bids and asks:
            features['sprd'] = (asks[0][0] - bids[0][0]) / price if price > 0 else 0.0
            bid_vol = sum(v for _, v in bids)
            ask_vol = sum(v for _, v in asks)
            features['imb'] = (bid_vol - ask_vol) / (bid_vol + ask_vol + 1e-8)
            features['liq'] = (bid_vol + ask_vol) * price / 1000.0
        else:
            features['sprd'] = 0.0
            features['imb'] = 0.0
            features['liq'] = 0.0
    else:
        features['sprd'] = 0.0
        features['imb'] = 0.0
        features['liq'] = 0.0

    # --- Position Features ---
    if pos.get('active'):
        features['pnl'] = calc_profit(pos['entry'], price, pos['amt']) if pos.get('amt') else 0.0
        features['hold'] = (time.time() - pos['time']) / 3600.0 if pos.get('time') else 0.0
    else:
        features['pnl'] = 0.0
        features['hold'] = 0.0

    # --- Spring Trap Feature ---
    features['spring'] = calc_spring_trap(ohlc, price)

    return features

# ========================== LOGIC-FIRST FILTERS ==========================
def pre_ml_filters(features, price, zm, ob, pos, ml=None):
    """Returns (should_buy, should_sell, confidence/reason)"""
    
    # --- 1. Volume Filter (USD terms) ---
    if features['volTrend'] < -0.5 and (features['vol'] * price) < 1000:
        return False, False, "Low volume (USD) + declining"

    # --- 2. Zone + Momentum Alignment ---
    if features['zBuy'] == 1.0 and features['mom5'] < -0.001:
        return False, False, "Buy zone but negative momentum"

    if features['zSell'] == 1.0 and features['mom5'] > 0.001:
        return False, False, "Sell zone but positive momentum"

    # --- 3. Spring Trap Protection ---
    if features['spring'] > 0.7 and features['zBuy'] == 1.0:
        return False, False, "Spring trap in buy zone"

    # --- 4. Order Book Liquidity Check ---
    if features['liq'] < 50.0 and features['sprd'] > 0.005:
        return False, False, "Thin book + wide spread"

    # --- 5. Trend Confirmation ---
    if features['tUp'] == 1.0 and features['mom10'] < -0.002:
        return False, False, "MACD up but 10-candle momentum down"

    # --- 6. Position Holding Logic (Soft Exits) ---
    if pos.get('active'):
        entry_val = pos.get('entry', 0) * pos.get('amt', 0)
        
        # ML Early Stop Loss (wired in)
        if ml and ml.check_ml_stop_loss(pos['entry'], price, features['pnl']):
            return False, True, "ML Early Stop Loss"
            
        # Spring + volume decline = exit
        if features['spring'] > 0.8 and features['volTrend'] < -0.3:
            return False, True, "Spring + volume decline = exit"
        
        # Take profit if momentum stalls (5% of entry value)
        if features['mom5'] < 0 and features['pnl'] > 0.05 * entry_val:
            return False, True, "Take Profit (5%) + Momentum Stall"

    # --- 7. Zone Entry Confirmation ---
    # FIX: Method name mismatch resolved (using buy_sig consistently)
    if zm and zm.buy_sig(price):
        buy_confidence = 0.0
        # FIX: Momentum scaling bug - cap the multiplier to prevent broken confidence weights
        # mom5 is a ratio (e.g., 0.01 for 1%). 0.01 * 50 = 0.5. Capped at 1.0.
        buy_confidence += max(0.0, min(1.0, features['mom5'] * 50.0)) * 0.3
        buy_confidence += (1 - features['spring']) * 0.4
        buy_confidence += max(0.0, min(1.0, features['volTrend'] + 0.5)) * 0.2
        buy_confidence += max(0.0, min(1.0, features['imb'] + 0.5)) * 0.1

        if buy_confidence > 0.5:
            return True, False, f"Zone buy + confidence {buy_confidence:.2f}"

    return False, False, "No signal"

# ========================== ML VALIDATION LAYER ==========================
def trade_decision(features, price, zm, ob, pos, ml):
    # --- STEP 1: Logic-First Decision ---
    should_buy, should_sell, logic_reason = pre_ml_filters(features, price, zm, ob, pos, ml)

    # --- STEP 2: ML Validation (if enabled) ---
    if ml and ml.trained:
        entry_prob = ml.pred_entry(features)
        exit_pred = ml.pred_exit(features)

        # ML can VETO buy
        if should_buy and entry_prob < ML_CONFIDENCE:
            logging.info(f"ML VETO: Buy blocked (prob={entry_prob:.3f} < {ML_CONFIDENCE})")
            should_buy = False

        # ML can VETO sell (if model predicts final PnL will be significantly better than current PnL)
        if should_sell and exit_pred is not None:
            current_profit = features.get('pnl', 0.0)
            if exit_pred > current_profit:
                logging.info(f"ML VETO: Sell blocked (exit_pred={exit_pred:.2f} > current_profit={current_profit:.2f})")
                should_sell = False
            elif exit_pred < current_profit * 0.5:
                logging.info(f"ML BOOST: Sell encouraged (exit_pred={exit_pred:.2f} < current_profit={current_profit:.2f} * 0.5)")

    return should_buy, should_sell, logic_reason

# ========================== KELLY SIZING ==========================
def get_kelly_bet(ml):
    if not USE_KELLY_SIZING:
        return BASE_INVESTMENT
    if not ml or len(ml.trades) < KELLY_LOOKBACK_TRADES:
        return BASE_INVESTMENT
    recent = list(ml.trades)[-KELLY_LOOKBACK_TRADES:]
    wins = [t['p'] for t in recent if t['l'] == 1]
    losses = [t['p'] for t in recent if t['l'] == 0]
    if not wins or not losses:
        return BASE_INVESTMENT
    win_rate = len(wins) / len(recent)
    avg_win = np.mean(wins)
    avg_loss = abs(np.mean(losses))
    if avg_loss == 0:
        return BASE_INVESTMENT
    b = avg_win / avg_loss
    p, q = win_rate, 1 - win_rate
    kelly_f = (b * p - q) / b
    safe_f = max(KELLY_MIN_REDUCE_PCT, min(kelly_f * 0.5, MAX_KELLY_INCREASE_PCT))
    bet_size = BASE_INVESTMENT * (1 + safe_f)
    if bet_size < MIN_ORDER_USD:
        logging.info(f"KELLY BLOCKED: Bet size ${bet_size:.2f} < ${MIN_ORDER_USD:.2f} minimum")
        return 0
    return bet_size

# ========================== ML ADVISOR ==========================
class MLAdvisor:
    def __init__(self):
        self.entry_model = None
        self.exit_model = None
        self.scaler = RobustScaler()
        self.hist = deque(maxlen=100)
        self.trades = []
        self.trained = False
        self.fnames = ['mom5', 'mom10', 'vol', 'zBuy', 'zSell', 'zNeu', 'zDep',
                       'tUp', 'tDn', 'sprd', 'imb', 'liq', 'pnl', 'hold',
                       'spring', 'volTrend']
        self._load()

    def _vec(self, f):
        return np.array([[f.get(name, 0.0) for name in self.fnames]])

    def pred_entry(self, f):
        if not self.trained or self.entry_model is None:
            return 0.5
        try:
            vec_scaled = self.scaler.transform(self._vec(f))
            prob = self.entry_model.predict_proba(vec_scaled)[0][1]
            return float(prob)
        except Exception as e:
            logging.error(f"ML entry prediction failed: {e}")
            return 0.5

    def pred_exit(self, f):
        if not self.trained or self.exit_model is None:
            return None
        try:
            vec_scaled = self.scaler.transform(self._vec(f))
            prediction = self.exit_model.predict(vec_scaled)[0]
            return float(prediction)
        except Exception as e:
            logging.error(f"ML exit prediction failed: {e}")
            self.trained = False
            return None

    def check_ml_stop_loss(self, entry_price, current_price, current_profit):
        if not self.trained or len(self.trades) < ML_MIN_SAMPLES:
            return False
        if entry_price == 0:
            return False
        loss_pct = (entry_price - current_price) / entry_price
        if 0.02 <= loss_pct <= 0.13:
            if len(self.hist) > 0:
                last_features = self.hist[-1]
                spring_tension = last_features.get('spring', 0.5)
                vol_trend = last_features.get('volTrend', 0.0)
                if spring_tension > 0.7 and current_profit < 0:
                    return True
                if vol_trend < -0.5 and current_profit < 0:
                    return True
        return False

    def record(self, ef, ep, xp, amt):
        p = calc_profit(ep, xp, amt)
        self.trades.append({'f': ef.copy(), 'p': p, 'l': 1 if p >= MIN_PROFIT else 0})
        if len(self.trades) > ML_MAX_SAMPLES:
            self.trades = self.trades[-ML_MAX_SAMPLES:]
        
        if len(self.trades) % ML_RETRAIN == 0 or len(self.trades) == ML_MIN_SAMPLES:
            with open("ml_trade_samples.log", "a") as f:
                f.write(f"{time.time()},{p},{1 if p >= MIN_PROFIT else 0},{json.dumps(ef)}\n")
        
        if len(self.trades) >= ML_MIN_SAMPLES and len(self.trades) % ML_RETRAIN == 0:
            self._train()

    def _train(self):
        if len(self.trades) < ML_MIN_SAMPLES:
            return
        
        X = np.array([self._vec(t['f'])[0] for t in self.trades])
        y_entry = np.array([t['l'] for t in self.trades])
        y_exit = np.array([t['p'] for t in self.trades])
        
        X_scaled = self.scaler.fit_transform(X)
        
        self.entry_model = HistGradientBoostingClassifier(max_iter=100, max_leaf_nodes=16, random_state=42)
        self.entry_model.fit(X_scaled, y_entry)
        
        self.exit_model = GradientBoostingRegressor(n_estimators=100, max_depth=4, random_state=42)
        self.exit_model.fit(X_scaled, y_exit)
        
        self.trained = True
        logging.info(f"ML models trained on {len(self.trades)} samples.")
        
        try:
            os.makedirs(ML_PATH, exist_ok=True)
            joblib.dump(self.entry_model, os.path.join(ML_PATH, 'entry_model.pkl'))
            joblib.dump(self.exit_model, os.path.join(ML_PATH, 'exit_model.pkl'))
            joblib.dump(self.scaler, os.path.join(ML_PATH, 'scaler.pkl'))
        except Exception as e:
            logging.error(f"Failed to save ML models: {e}")

    def _load(self):
        try:
            if os.path.exists(os.path.join(ML_PATH, 'entry_model.pkl')):
                self.entry_model = joblib.load(os.path.join(ML_PATH, 'entry_model.pkl'))
                self.exit_model = joblib.load(os.path.join(ML_PATH, 'exit_model.pkl'))
                self.scaler = joblib.load(os.path.join(ML_PATH, 'scaler.pkl'))
                self.trained = True
                logging.info("Loaded existing ML models.")
        except Exception as e:
            logging.warning(f"Could not load ML models: {e}")

# ========================== ZONE MACHINE (STATIC CAGE) ==========================
class ZoneMachine:
    def __init__(self):
        self.buy_zone = None
        self.sell_zone = None
        self.neutral_zone = None
        self.median = 0.0
        self.last_rebuild_time = 0
        # FIX: Method name mismatch resolved, keeping buy_sig/sell_sig as canonical names
        self.buy_prices = deque(maxlen=250)
        self.sell_prices = deque(maxlen=250)
        self.neutral_prices = deque(maxlen=250)

    def init(self, ohlc):
        if not ohlc or len(ohlc) < 10:
            return False
        closes = [x['close'] for x in ohlc]
        self.median = np.median(closes)
        self.neutral_zone = (self.median - ZONE_BUFFER, self.median + ZONE_BUFFER)
        self.buy_zone = (self.median - ZONE_BUFFER - BUY_ZONE_EXTRA, self.median - ZONE_BUFFER)
        self.sell_zone = (self.median + ZONE_BUFFER, self.median + ZONE_BUFFER + SELL_ZONE_EXTRA)
        self.last_rebuild_time = time.time()
        return True

    def zone(self, price):
        if self.buy_zone and self.buy_zone[0] <= price <= self.buy_zone[1]:
            return 'BUY'
        elif self.sell_zone and self.sell_zone[0] <= price <= self.sell_zone[1]:
            return 'SELL'
        elif self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]:
            return 'NEUTRAL'
        else:
            return 'OUTSIDE'

    def buy_sig(self, price):
        z = self.zone(price)
        if z == 'BUY':
            self.buy_prices.append(price)
            avg_price = np.mean(self.buy_prices) if self.buy_prices else self.median
            if abs(price - avg_price) / avg_price <= ENTRY_RANGE_PCT:
                return True
        return False

    def sell_sig(self, price):
        z = self.zone(price)
        if z == 'SELL':
            self.sell_prices.append(price)
            avg_price = np.mean(self.sell_prices) if self.sell_prices else self.median
            if abs(price - avg_price) / avg_price <= ENTRY_RANGE_PCT:
                return True
        return False

    def check_redefinition(self, price, ohlc):
        z = self.zone(price)
        if z == 'OUTSIDE' and time.time() - self.last_rebuild_time > ZONE_OUTSIDE_TIMEOUT:
            return True
        if ohlc and len(ohlc) >= 60:
            recent_closes = [x['close'] for x in ohlc[-20:]]
            older_closes = [x['close'] for x in ohlc[-60:-20]]
            recent_med = np.median(recent_closes)
            older_med = np.median(older_closes)
            if older_med != 0:
                shift_pct = abs(recent_med - older_med) / older_med
                if shift_pct > AVG_SHIFT_PCT:
                    return True
        return False

