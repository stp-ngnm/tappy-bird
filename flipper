# ========================== LOGIC-ONLY BACKTESTER ==========================
def run_strategy_backtest(pair: str, total_candles: int = BACKTEST_CANDLES) -> None:
    logging.info(f"Backtesting {pair} over {total_candles} candles...")
    history = fetch_ohlc_history(pair, total_candles, interval=1)
    if len(history) < MEDIAN_LOOKBACK + 50: logging.error(f"Insufficient history: {len(history)} candles."); return
    zm = ZoneMachine()
    if not zm.init(history[:MEDIAN_LOOKBACK]): logging.error("Backtest zone init failed."); return
    
    active = False; entry = amt = highest = entry_ts = last_signal_ts = 0.0
    realized = 0.0; peak_equity = 0.0; max_drawdown = 0.0; trades = []; equity_curve = []
    
    for i in range(MEDIAN_LOOKBACK, len(history)):
        window = history[i - MEDIAN_LOOKBACK:i + 1]; candle = window[-1]; price = candle['close']; ts = candle['timestamp']
        if zm.check_redefinition(price, window): zm.init(window)
        m, s, _ = calc_macd(window)
        trend = "UP" if m is not None and s is not None and m > s else ("DOWN" if m is not None and s is not None else "UNKNOWN")
        pos = {'active': active, 'entry': entry, 'time': entry_ts, 'amt': amt}
        fake_ob = {'bids': [(price * 0.999, 100000.0)], 'asks': [(price * 1.001, 100000.0)]}
        feat = calculate_all_features(price, zm, trend, fake_ob, pos, window)
        
        if active:
            highest = max(highest, price)
            slippage_factor = np.random.normal(0, MAX_SLIPPAGE_PCT / 2); fill_price = price * (1 - slippage_factor)
            pnl = calc_profit(entry, fill_price, amt)
            forced = None
            if ts - entry_ts > MAX_HOLD_TIME_SEC: forced = "MAX_HOLD"
            elif amt * fill_price < MIN_ORDER_USD: forced = "DUST"
            elif fill_price <= highest * (1 - TRAILING_STOP_PCT): forced = "TRAILING_STOP"
            elif fill_price >= entry * (1 + TAKE_PROFIT_PCT): forced = "TAKE_PROFIT"
            if forced:
                realized += pnl; trades.append({'pnl': pnl, 'reason': forced, 'ts': ts})
                active = False; amt = 0.0; highest = 0.0; last_signal_ts = ts
        else:
            should_buy, should_sell, reason = pre_ml_filters(feat, price, zm, fake_ob, pos, None)
            if not active:
                if ts - last_signal_ts < AUTO_COOLDOWN_SEC: should_buy = False
            if should_sell and active:
                realized += pnl; trades.append({'pnl': pnl, 'reason': reason, 'ts': ts})
                active = False; amt = 0.0; highest = 0.0; last_signal_ts = ts
            elif should_buy and not active:
                slippage_factor = np.random.normal(0, MAX_SLIPPAGE_PCT / 2); fill_price = price * (1 + slippage_factor)
                size = round(BASE_INVESTMENT / fill_price, 4 if fill_price < 1.0 else BOND_DECIMALS)
                if size * fill_price >= MIN_ORDER_USD:
                    active = True; entry = fill_price; amt = size; highest = fill_price; entry_ts = ts; last_signal_ts = ts
                    
        equity = realized + (calc_profit(entry, price, amt) if active else 0.0)
        equity_curve.append({'ts': ts, 'equity': equity})
        peak_equity = max(peak_equity, equity)
        if peak_equity > 0:
            current_dd = (peak_equity - equity) / peak_equity; max_drawdown = max(max_drawdown, current_dd)
            if max_drawdown > 0.50: logging.warning("Max drawdown limit (50%) reached. Stopping backtest early."); break

    if active:
        slippage_factor = np.random.normal(0, MAX_SLIPPAGE_PCT / 2); fill_price = history[-1]['close'] * (1 - slippage_factor)
        final_pnl = calc_profit(entry, fill_price, amt); realized += final_pnl
        trades.append({'pnl': final_pnl, 'reason': "END_OF_BACKTEST", 'ts': history[-1]['timestamp']})
        
    wins = [t for t in trades if t['pnl'] > 0]
    logging.info("=" * 50); logging.info(f"BACKTEST RESULT: {pair}")
    logging.info(f"Candles: {len(history)} | Trades: {len(trades)} | Wins: {len(wins)}")
    logging.info(f"Win rate: {len(wins) / len(trades) * 100:.1f}%" if trades else "Win rate: N/A")
    logging.info(f"Net PnL (after fees & slippage): ${realized:+.2f}"); logging.info(f"Max drawdown: {max_drawdown*100:.2f}%")
    logging.info("NOTE: Logic-only with fake OB and slippage simulation. No ML veto."); logging.info("=" * 50)
    with open("backtest_results.json", "w") as f:
        json.dump({'pair': pair, 'candles': len(history), 'trades': trades, 'net_pnl': realized, 'max_drawdown': max_drawdown, 'equity_curve': equity_curve}, f, indent=2)

# ========================== MAIN LOOP ==========================
def main() -> None:
    global active_position, entry_price, token_amount, last_trade_time, last_trend, last_trade_type, trading_paused, KRAKEN_PAIR, consecutive_failures, highest_price_since_entry, last_ohlc, last_ohlc_time
    
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR); logging.info(f"Validated pair: {KRAKEN_PAIR}")
    zm = ZoneMachine(); ml = MLAdvisor() if ML_ENABLED else None
    pos = {'active': False, 'entry': 0.0, 'time': 0.0, 'amt': 0.0}
    ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
    if not zm.init(ohlc):
        logging.error("Could not initialize zones. Retrying in 30s..."); time.sleep(30)
        ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
        if not zm.init(ohlc): logging.critical("Zone init failed after retry. Exiting."); sys.exit(1)
    logging.info(f"Zones initialized. Median: ${zm.median:.4f}")
    print(f"\n{BORDER}🚀 Bot Started. Monitoring {KRAKEN_PAIR}...{RESET}")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}\n", flush=True)
    time.sleep(PRICE_CHECK_INTERVAL)
    
    while True:
        try:
            if consecutive_failures >= MAX_CONSECUTIVE_FAILURES:
                print_ticket("API", "CIRCUIT BREAK", 0, 0, error=f"API failed {consecutive_failures}x. Trading paused.", trade_type="SYSTEM")
                trading_paused = True; consecutive_failures = 0; continue
            if trading_paused:
                try: cmd = input(f"\n{BORDER}⏸ [PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt): continue
                if cmd == 'r': trading_paused = False; print(f"{PROF_P}▶ RESUMED{RESET}", flush=True)
                elif cmd == 'q':
                    if active_position: logging.warning(f"Position still active! Entry: ${entry_price:.4f} | Amt: {token_amount:.8f}")
                    print("\n👋 Exiting...", flush=True); sys.exit(0)
                elif cmd in ('b', 's'): execute_manual(cmd)
                else: print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}", flush=True)
                continue
            if time.time() - last_trade_time < AUTO_COOLDOWN_SEC and last_trade_type != "NONE": time.sleep(PRICE_CHECK_INTERVAL); continue
            
            tick_failed = False; price = get_ticker()
            if not price: tick_failed = True
            if not tick_failed:
                now = time.time()
                if last_ohlc is None or (now - last_ohlc_time) > 60:
                    ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
                    if not ohlc: tick_failed = True
                    else: last_ohlc = ohlc; last_ohlc_time = now; ohlc = last_ohlc
                ob = get_order_book(KRAKEN_PAIR)
                if not ob: tick_failed = True
                
            if tick_failed:
                consecutive_failures += 1
                if consecutive_failures >= MAX_CONSECUTIVE_FAILURES:
                    print_ticket("API", "CIRCUIT BREAK", 0, 0, error=f"API failed {consecutive_failures}x. Trading paused.", trade_type="SYSTEM")
                    trading_paused = True; consecutive_failures = 0
                time.sleep(5); continue
                
            consecutive_failures = 0; price = round(price, 4)
            macd_line, signal_line, _ = calc_macd(ohlc)
            last_trend = "UP" if macd_line is not None and signal_line is not None and macd_line > signal_line else ("DOWN" if macd_line is not None and signal_line is not None else "UNKNOWN")
            bb_mid, bb_upper, bb_lower = calc_bollinger(ohlc); iqr_q1, iqr_q3, iqr_val = calc_iqr(ohlc, IQR_ML_LOOKBACK)
            
            if ohlc and len(ohlc) >= 10 and zm.check_redefinition(price, ohlc): logging.info("🔄 Zones redefined (median shift or >3min outside)."); zm.init(ohlc)
            aH = float(np.max([x['high'] for x in ohlc])) if ohlc else 0.0; aL = float(np.min([x['low'] for x in ohlc])) if ohlc else 0.0; aM = zm.median
            
            if active_position: pos.update({'active': True, 'entry': entry_price, 'time': last_trade_time, 'amt': token_amount})
            else: pos.update({'active': False, 'amt': 0.0})
            features = calculate_all_features(price, zm, last_trend, ob, pos, ohlc)
            if ml: ml.hist.append(features)
            
            if active_position:
                highest_price_since_entry = max(highest_price_since_entry, price); now = time.time(); forced_reason = None
                if now - last_trade_time > MAX_HOLD_TIME_SEC: forced_reason = "MAX HOLD TIME"
                elif token_amount * price < MIN_ORDER_USD: forced_reason = "DUST CLEAR"
                elif price <= highest_price_since_entry * (1 - TRAILING_STOP_PCT): forced_reason = "TRAILING STOP"
                elif price >= entry_price * (1 + TAKE_PROFIT_PCT): forced_reason = "TAKE PROFIT CEILING"
                if forced_reason:
                    logging.warning(f"{forced_reason} HIT at ${price:.4f}")
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("SELL", forced_reason, price, token_amount, txid=txid, trade_type="AUTO")
                        if ml: ml.record(features, entry_price, price, token_amount)
                        active_position = False; token_amount = 0.0; highest_price_since_entry = 0.0; last_trade_time = now; last_trade_type = "AUTO SELL"; save_state()
                    time.sleep(PRICE_CHECK_INTERVAL); continue
                    
            should_buy, should_sell, reason = trade_decision(features, price, zm, ob, pos, ml)
            if should_sell and active_position:
                logging.info(f"Executing SELL ({reason})")
                res = place_order('sell', token_amount, price, ot='market')
                if res and not res.get('error'):
                    txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                    print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")
                    if ml: ml.record(features, entry_price, price, token_amount)
                    active_position = False; token_amount = 0.0; highest_price_since_entry = 0.0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"; save_state()
                else:
                    err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                    print_ticket("SELL", "FAILED", price, token_amount, error=err, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL); continue
                
            if should_buy and not active_position and not trading_paused:
                bet = get_kelly_bet(ml)
                if bet == 0: time.sleep(PRICE_CHECK_INTERVAL); continue
                amt, avg_price, slippage = dyn_size(price, 'buy', ob, max_inv=bet)
                if amt > 0:
                    res = place_order('buy', amt, avg_price)
                    if res and not res.get('error'):
                        active_position = True; entry_price = avg_price; token_amount = amt; highest_price_since_entry = avg_price; last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("BUY", "SUCCESS", avg_price, amt, txid=txid, trade_type="AUTO")
                        logging.info(f"Kelly bet: ${bet:.2f} | Slippage: {slippage:.4%} | Spring: {features['spring']:.2f}"); save_state()
                    else:
                        err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                        print_ticket("BUY", "REJECTED", price, 0.0, error=err, trade_type="AUTO")
                        
            print_dash(price, zm, last_trend, active_position, token_amount, calc_profit(entry_price, price, token_amount) if active_position else 0.0, last_trade_type, entry_price, aH, aL, aM, bb_mid or 0, bb_upper or 0, bb_lower or 0, iqr_q1 or 0, iqr_q3 or 0, iqr_val or 0, features['spring'])
            time.sleep(PRICE_CHECK_INTERVAL)
        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume {SUB}q{RESET}=quit {SUB}b{RESET}=buy {SUB}s{RESET}=sell{RESET}", flush=True)
        except Exception as e: logging.error(f"Loop error: {e}", exc_info=True); time.sleep(10)

