def get_ohlc(pair: str, interval: int, lookback: int) -> List[Dict]:
    rate_limit()
    for attempt in range(3):
        try:
            r = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC", params={'pair': pair, 'interval': interval}, timeout=10)
            if r.status_code == 429: time.sleep(3 * (attempt + 1)); continue
            data = r.json()
            if 'error' in data and data['error']: return []
            pk = list(data['result'].keys())[0]
            candles = [{'timestamp': float(x[0]), 'high': float(x[2]), 'low': float(x[3]), 'close': float(x[4]), 'volume': float(x[5])} for x in data['result'][pk]]
            return candles[-lookback:] if len(candles) > lookback else candles
        except Exception: time.sleep(2)
    return []

def fetch_ohlc_history(pair: str, total_candles: int, interval: int = 1) -> List[Dict]:
    collected = {}
    since = int(time.time()) - total_candles * interval * 60
    max_pages = (total_candles // 720) + 3
    for _ in range(max_pages):
        try:
            rate_limit()
            params = {'pair': pair, 'interval': interval, 'since': since}
            r = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC", params=params, timeout=15)
            if r.status_code == 429: time.sleep(5); continue
            data = r.json()
            if 'error' in data and data['error']: break
            pk = list(data['result'].keys())[0]
            batch = data['result'][pk]
            if not batch: break
            for x in batch: collected[float(x[0])] = {'timestamp': float(x[0]), 'high': float(x[2]), 'low': float(x[3]), 'close': float(x[4]), 'volume': float(x[5])}
            last_ts = float(batch[-1][0])
            since = int(last_ts + interval * 60)
            if len(batch) < 2: break
        except Exception as e: logging.error(f"History fetch error: {e}"); break
        time.sleep(0.5)
    ordered = [collected[k] for k in sorted(collected)]
    return ordered[-total_candles:]

