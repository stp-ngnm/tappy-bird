            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt): continue
                if cmd == 'r': trading_paused = False; print(f"{PROF_P}▶️ RESUMED{RESET}"); continue
                elif cmd == 'q': print("👋 Exiting..."); sys.exit(0)
                elif cmd in ('b', 's'): execute_manual(cmd); continue
                else: print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}"); continue

            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 6)
            price_deque.append(price)

            # 1. Fetch 5-Hour OHLC (Drives Dashboard & Math Engines)
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 50:
                # ✅ TRUE RANGE: Max/Min of the 5-hour window for Dashboard
                aH = np.max([x['high'] for x in ohlc])
                aL = np.min([x['low'] for x in ohlc])
                aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2)
                if not zm.buy_zone: zm.init(ohlc)
                
                closes = np.array([x['close'] for x in ohlc])
                hurst_val = hurst_exponent(closes[-HURST_LOOKBACK:]) if USE_HURST_GATE else 0.5
                regime = classify_market_regime(hurst_val)
                last_trend = "up" if price > aM else "down"
            else:
                aH = aL = aM = 0.0; hurst_val = 0.5; regime = "random_walk"

            # 2. Stop Loss (Overrides All Math)
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                res = place_order('sell', token_amount, price, ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                if res and not res.get('error'):
                    trade_history.append({'profit': calc_profit(entry_price, price, token_amount)})
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # 3. Math Engine: Kelly Sizing
            current_investment = BASE_INVESTMENT
            if USE_KELLY_SIZING and len(trade_history) >= KELLY_LOOKBACK_TRADES:
                recent_trades = trade_history[-KELLY_LOOKBACK_TRADES:]
                win_rate = len([t for t in recent_trades if t['profit'] > 0]) / len(recent_trades)
                avg_win = np.mean([t['profit'] for t in recent_trades if t['profit'] > 0]) if win_rate > 0 else 0.15
                avg_loss = abs(np.mean([t['profit'] for t in recent_trades if t['profit'] <= 0])) if win_rate < 1 else 0.08
                current_investment = kelly_position_size(BASE_INVESTMENT, win_rate, avg_win, avg_loss)

            # 4. Math Engine: OU Optimal Stopping (Exit Thresholds)
            if USE_OU_EXIT:
                target_profit, trailing_stop = calculate_ou_exit_threshold(list(price_deque), entry_price)
            else:
                target_profit, trailing_stop = MIN_PROFIT, 0.0

            # 5. ML Feature Extraction
            ef = ml.extract(price, zm, hurst_val, regime, get_order_book(KRAKEN_PAIR)) if ml else {}
            ec = ml.pred_entry(ef) if ml else 1.0
            ee = ml.pred_exit(ef) if ml else 999.0

            current_profit = calc_profit(entry_price, price, token_amount) if active_position else 0.0
            
            # 6. Auto BUY (Hurst Gated + Zone + Kelly + ML)
            cooldown_elapsed = (time.time() - last_trade_time) > AUTO_COOLDOWN_SEC
            can_buy_math = (regime == "mean_reverting" or regime == "random_walk") if USE_HURST_GATE else True
            
            if not active_position and cooldown_elapsed and zm.buy_sig(price) and can_buy_math and ec > ML_CONFIDENCE:
                amt = current_investment / price
                if amt * price >= MIN_ORDER_USD:
                    res = place_order('buy', amt, price)
                    if res and not res.get('error'):
                        active_position = True; entry_price = price; token_amount = amt
                        last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                        if ml: ml.record(ef, price, amt)
                        txid = "N/A"
                        try: txid = res.get('result', {}).get('txid', [])[0]
                        except: pass
                        print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="AUTO")

            # 7. Auto SELL (OU Dynamic Exit + Zone + Min Profit + ML)
            if active_position:
                can_sell = False
                if USE_OU_EXIT:
                    if current_profit >= target_profit: can_sell = True       # Hit dynamic target
                    elif price <= trailing_stop and current_profit > 0: can_sell = True # Trailing stop hit
                else:
                    if zm.sell_sig(price, entry_price, token_amount) and ee >= MIN_PROFIT: can_sell = True
                
                if can_sell:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        trade_history.append({'profit': current_profit})
                        active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                        if ml: ml.record(ef, price, token_amount)
                        txid = "N/A"
                        try: txid = res.get('result', {}).get('txid', [])[0]
                        except: pass
                        print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")

            # 8. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount, current_profit, last_trade_type, entry_price, aH, aL, aM, regime, hurst_val)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}"); time.sleep(10)

if __name__ == "__main__": main()