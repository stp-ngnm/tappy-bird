# ========================== MANUAL EXECUTION ==========================
def execute_manual(side):
    global active_position, entry_price, token_amount, last_trade_time, last_trade_type
    price = get_ticker()
    if not price:
        logging.error("Cannot get current price for manual execution.")
        return
    
    if side == "b":
        if active_position:
            print_ticket("BUY", "BLOCKED", price, 0.0, error="Position already active", trade_type="MANUAL")
            return
        ob = get_order_book(KRAKEN_PAIR)
        amt, avg_price, slippage = dyn_size(price, 'buy', ob)
        if not amt or amt * price < MIN_ORDER_USD:
            print_ticket("BUY", "FAILED", price, amt or 0.0, error=f"Below Kraken min order (${MIN_ORDER_USD:.2f})", trade_type="MANUAL")
            return
        
        logging.info(f"Sending MANUAL BUY for {amt:.8f} @ ~${price:.4f}...")
        res = place_order('buy', amt, price)
        if res and not res.get('error'):
            active_position = True
            entry_price = avg_price
            token_amount = amt
            last_trade_time = time.time()
            last_trade_type = "MANUAL BUY"
            txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
            print_ticket("BUY", "SUCCESS", avg_price, amt, txid=txid, trade_type="MANUAL")
            save_state()
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("BUY", "REJECTED", price, amt, error=err, trade_type="MANUAL")
            
    elif side == "s":
        if not active_position or token_amount <= 0:
            print_ticket("SELL", "BLOCKED", price, 0.0, error="No active position", trade_type="MANUAL")
            return
        
        sell_amount = token_amount
        logging.info(f"Sending MANUAL SELL for {sell_amount:.8f} @ ~${price:.4f}...")
        res = place_order('sell', sell_amount, price)
        if res and not res.get('error'):
            active_position = False
            token_amount = 0.0
            last_trade_time = time.time()
            last_trade_type = "MANUAL SELL"
            txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
            print_ticket("SELL", "SUCCESS", price, sell_amount, txid=txid, trade_type="MANUAL")
            save_state()
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("SELL", "REJECTED", price, sell_amount, error=err, trade_type="MANUAL")

