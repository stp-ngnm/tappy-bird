# ========================== MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time
    global last_trend, last_trade_type, trading_paused, KRAKEN_PAIR, consecutive_failures
    global highest_price_since_entry, last_ohlc, last_ohlc_time
    
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    logging.info(f"Validated pair: {KRAKEN_PAIR}")
    zm = ZoneMachine()
    ml = MLAdvisor() if ML_ENABLED else None
    pos = {'active': False, 'entry': 0.0, 'time': 0.0, 'amt': 0.0}
    
    ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
    if not zm.init(ohlc):
        logging.error("Could not initialize zones. Retrying in 30s...")
        time.sleep(30)
        ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
        if not zm.init(ohlc):
            logging.critical("Zone init failed after retry. Exiting.")
            sys.exit(1)
    logging.info(f"Zones initialized. Median: ${zm.median:.4f}")
    print(f"\n{BORDER}🚀 Bot Started. Monitoring {KRAKEN_PAIR}...{RESET}")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}\n", flush=True)
    time.sleep(PRICE_CHECK_INTERVAL)
    
    while True:
        try:
            if consecutive_failures >= MAX_CONSECUTIVE_FAILURES:
                print_ticket("API", "CIRCUIT BREAK", 0, 0,
                             error=f"API failed {consecutive_failures}x. Trading paused.",
                             trade_type="SYSTEM")
                trading_paused = True
                consecutive_failures = 0
                continue

            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}⏸ [PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    continue
                if cmd == 'r':
                    trading_paused = False
                    print(f"{PROF_P}▶ RESUMED{RESET}", flush=True)
                    continue
                elif cmd == 'q':
                    if active_position:
                        logging.warning(f"Position still active! Entry: ${entry_price:.4f} | Amt: {token_amount:.8f}")
                    print("\n👋 Exiting...", flush=True)
                    sys.exit(0)
                elif cmd in ('b', 's'):
                    execute_manual(cmd)
                    continue
                else:
                    print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}", flush=True)
                    continue

            if time.time() - last_trade_time < AUTO_COOLDOWN_SEC and last_trade_type != "NONE":
                time.sleep(PRICE_CHECK_INTERVAL)
                continue

            tick_failed = False
            
            price = get_ticker()
            if not price:
                tick_failed = True
            
            if not tick_failed:
                now = time.time()
                if last_ohlc is None or (now - last_ohlc_time) > 60:
                    ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
                    if not ohlc:
                        tick_failed = True
                    else:
                        last_ohlc = ohlc
                        last_ohlc_time = now
                ohlc = last_ohlc
                
                ob = get_order_book(KRAKEN_PAIR)
                if not ob:
                    tick_failed = True

            if tick_failed:
                consecutive_failures += 1
                if consecutive_failures >= MAX_CONSECUTIVE_FAILURES:
                    print_ticket("API", "CIRCUIT BREAK", 0, 0,
                                 error=f"API failed {consecutive_failures}x. Trading paused.",
                                 trade_type="SYSTEM")
                    trading_paused = True
                    consecutive_failures = 0
                time.sleep(5)
                continue
            
            consecutive_failures = 0
            price = round(price, 4)

            macd_line, signal_line, _ = calc_macd(ohlc)
            if macd_line is not None and signal_line is not None:
                last_trend = "UP" if macd_line > signal_line else "DOWN"
            else:
                last_trend = "UNKNOWN"

            # Compute indicators ONCE per tick
            bb_mid, bb_upper, bb_lower = calc_bollinger(ohlc)
            iqr_q1, iqr_q3, iqr_val = calc_iqr(ohlc, IQR_ML_LOOKBACK)

            if ohlc and len(ohlc) >= 10:
                if zm.check_redefinition(price, ohlc):
                    logging.info("🔄 Zones redefined (avg shift or >3min outside).")
                    zm.init(ohlc)

            if ohlc:
                aH = float(np.max([x['high'] for x in ohlc]))
                aL = float(np.min([x['low'] for x in ohlc]))
                aM = zm.median
            else:
                aH = aL = aM = 0.0

            # Update position state for feature calculation
            if active_position:
                pos['active'] = True
                pos['entry'] = entry_price
                pos['time'] = last_trade_time
                pos['amt'] = token_amount
            else:
                pos['active'] = False
                pos['amt'] = 0.0

            # --- FEATURE CALCULATION ---
            features = calculate_all_features(price, zm, last_trend, ob, pos, ohlc)
            if ml:
                ml.hist.append(features)

            # --- HARD EXITS (Absolute overrides, no ML veto) ---
            if active_position:
                if price > highest_price_since_entry:
                    highest_price_since_entry = price
                
                now = time.time()
                
                # 1. Max hold time
                if (now - last_trade_time) > MAX_HOLD_TIME_SEC:
                    logging.warning(f"MAX HOLD TIME REACHED ({MAX_HOLD_TIME_SEC}s). Forcing sell.")
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        exit_p = price
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("SELL", "MAX HOLD TIME", exit_p, token_amount, txid=txid, trade_type="AUTO")
                        if ml and features is not None:
                            ml.record(features, entry_price, exit_p, token_amount)
                        active_position = False
                        token_amount = 0.0
                        highest_price_since_entry = 0.0
                        last_trade_time = now
                        last_trade_type = "AUTO SELL"
                        save_state()
                    time.sleep(PRICE_CHECK_INTERVAL)
                    continue

                # 2. Dust position
                if token_amount * price < MIN_ORDER_USD:
                    logging.warning(f"Dust position detected (${token_amount * price:.2f} < ${MIN_ORDER_USD}). Forcing market sell.")
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        exit_p = price
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("SELL", "DUST CLEAR", exit_p, token_amount, txid=txid, trade_type="AUTO")
                        if ml and features is not None:
                            ml.record(features, entry_price, exit_p, token_amount)
                        active_position = False
                        token_amount = 0.0
                        highest_price_since_entry = 0.0
                        last_trade_time = now
                        last_trade_type = "AUTO SELL"
                        save_state()
                    time.sleep(PRICE_CHECK_INTERVAL)
                    continue

                # 3. Trailing stop
                trailing_stop_price = highest_price_since_entry * (1 - TRAILING_STOP_PCT)
                if price <= trailing_stop_price:
                    logging.warning(f"TRAILING STOP HIT: ${price:.4f} <= ${trailing_stop_price:.4f} (High: ${highest_price_since_entry:.4f})")
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        exit_p = price
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("SELL", "TRAILING STOP", exit_p, token_amount, txid=txid, trade_type="AUTO")
                        if ml and features is not None:
                            ml.record(features, entry_price, exit_p, token_amount)
                        active_position = False
                        token_amount = 0.0
                        highest_price_since_entry = 0.0
                        last_trade_time = now
                        last_trade_type = "AUTO SELL"
                        save_state()
                    time.sleep(PRICE_CHECK_INTERVAL)
                    continue

                # 4. Take Profit Ceiling (Hard Exit)
                if price >= entry_price * (1 + TAKE_PROFIT_PCT):
                    logging.warning(f"TAKE PROFIT CEILING HIT: ${price:.4f} >= ${entry_price * (1 + TAKE_PROFIT_PCT):.4f}")
                    res = place_order('sell', token_amount, price, ot='market')
                    if res and not res.get('error'):
                        exit_p = price
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("SELL", "TAKE PROFIT CEILING", exit_p, token_amount, txid=txid, trade_type="AUTO")
                        if ml and features is not None:
                            ml.record(features, entry_price, exit_p, token_amount)
                        active_position = False
                        token_amount = 0.0
                        highest_price_since_entry = 0.0
                        last_trade_time = now
                        last_trade_type = "AUTO SELL"
                        save_state()
                    time.sleep(PRICE_CHECK_INTERVAL)
                    continue

            # --- LOGIC-FIRST, ML-SECOND DECISION ---
            should_buy, should_sell, reason = trade_decision(features, price, zm, ob, pos, ml)

            if should_sell and active_position:
                logging.info(f"Executing SELL ({reason})")
                res = place_order('sell', token_amount, price, ot='market')
                if res and not res.get('error'):
                    exit_p = price
                    txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                    print_ticket("SELL", "SUCCESS", exit_p, token_amount, txid=txid, trade_type="AUTO")
                    if ml and features is not None:
                        ml.record(features, entry_price, exit_p, token_amount)
                    active_position = False
                    token_amount = 0.0
                    highest_price_since_entry = 0.0
                    last_trade_time = now
                    last_trade_type = "AUTO SELL"
                    save_state()
                else:
                    err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                    print_ticket("SELL", "FAILED", price, token_amount, error=err, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL)
                continue

            if should_buy and not active_position and not trading_paused:
                bet = get_kelly_bet(ml)
                if bet == 0:
                    time.sleep(PRICE_CHECK_INTERVAL)
                    continue
                amt, avg_price, slippage = dyn_size(price, 'buy', ob, max_inv=bet)
                if amt > 0:
                    res = place_order('buy', amt, avg_price)
                    if res and not res.get('error'):
                        active_position = True
                        entry_price = avg_price
                        token_amount = amt
                        highest_price_since_entry = avg_price
                        last_trade_time = time.time()
                        last_trade_type = "AUTO BUY"
                        txid = res.get('result', {}).get('txid', ['N/A'])[0] if isinstance(res.get('result', {}).get('txid'), list) else 'N/A'
                        print_ticket("BUY", "SUCCESS", avg_price, amt, txid=txid, trade_type="AUTO")
                        logging.info(f"ML prob: {ml.pred_entry(features) if ml and ml.trained else 'N/A'} | Kelly bet: ${bet:.2f} | Slippage: {slippage:.4%} | Spring: {features['spring']:.2f}")
                        save_state()
                    else:
                        err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
                        print_ticket("BUY", "REJECTED", price, 0.0, error=err, trade_type="AUTO")

            # Dashboard uses pre-computed indicators
            print_dash(price, zm, last_trend, active_position, token_amount,
                       calc_profit(entry_price, price, token_amount) if active_position else 0.0,
                       last_trade_type, entry_price, aH, aL, aM,
                       bb_mid or 0, bb_upper or 0, bb_lower or 0,
                       iqr_q1 or 0, iqr_q3 or 0, iqr_val or 0, features['spring'])
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸ PAUSED{RESET} | Commands: "
                  f"{SUB}r{RESET}=resume {SUB}q{RESET}=quit "
                  f"{SUB}b{RESET}=buy {SUB}s{RESET}=sell{RESET}", flush=True)
        except Exception as e:
            logging.error(f"Loop error: {e}", exc_info=True)
            time.sleep(10)

# ========================== SIGTERM HANDLER ==========================
def signal_term_handler(signum, frame):
    if active_position:
        logging.critical(f"SIGTERM received with ACTIVE POSITION! "
                         f"Entry: ${entry_price:.4f}, Amt: {token_amount:.8f}")
        with open("emergency_exit.log", "a") as f:
            f.write(f"{time.time()}: SIGTERM with position. Entry={entry_price}, Amt={token_amount}\n")
    sys.exit(0)

# ========================== ENTRY POINT ==========================
if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGTERM, signal_term_handler)
    load_state()
    main()