def print_ticket(side, status, price, amount, error=None, txid=None, trade_type="AUTO"):
    print(f"\n{BORDER}====== {TITLE}TRADE TICKET{BORDER} ====={RESET}")
    print(f"{SUB}Type:{RESET} {NUM}{side.upper()} ({trade_type}){RESET}")
    print(f"{SUB}Status:{RESET} {NUM}{status}{RESET}")
    print(f"{SUB}Price:{RESET} {NUM}${price:.4f}{RESET}")
    print(f"{SUB}Amount:{RESET} {NUM}{amount:.8f}{RESET}")
    if txid:
        print(f"{SUB}Kraken ID:{RESET} {NUM}{txid}{RESET}")
    if error:
        print(f"{SUB}Reason:{RESET} {PROF_N}{error}{RESET}")
    print(f"{SUB}Time:{RESET} {NUM}{time_mod.strftime('%H:%M:%S')}{RESET}")
    print(f"{BORDER}==========================={RESET}\n", flush=True)

# ========================== ⚡ IMMEDIATE MANUAL EXECUTION ==========================
def execute_manual(side):
    global active_position, entry_price, token_amount, last_trade_time, last_trade_type
    price = get_ticker()
    if not price:
        print_ticket(side, "FAILED", 0.0, 0.0,
                     error="Could not fetch market price", trade_type="MANUAL")
        return
    price = round(price, 4)

    if side == "b":
        if active_position:
            print_ticket("BUY", "BLOCKED", price, 0.0,
                         error="Already in position", trade_type="MANUAL")
            return
        amt = INVESTMENT_AMOUNT / price
        if amt * price < MIN_ORDER_USD:
            print_ticket("BUY", "FAILED", price, amt,
                         error="Below Kraken min order ($10)", trade_type="MANUAL")
            return
        print(f"{NUM}🚀 Sending MANUAL BUY for {amt:.8f} @ ~${price:.4f}...{RESET}")
        res = place_order('buy', amt, price)
        if res and not res.get('error'):
            active_position = True
            entry_price = price
            token_amount = amt
            last_trade_time = time.time()
            last_trade_type = "MANUAL BUY"
            txid = "N/A"
            try:
                txid_list = res.get('result', {}).get('txid', [])
                if isinstance(txid_list, list) and len(txid_list) > 0:
                    txid = txid_list[0]
            except:
                pass
            print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="MANUAL")
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("BUY", "REJECTED", price, amt, error=err, trade_type="MANUAL")

    elif side == "s":
        if not active_position or token_amount <= 0:
            print_ticket("SELL", "BLOCKED", price, 0.0,
                         error="No active position", trade_type="MANUAL")
            return
        print(f"{NUM}💰 Sending MANUAL SELL for {token_amount:.8f} @ ~${price:.4f}...{RESET}")
        res = place_order('sell', token_amount, price)
        if res and not res.get('error'):
            active_position = False
            token_amount = 0
            last_trade_time = time.time()
            last_trade_type = "MANUAL SELL"
            txid = "N/A"
            try:
                txid_list = res.get('result', {}).get('txid', [])
                if isinstance(txid_list, list) and len(txid_list) > 0:
                    txid = txid_list[0]
            except:
                pass
            print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="MANUAL")
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("SELL", "REJECTED", price, token_amount, error=err, trade_type="MANUAL")

