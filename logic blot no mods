# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time
    global last_trend, last_trade_type, trading_paused, KRAKEN_PAIR
    global outside_zone_since

    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zm = ZoneMachine()
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}")

    while True:
        try:
            # ======== PAUSED STATE (Priority Input Loop) ========
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    continue
                if cmd == 'r':
                    trading_paused = False
                    print(f"{PROF_P}▶️ RESUMED{RESET}")
                    continue
                elif cmd == 'q':
                    print("👋 Exiting...")
                    sys.exit(0)
                elif cmd in ('b', 's'):
                    execute_manual(cmd)
                    continue
                else:
                    print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}")
                    continue

            # ======== RUNNING STATE ========
            price = get_ticker()
            if not price:
                time.sleep(PRICE_CHECK_INTERVAL)
                continue
            price = round(price, 4)

            # 1. Fetch OHLC & Analyze Market State (Drives all zoning/decisions)
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 10:
                market_state, aH, aL, momentum = analyze_market_state(ohlc, price)
                aM = float((np.median([x['high'] for x in ohlc]) +
                            np.median([x['low'] for x in ohlc])) / 2)
                if not zm.buy_zone:
                    zm.init(ohlc)
            else:
                aH = aL = aM = 0.0
                market_state = "neutral"

            # 2. MACD Trend (Display only, does NOT gate trades)
            trend = "neutral"
            try:
                ho = get_ohlc(KRAKEN_PAIR, 60, 100)
                if ho:
                    m, s, _ = calc_macd(ho)
                    if m and s:
                        trend = "up" if m > s else "down"
            except:
                pass
            last_trend = trend

            # 3. Zone Reset Check
            if zm.zones_expired(price):
                zm.init(ohlc)
                time.sleep(PRICE_CHECK_INTERVAL)
                continue

            # 4. Stop-Loss Check (Overrides ALL other logic)
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                lim = price * (1 - STOP_LOSS_LIMIT_BUFFER)
                res = place_order('sell', token_amount, price,
                                  ot='stop-loss-limit', p2=lim)
                if res and not res.get('error'):
                    active_position = False
                    token_amount = 0
                    last_trade_time = time.time()
                    last_trade_type = "STOP-LOSS"
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL)
                continue

            current_profit = calc_profit(entry_price, price, token_amount) if active_position else 0.0
            zone = zm.zone(price) if zm.buy_zone else "OUTSIDE"

            # 5. Auto BUY (Trend-Independent + Zone Signal)
            cooldown_elapsed = (time.time() - last_trade_time) > AUTO_COOLDOWN_SEC
            can_buy = False
            if not active_position and cooldown_elapsed:
                if zone == "BUY" and market_state not in ["strong_down", "weak_down"]:
                    can_buy = True
                elif zone == "NEUTRAL" and market_state == "strong_up":
                    can_buy = True

            if can_buy:
                amt = INVESTMENT_AMOUNT / price
                if amt * price >= MIN_ORDER_USD:
                    res = place_order('buy', amt, price)
                    if res and not res.get('error'):
                        active_position = True
                        entry_price = price
                        token_amount = amt
                        last_trade_time = time.time()
                        last_trade_type = "AUTO BUY"
                        txid = "N/A"
                        try:
                            txid_list = res.get('result', {}).get('txid', [])
                            if isinstance(txid_list, list) and len(txid_list) > 0:
                                txid = txid_list[0]
                        except:
                            pass
                        print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="AUTO")

            # 6. Auto SELL (Zone + Min Profit — BOTH required)
            if active_position:
                if zm.sell_sig(price, entry_price, token_amount):
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        active_position = False
                        token_amount = 0
                        last_trade_time = time.time()
                        last_trade_type = "AUTO SELL"
                        txid = "N/A"
                        try:
                            txid_list = res.get('result', {}).get('txid', [])
                            if isinstance(txid_list, list) and len(txid_list) > 0:
                                txid = txid_list[0]
                        except:
                            pass
                        print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")

            # 7. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount,
                       current_profit, last_trade_type, entry_price, aH, aL, aM)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()