# ========================================
# 🎛️ CONTROL PANEL / CONFIGURATION
# ========================================
# --- API CREDENTIALS ---
API_KEY = "____"       # <-- REPLACE ONLY THIS BLOCK WITH API KEY
API_SECRET = "____"    # <-- REPLACE ONLY THIS BLOCK WITH SECRET KEY
if API_KEY == "_____" or API_SECRET == "_____":
    raise ValueError("Please replace the placeholder API keys with your actual Kraken keys.")

# --- TRADING CONFIG ---
TRADING_PAIR = "FLOWUSD"         # Trading pair to monitor
KRAKEN_PAIR = TRADING_PAIR       # Kraken format (auto-updated on startup)
INVESTMENT_AMOUNT = 11.11        # Base amount to risk per trade (in quote currency)
FEE_RATE = 0.0036                # roughly 0.36% of trades in fees only catches buy in fees mathematicaly
BOND_DECIMALS = 8                # Order amount precision
MIN_PROFIT = 0.11                # Minimum profit in quote currency after buy fee
STOP_LOSS_PCT = 0.2100           # 21.00% stop-loss trigger sells after falling 21%
STOP_LOSS_LIMIT_BUFFER = 0.12    # 12.0% buffer for stop-loss limit orders enters deciding range at 12%
MIN_ORDER_USD = 10.0             # Kraken minimum order value guard

# --- AVG-ENTRY TUNING ---
BUY_AT_LOWEST_AVERAGE = True     # If True, waits for average low to trigger buy
SELL_AT_HIGHEST_AVERAGE = True   # If True, waits for average high to trigger sell
ENTRY_RANGE_PCT = 0.031          # ±0.031% around the tracked average up to 0.6% is ok

# --- DEPTH / SLIPPAGE CONFIG ---
MAX_SLIPPAGE_PCT = 0.04          # Max 4% slippage after entries
MIN_LIQUIDITY_RATIO = 0.6        # Fill at least this fraction of requested amount within depth
ORDERBOOK_DEPTH_LEVELS = 500     # Fetch up to 500 levels (max per Kraken call)
MAX_BID_ASK_SPREAD_PCT = 0.04    # BLOCK BUY if drop spread > 4% no higher than 8 no lower than 1

# --- API & ZONE CONFIG ---
API_URL = "https://api.kraken.com"
API_VERSION = "0"
PRICE_CHECK_INTERVAL = 15        # Seconds between main loop cycles
ZONE_RESET_HOLD_TIME = 300       # Seconds outside all zones before recalculating
MEDIAN_LOOKBACK = 720            # ⚠️ 720 candles = 12 hours of 1-minute data
AUTO_COOLDOWN_SEC = 120          # ⏱️ Hard cap: Auto trades wait max 2 minutes between entries

USE_IQR_ADAPTIVE_ZONES = True    # 🔘 TOGGLE: True = Math scales zones. False = Fixed dollar buffers below.
ZONE_BUFFER = 0.72               # Half-width of neutral zone in dollars (Used if Adaptive = False)
SELL_ZONE_EXTRA = 5.50           # Extra above neutral zone for sell zone (Used if Adaptive = False)
BUY_ZONE_EXTRA = 5.50            # Extra below neutral zone for buy zone (Used if Adaptive = False)

# --- MACD PARAMETERS ---
MACD_FAST = 12
MACD_SLOW = 26
MACD_SIGNAL = 9

# --- KELLY SIZING CONFIG ---
USE_KELLY_SIZING = False         # 🔘 TOGGLE: True = Scale bet size by win rate. False = Fixed INVESTMENT_AMOUNT.
MAX_KELLY_INCREASE_PCT = 0.10    # 🛡️ CAP: Never risk more than 10% above the base INVESTMENT_AMOUNT

# --- ML CONFIGURATION ---
ML_ENABLED = HAS_ML              # Enable ML features (requires sklearn, scipy, joblib)
ML_CONFIDENCE = 0.65             # Minimum probability for ML entry signal
ML_MIN_TRADES_TO_TAKEOVER = 3    # 🔢 ADJUSTABLE: Number of trades ML must observe before it overrides logic
ML_PATH = "ml_models/"           # Directory to save/load ML models