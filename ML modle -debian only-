# ========================== ⚡ IMMEDIATE MANUAL EXECUTION ==========================
def execute_manual(side):
    global active_position, entry_price, token_amount, last_trade_time, last_trade_type
    price = get_ticker()
    if not price: print_ticket(side, "FAILED", 0.0, 0.0, error="No price", trade_type="MANUAL"); return
    price = round(price, 6)
    if side == "b":
        if active_position: print_ticket("BUY", "BLOCKED", price, 0.0, error="In position", trade_type="MANUAL"); return
        amt = INVESTMENT_AMOUNT / price
        if amt * price < MIN_ORDER_USD: print_ticket("BUY", "FAILED", price, amt, error="Min $10", trade_type="MANUAL"); return
        res = place_order('buy', amt, price)
        if res and not res.get('error'):
            active_position = True; entry_price = price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "MANUAL BUY"
            txid = "N/A"
            try: txid = res.get('result', {}).get('txid', [])[0]
            except: pass
            print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="MANUAL")
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("BUY", "REJECTED", price, amt, error=err, trade_type="MANUAL")
    elif side == "s":
        if not active_position: print_ticket("SELL", "BLOCKED", price, 0.0, error="No position", trade_type="MANUAL"); return
        res = place_order('sell', token_amount, price)
        if res and not res.get('error'):
            profit = calc_profit(entry_price, price, token_amount)
            trade_history.append({'profit': profit})
            active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "MANUAL SELL"
            txid = "N/A"
            try: txid = res.get('result', {}).get('txid', [])[0]
            except: pass
            print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="MANUAL")
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("SELL", "REJECTED", price, token_amount, error=err, trade_type="MANUAL")

