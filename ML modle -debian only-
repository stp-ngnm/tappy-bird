def calculate_adaptive_zones(ohlc):
    """IQR + Rolling StdDev Volatility-Adaptive Zones"""
    if not ohlc or len(ohlc) < 50: return None, None, None, 0.0
    closes = np.array([x['close'] for x in ohlc])
    median_price = np.median(closes)
    
    roll_std = np.std(closes[-60:]) if len(closes) >= 60 else np.std(closes)
    q25, q75 = np.percentile(closes[-min(300, len(closes)):], [25, 75])
    iqr = q75 - q25
    
    vol_factor = max(roll_std, iqr * 0.5)
    if vol_factor == 0: vol_factor = median_price * 0.01 
    
    neutral_width = vol_factor * 0.8
    buy_extra = vol_factor * 2.5
    sell_extra = vol_factor * 2.5
    
    buy_zone = (round(median_price - neutral_width - buy_extra, 4), round(median_price - neutral_width, 4))
    neutral_zone = (round(median_price - neutral_width, 4), round(median_price + neutral_width, 4))
    sell_zone = (round(median_price + neutral_width, 4), round(median_price + neutral_width + sell_extra, 4))
    
    return buy_zone, neutral_zone, sell_zone, median_price

def calculate_fixed_zones(median_price):
    """Fallback Fixed Dollar Zones"""
    nl = round(median_price - ZONE_BUFFER/2, 4)
    nu = round(median_price + ZONE_BUFFER/2, 4)
    neutral_zone = (nl, nu)
    buy_zone = (round(nl - BUY_ZONE_EXTRA, 4), nl)
    sell_zone = (nu, round(nu + SELL_ZONE_EXTRA, 4))
    return buy_zone, neutral_zone, sell_zone

def hurst_exponent(prices, max_lag=20):
    """Rescaled Range Analysis for Market Regime Classification"""
    n = len(prices)
    if n < max_lag * 2: return 0.5
    lags = np.arange(2, max_lag)
    tau = []
    for lag in lags:
        diff = prices[lag:] - prices[:-lag]
        std_val = np.std(diff)
        tau.append(std_val if std_val > 0 else 1e-9)
    tau = np.array(tau)
    poly = np.polyfit(np.log(lags), np.log(tau), 1)
    return poly[0] * 2.0

def classify_market_regime(h):
    if h > 0.55: return "trending"
    elif h < 0.45: return "mean_reverting"
    else: return "random_walk"

def calculate_dynamic_exit_threshold(prices, entry_price, k=1.5):
    """Ornstein-Uhlenbeck Optimal Stopping Threshold"""
    if len(prices) < 20: return MIN_PROFIT, 0.0
    recent = np.array(prices)
    mean = np.mean(recent)
    sigma = np.std(recent)
    if sigma == 0: return MIN_PROFIT, 0.0
    dynamic_target = mean + (k * sigma)
    trailing_stop = mean - (k * 0.6 * sigma)
    target_profit = max(dynamic_target - entry_price, MIN_PROFIT)
    return target_profit, trailing_stop

def kelly_position_size(max_bet, win_rate, avg_win, avg_loss, max_fraction=0.25):
    """Fractional Kelly Criterion for Dynamic Position Sizing"""
    if avg_loss == 0 or win_rate == 0: return max_bet * 0.05
    b = avg_win / avg_loss
    p = win_rate; q = 1 - p
    kelly_f = (b * p - q) / b
    safe_f = min(max(kelly_f * 0.5, 0.01), max_fraction)
    return max_bet * safe_f

def calc_macd(ohlc):
    """Proper EMA-based MACD"""
    if len(ohlc) < MACD_SLOW + MACD_SIGNAL: return None, None, None
    c = [x['close'] for x in ohlc]
    def ema(d, sp): a=2/(sp+1); v=[d[0]]; [v.append(a*x+(1-a)*v[-1]) for x in d[1:]]; return v
    ml = [x-y for x,y in zip(ema(c, MACD_FAST), ema(c, MACD_SLOW))]
    sl = ema(ml, MACD_SIGNAL)
    return ml[-1], sl[-1], (ml[-1] - sl[-1])

