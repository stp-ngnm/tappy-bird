    def extract_features(self, price_hist, volume_hist, orderbook_hist):
        if len(price_hist) < 50:
            return None
        prices = np.array(list(price_hist)[-50:])
        features = []
        
        features.extend([np.mean(prices), np.std(prices), np.max(prices), np.min(prices), prices[-1],
                         (prices[-1] - prices[0]) / (prices[0] + 1e-10)])
        features.extend([np.percentile(prices, p) for p in [25, 75]])
        
        for window in [5, 10, 20, 40]:
            if len(prices) >= window * 2:
                recent_avg = np.mean(prices[-window:])
                prev_avg = np.mean(prices[-window*2:-window])
                features.append(recent_avg - prev_avg)
            else:
                features.append(0)
        
        for window in [10, 20, 30, 40]:
            if len(prices) >= window:
                returns = np.diff(prices[-window:]) / (prices[-window:-1] + 1e-10)
                features.append(np.std(returns))
            else:
                features.append(0)
        
        if len(prices) >= 3:
            x = np.arange(len(prices))
            z = np.polyfit(x, prices, 1)
            p = np.poly1d(z)
            yhat, ybar = p(x), np.mean(prices)
            ssreg = np.sum((yhat - ybar)**2)
            sstot = np.sum((prices - ybar)**2)
            r_squared = ssreg / (sstot + 1e-10)
            features.extend([z[0], z[1], r_squared])
        else:
            features.extend([0, 0, 0])
        
        if len(prices) >= 15:
            deltas = np.diff(prices[-15:])
            gains = deltas[deltas > 0].sum()
            losses = abs(deltas[deltas < 0].sum())
            rs = gains / (losses + 1e-10)
            rsi = 100 - (100 / (1 + rs))
            features.append(rsi)
        else:
            features.extend([50, 0])
        
        if len(prices) >= 26:
            ema_fast = self._ema(prices, 12)
            ema_slow = self._ema(prices, 26)
            macd_line = ema_fast - ema_slow
            features.extend([macd_line, 0])
        else:
            features.extend([0, 0])
        
        if len(prices) >= 20:
            bb_middle = np.mean(prices[-20:])
            bb_std = np.std(prices[-20:])
            bb_upper = bb_middle + 2.0 * bb_std
            bb_lower = bb_middle - 2.0 * bb_std
            bb_position = (prices[-1] - bb_lower) / (bb_upper - bb_lower + 1e-10)
            features.extend([bb_position, bb_std])
        else:
            features.extend([0.5, 0])
        
        if len(volume_hist) >= 50:
            volumes = np.array(list(volume_hist)[-50:])
            features.extend([np.mean(volumes), np.std(volumes), volumes[-1] / (np.mean(volumes) + 1e-10)])
        else:
            features.extend([0, 0, 1.0])
        
        if len(orderbook_hist) >= 3:
            ob = list(orderbook_hist)[-3:]
            bid_vols = [o.get('bid_volume', 1.0) for o in ob]
            ask_vols = [o.get('ask_volume', 1.0) for o in ob]
            avg_bid, avg_ask = np.mean(bid_vols), np.mean(ask_vols)
            imbalance = (avg_bid - avg_ask) / (avg_bid + avg_ask + 1e-10)
            features.extend([avg_bid, avg_ask, imbalance])
        else:
            features.extend([0, 0, 0])
        
        return np.array(features)

    def _ema(self, data, period):
        if len(data) < period:
            return np.mean(data)
        multiplier = 2 / (period + 1)
        ema = np.mean(data[:period])
        for price in data[period:]:
            ema = (price - ema) * multiplier + ema
        return ema

    def ensemble_vote(self, features, current_price, zone_status):
        if not self.models_trained or features is None:
            return None, 0.0
        votes = {'buy': 0.0, 'sell': 0.0, 'hold': 0.0}
        
        pattern, pattern_conf = self.predict_pattern(features)
        if pattern == 1:
            votes['buy'] += 0.30 * pattern_conf
        elif pattern == 2:
            votes['sell'] += 0.30 * pattern_conf
        else:
            votes['hold'] += 0.30
        
        pred_price = self.predict_price(features)
        if pred_price:
            price_change = (pred_price - current_price) / current_price
            if price_change > 0.01:
                votes['buy'] += 0.25 * min(abs(price_change)*20, 1.0)
            elif price_change < -0.01:
                votes['sell'] += 0.25 * min(abs(price_change)*20, 1.0)
            else:
                votes['hold'] += 0.25
        
        timing = self.score_timing(features)
        if zone_status == "BUY" and timing > 0.7:
            votes['buy'] += 0.30 * timing
        elif zone_status == "SELL" and timing > 0.7:
            votes['sell'] += 0.30 * timing
        else:
            votes['hold'] += 0.30 * (1 - timing)
        
        risk = self.calculate_risk_score(features, current_price, zone_status)
        if risk < 0.3:
            if zone_status in ["BUY", "NEUTRAL"]:
                votes['buy'] += 0.15 * (1 - risk)
        elif risk > 0.7:
            votes['sell'] += 0.15 * risk
            votes['hold'] += 0.15 * risk * 0.5
        
        winner = max(votes, key=votes.get)
        confidence = votes[winner] / (sum(votes.values()) + 1e-10)
        return winner, confidence

