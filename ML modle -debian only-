# ========================== IMMEDIATE MANUAL EXECUTION ==========================
def execute_manual(side):
    global active_position, entry_price, token_amount, last_trade_time, last_trade_type
    price = get_ticker()
    if not price:
        print_ticket(side, "FAILED", 0.0, 0.0, error="Could not fetch market price", trade_type="MANUAL")
        return
    price = round(price, 4)

    if side == "b":
        if active_position:
            print_ticket("BUY", "BLOCKED", price, 0.0, error="Already in position", trade_type="MANUAL")
            return
        
        amt = INVESTMENT_AMOUNT / price
        if amt * price < MIN_ORDER_USD:
            print_ticket("BUY", "FAILED", price, amt, error="Below Kraken min order ($10)", trade_type="MANUAL")
            return

        print(f"{NUM}🚀 Sending MANUAL BUY for {amt:.8f} @ ~${price:.4f}...{RESET}")
        res = place_order('buy', amt, price)
        
        if res and not res.get('error'):
            active_position = True
            entry_price = price
            token_amount = amt
            last_trade_time = time.time()
            last_trade_type = "MANUAL BUY"
            txid = "N/A"
            try:
                txid_list = res.get('result', {}).get('txid', [])
                if isinstance(txid_list, list) and len(txid_list) > 0:
                    txid = txid_list[0]
            except: pass
            print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="MANUAL")
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("BUY", "REJECTED", price, amt, error=err, trade_type="MANUAL")

    elif side == "s":
        if not active_position or token_amount <= 0:
            print_ticket("SELL", "BLOCKED", price, 0.0, error="No active position", trade_type="MANUAL")
            return

        print(f"{NUM}💰 Sending MANUAL SELL for {token_amount:.8f} @ ~${price:.4f}...{RESET}")
        res = place_order('sell', token_amount, price)
        
        if res and not res.get('error'):
            active_position = False
            token_amount = 0
            last_trade_time = time.time()
            last_trade_type = "MANUAL SELL"
            txid = "N/A"
            try:
                txid_list = res.get('result', {}).get('txid', [])
                if isinstance(txid_list, list) and len(txid_list) > 0:
                    txid = txid_list[0]
            except: pass
            print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="MANUAL")
        else:
            err = res.get('error', ['Unknown'])[0] if isinstance(res.get('error'), list) else 'No response'
            print_ticket("SELL", "REJECTED", price, token_amount, error=err, trade_type="MANUAL")

# ========================== 🤖 ML ADVISOR ==========================
class MLAdvisor:
    def __init__(self):
        try:
            from sklearn.ensemble import RandomForestClassifier, GradientBoostingRegressor
            from sklearn.model_selection import TimeSeriesSplit, RandomizedSearchCV
            from sklearn.preprocessing import StandardScaler
            from scipy.stats import randint, uniform
            import joblib
            self.RFC = RandomForestClassifier
            self.GBR = GradientBoostingRegressor
            self.TSCV = TimeSeriesSplit
            self.RSCV = RandomizedSearchCV
            self.Scaler = StandardScaler
            self.randint = randint
            self.uniform = uniform
            self.joblib = joblib
        except ImportError:
            self.RFC = self.GBR = self.TSCV = self.RSCV = self.Scaler = None
            logging.warning("sklearn missing. ML features disabled.")
            
        self.entry, self.exit, self.scaler = None, None, None
        self.hist, self.trades, self.trained = deque(maxlen=100), [], False
        self.fnames = ['mom5','mom10','vol','zBuy','zSell','zNeu','zDep','tUp','tDn','sprd','imb','liq','pnl','hold']
        self._load()

    def extract(self, price, zm, trend, ob, pos):
        f = {}
        if self.hist:
            pp = [x['price'] for x in self.hist]
            f['mom5'] = (price-pp[-5])/pp[-5] if len(pp)>=5 else 0
            f['mom10'] = (price-pp[-10])/pp[-10] if len(pp)>=10 else 0
            f['vol'] = np.std(pp[-20:])/np.mean(pp[-20:]) if len(pp)>=20 else 0
        else: f['mom5']=f['mom10']=f['vol']=0
        z = zm.zone(price)
        f['zBuy']=1 if z=='BUY' else 0; f['zSell']=1 if z=='SELL' else 0; f['zNeu']=1 if z=='NEUTRAL' else 0
        if zm.buy_zone and z=='BUY': f['zDep']=(price-zm.buy_zone[0])/(zm.buy_zone[1]-zm.buy_zone[0])
        elif zm.sell_zone and z=='SELL': f['zDep']=(zm.sell_zone[1]-price)/(zm.sell_zone[1]-zm.sell_zone[0])
        else: f['zDep']=0.5
        f['tUp']=1 if trend=='up' else 0; f['tDn']=1 if trend=='down' else 0
        if ob and ob['bids'] and ob['asks']:
            f['sprd']=(ob['asks'][0][0]-ob['bids'][0][0])/ob['bids'][0][0]
            bv, av = sum(v for _,v in ob['bids'][:10]), sum(v for _,v in ob['asks'][:10])
            f['imb']=(bv-av)/(bv+av) if bv+av>0 else 0; f['liq']=(bv+av)/price
        else: f['sprd']=f['imb']=f['liq']=0
        f['pnl']=(price-pos['entry'])/pos['entry'] if pos['active'] else 0.0
        f['hold']=(time.time()-pos['time'])/60 if pos['active'] else 0.0
        self.hist.append({**f, 'price':price}); return f

    def _vec(self, f): return np.array([f.get(k,0) for k in self.fnames]).reshape(1,-1)
    def pred_entry(self, f):
        return float(self.entry.predict_proba(self.scaler.transform(self._vec(f)))[0][1]) if self.trained and self.entry else 0.5
    def pred_exit(self, f):
        return float(self.exit.predict(self.scaler.transform(self._vec(f)))[0]) if self.trained and self.exit else 0.0
    def record(self, ef, ep, xp, amt):
        p = calc_profit(xp, ep, amt); self.trades.append({'f':ef.copy(), 'p':p, 'l':1 if p>=MIN_PROFIT else 0})
        if len(self.trades)>=ML_RETRAIN: self._train()
    def _train(self):
        if self.RFC is None: return
        os.makedirs(ML_PATH, exist_ok=True)
        if len(self.trades)<30: return
        X = np.array([self._vec(t['f'])[0] for t in self.trades])
        ye, yx = np.array([t['l'] for t in self.trades]), np.array([t['p'] for t in self.trades])
        tscv = self.TSCV(3)
        es = self.RSCV(self.RFC(random_state=42), {'n_estimators':self.randint(50,200),'max_depth':self.randint(3,10)}, n_iter=10, cv=tscv, scoring='accuracy', random_state=42)
        xs = self.RSCV(self.GBR(random_state=42), {'n_estimators':self.randint(50,200),'learning_rate':self.uniform(0.01,0.2),'max_depth':self.randint(2,6)}, n_iter=10, cv=tscv, scoring='neg_mean_squared_error', random_state=42)
        try:
            Xs = self.scaler.fit_transform(X)
            es.fit(Xs, ye); xs.fit(Xs, yx)
            self.entry, self.exit = es.best_estimator_, xs.best_estimator_; self.trained = True
            self.joblib.dump(self.entry, f"{ML_PATH}e.pkl"); self.joblib.dump(self.exit, f"{ML_PATH}x.pkl"); self.joblib.dump(self.scaler, f"{ML_PATH}s.pkl")
            print(f"\n{BORDER}🧠 ML Retrained | Entry Acc: {es.best_score_:.2%} | Exit MSE: {-xs.best_score_:.4f}{RESET}")
            self.trades = self.trades[-200:]
        except: pass
    def _load(self):
        try:
            if os.path.exists(f"{ML_PATH}e.pkl") and self.joblib:
                self.entry = self.joblib.load(f"{ML_PATH}e.pkl"); self.exit = self.joblib.load(f"{ML_PATH}x.pkl"); self.scaler = self.joblib.load(f"{ML_PATH}s.pkl"); self.trained = True
        except: pass

# ========================== ZONE MACHINE ==========================
class ZoneMachine:
    def __init__(self):
        self.buy_zone = self.neutral_zone = self.sell_zone = None
        self.median = 0.0

    def init(self, ohlc):
        if not ohlc or len(ohlc) < 10: return False
        h = np.array([x['high'] for x in ohlc])
        l = np.array([x['low'] for x in ohlc])
        self.median = float((np.median(h) + np.median(l)) / 2)
        nl = round(self.median - ZONE_BUFFER/2, 4)
        nu = round(self.median + ZONE_BUFFER/2, 4)
        self.neutral_zone = (nl, nu)
        self.buy_zone = (round(nl - BUY_ZONE_EXTRA, 4), nl)
        self.sell_zone = (nu, round(nu + SELL_ZONE_EXTRA, 4))
        return True

    def zone(self, p):
        if self.buy_zone and self.buy_zone[0] <= p < self.buy_zone[1]: return "BUY"
        if self.neutral_zone and self.neutral_zone[0] <= p <= self.neutral_zone[1]: return "NEUTRAL"
        if self.sell_zone and self.sell_zone[0] < p <= self.sell_zone[1]: return "SELL"
        return "OUTSIDE"

    def expired(self, p):
        global outside_zone_since; now = time.time()
        if self.zone(p) == "OUTSIDE":
            if outside_zone_since is None: outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME: outside_zone_since = None; return True
        else: outside_zone_since = None
        return False

    def buy_sig(self, p): return self.zone(p) == "BUY"
    def sell_sig(self, p, ep, amt):
        # ✅ FIX: Require BOTH zone condition AND min profit
        in_sell_zone = self.zone(p) == "SELL"
        profit = calc_profit(ep, p, amt)
        profit_met = profit >= MIN_PROFIT
        return in_sell_zone and profit_met

