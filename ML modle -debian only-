    print(f"{SUB}Current Price:{RESET} {NUM}${price:.6f}{RESET} {SUB}| last entry price:{RESET} {NUM}${ep:.6f}{RESET}")
    print(f"{SUB}active tokens:{RESET} {NUM}{amt:.8f}{RESET} {SUB}| spent amount:{RESET} {NUM}${spent:.2f}{RESET}")
    print(f"{SUB}Status:{RESET} {NUM}{'ACTIVE' if act else 'WAITING'}{RESET} {SUB}| Last Action:{RESET} {NUM}{lt}{RESET}")
    print(f"{pc}profit margin: {prof:+.4f}{RESET}")
    print(f"{BORDER}==========================={RESET}", flush=True)

# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time, last_trend, last_trade_type, trading_paused, KRAKEN_PAIR
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zm = ZoneMachine()
    ml = MLAdvisor() if ML_ENABLED else None
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}")
    
    while True:
        try:
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt): continue
                if cmd == 'r': trading_paused = False; print(f"{PROF_P}▶️ RESUMED{RESET}"); continue
                elif cmd == 'q': print("👋 Exiting..."); sys.exit(0)
                elif cmd in ('b', 's'): execute_manual(cmd); continue
                else: print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}"); continue

            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 6)
            price_history.append(price)

            # 1. Fetch 5-Hour OHLC (Drives all parameters & zones)
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 10:
                aH = np.max([x['high'] for x in ohlc])
                aL = np.min([x['low'] for x in ohlc])
                aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2)
                if not zm.buy_zone: zm.init(ohlc)
                
                closes = np.array([x['close'] for x in ohlc])
                hurst_val = hurst_exponent(closes)
                regime = classify_market_regime(hurst_val)
                
                macd_line, sig_line, _ = calc_macd(ohlc)
                macd_trend = "up" if macd_line and sig_line and macd_line > sig_line else "down"
            else:
                aH = aL = aM = 0.0; hurst_val = 0.5; regime = "random_walk"; macd_trend = "neutral"

            last_trend = macd_trend
            
            # 2. Stop Loss
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                res = place_order('sell', token_amount, price, ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                if res and not res.get('error'):
                    trade_history.append({'profit': calc_profit(entry_price, price, token_amount)})
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # 3. ML Feature Extraction
            ef = ml.extract(price, zm, hurst_val, regime, get_order_book(KRAKEN_PAIR)) if ml else {}
            ec = ml.pred_entry(ef) if ml else 1.0
            ee = ml.pred_exit(ef) if ml else 999.0

            # 4. Smart Buy (Kelly Sizing + Hurst/MACD Regime Gate)
            cooldown_elapsed = (time.time() - last_trade_time) > AUTO_COOLDOWN_SEC
            if not active_position and cooldown_elapsed and zm.buy_sig(price) and ec > ML_CONFIDENCE:
                # Math Confidence Check: Hurst says mean-reverting OR MACD confirms direction
                can_buy = (regime == "mean_reverting") or (regime == "random_walk" and macd_trend != "down")
                
                if can_buy:
                    # Kelly Sizing Logic
                    base_invest = INVESTMENT_AMOUNT
                    if USE_KELLY_SIZING and len(trade_history) >= 5:
                        win_rate = len([t for t in trade_history if t['profit'] > 0]) / len(trade_history)
                        avg_win = np.mean([t['profit'] for t in trade_history if t['profit'] > 0]) if win_rate > 0 else 0.15
                        avg_loss = abs(np.mean([t['profit'] for t in trade_history if t['profit'] <= 0])) if win_rate < 1 else 0.08
                        kelly_invest = kelly_position_size(base_invest, win_rate, avg_win, avg_loss)
                        # 🛡️ CAP: Never exceed base + 10%
                        max_allowed = base_invest * (1 + MAX_KELLY_INCREASE_PCT) 
                        actual_invest = min(kelly_invest, max_allowed)
                    else:
                        actual_invest = base_invest

                    amt = actual_invest / price
                    res = place_order('buy', amt, price)
                    if res and not res.get('error'):
                        active_position = True; entry_price = price; token_amount = amt; last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                        if ml: ml.record(ef, price, amt)
                        txid = "N/A"
                        try: txid = res.get('result', {}).get('txid', [])[0]
                        except: pass
                        print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="AUTO")

            # 5. Smart Sell (Optimal Stopping + ML Expectation)
            if active_position:
                target_profit, trailing_stop = calculate_dynamic_exit_threshold(list(price_history), entry_price)
                current_profit = calc_profit(entry_price, price, token_amount)
                
                # Exit triggers: Hits dynamic target OR breaks trailing stop (locks profit instantly)
                can_sell = False
                if current_profit >= target_profit: can_sell = True       
                elif price <= trailing_stop and current_profit > 0: can_sell = True 
                elif zm.sell_sig(price, entry_price, token_amount) and ee >= MIN_PROFIT: can_sell = True 
                
                if can_sell:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        trade_history.append({'profit': current_profit})
                        active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                        if ml: ml.record(ef, price, token_amount)
                        txid = "N/A"
                        try: txid = res.get('result', {}).get('txid', [])[0]
                        except: pass
                        print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")

            # 6. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount, calc_profit(entry_price, price, token_amount) if active_position else 0.0, last_trade_type, entry_price, aH, aL, aM, regime, hurst_val)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}"); time.sleep(10)

if __name__ == "__main__": main()