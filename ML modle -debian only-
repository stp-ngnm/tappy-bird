            current_profit = calculate_precise_profit(entry_price, price, token_amount)
            print(f"{COLOR_BLUE}Position: {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ ${entry_price:.4f}")
            print(f"{COLOR_MAGENTA}Current Profit: ${current_profit:.4f}{COLOR_RESET}")
        
        # ML Learning Loop
        ml_tick_count += 1
        if ML_ENABLED and ml_enhancer:
            if ml_tick_count % 10 == 0:
                features = ml_enhancer.extract_features(price_history, volume_history, orderbook_history)
                if features is not None:
                    ml_enhancer.training_features.append(features)
                    ml_enhancer.training_prices.append(price)
                    if len(ml_enhancer.training_features) > ML_ONLINE_BUFFER_SIZE:
                        ml_enhancer.training_features = ml_enhancer.training_features[-ML_ONLINE_BUFFER_SIZE:]
                        ml_enhancer.training_prices = ml_enhancer.training_prices[-ML_ONLINE_BUFFER_SIZE:]
            
            if ml_enhancer.models_trained and ml_tick_count % ML_RETRAIN_INTERVAL == 0:
                print(f"{COLOR_PURPLE}[ML] Periodic retraining triggered...{COLOR_RESET}")
                ml_enhancer.retrain_models()
            
            if not ml_enhancer.models_trained:
                if len(price_history) >= ML_FEATURE_WINDOW + ML_PRICE_PRED_HORIZON:
                    print(f"{COLOR_PURPLE}[ML] Sufficient live data. Training initial models...{COLOR_RESET}")
                    live_ohlc = []
                    for i, p in enumerate(price_history):
                        live_ohlc.append({
                            'timestamp': time.time() - (len(price_history) - i) * PRICE_CHECK_INTERVAL,
                            'open': p, 'high': p, 'low': p, 'close': p,
                            'volume': volume_history[i] if i < len(volume_history) else 1.0
                        })
                    ml_enhancer.train_initial_models(live_ohlc)

        time.sleep(PRICE_CHECK_INTERVAL)

    except KeyboardInterrupt:
        print("\n" + "="*60)
        print(f"{COLOR_MAGENTA}Entering configuration mode... (type 'q' to resume trading){COLOR_RESET}")
        print("="*60)
        while config_thread.is_alive():
            time.sleep(1)
        config_thread = threading.Thread(target=config_monitor, daemon=True)
        config_thread.start()
    except Exception as e:
        logging.error(f"Main loop error: {str(e)}")
        print(f"{COLOR_RED}Main loop error: {str(e)}{COLOR_RESET}")
        import traceback
        traceback.print_exc()
        time.sleep(20)