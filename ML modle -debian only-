    def retrain_models(self):
        if len(self.training_features) < ML_MIN_TRAIN_SAMPLES:
            if ML_VERBOSE_LOGGING:
                print(f"{COLOR_PURPLE}[ML] Skipping retrain — only {len(self.training_features)} samples{COLOR_RESET}")
            return
        
        print(f"{COLOR_PURPLE}[ML] Retraining models with {len(self.training_features)} new samples...{COLOR_RESET}")
        
        X = np.array(self.training_features)
        
        # FIX 1: Validate array shape BEFORE any transform
        if X.shape[0] == 0 or len(X.shape) != 2:
            print(f"{COLOR_RED}[ML] Invalid feature array shape: {X.shape}. Skipping retrain.{COLOR_RESET}")
            return
        
        # FIX 2: Fit scalers if not already fitted
        if not self.scalers_fitted:
            print(f"{COLOR_PURPLE}[ML] Scalers not fitted. Fitting now...{COLOR_RESET}")
            try:
                self.price_scaler.fit(X)
                self.volatility_scaler.fit(X)
                self.pattern_scaler.fit(X)
                self.timing_scaler.fit(X)
                self.scalers_fitted = True
            except Exception as e:
                print(f"{COLOR_RED}[ML] Scaler fit error: {str(e)}{COLOR_RESET}")
                return
        
        try:
            # FIX 3: Validate targets match features
            if len(self.training_prices) != X.shape[0]:
                print(f"{COLOR_RED}[ML] Feature/target mismatch. Skipping retrain.{COLOR_RESET}")
                return
            
            self.price_predictor.fit(self.price_scaler.transform(X), self.training_prices)
            self.volatility_predictor.fit(self.volatility_scaler.transform(X), self.training_volatility)
            self.pattern_classifier.fit(self.pattern_scaler.transform(X), self.training_patterns)
            timing_targets = [(self.training_prices[i] - X[i][4]) / (X[i][4] + 1e-10) for i in range(len(X))]
            self.timing_scorer.fit(self.timing_scaler.transform(X), timing_targets)
            
            self.models_trained = True  # FIX 4: Mark as trained
