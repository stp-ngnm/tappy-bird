    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}")
    
    while True:
        try:
            # ======== PAUSED STATE (Priority Input Loop) ========
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    continue
                
                if cmd == 'r': 
                    trading_paused = False
                    print(f"{PROF_P}▶️ RESUMED{RESET}")
                    continue
                elif cmd == 'q': 
                    print("👋 Exiting...")
                    sys.exit(0)
                elif cmd in ('b', 's'):
                    execute_manual(cmd)
                    continue
                else:
                    print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}")
                continue

            # ======== RUNNING STATE ========
            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 4)

            # 1. Fetch OHLC (Drives all parameters & zones)
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 10:
                # ✅ TRUE RANGE: Max/Min of the lookback window
                aH = np.max([x['high'] for x in ohlc])
                aL = np.min([x['low'] for x in ohlc])
                aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2)
                if not zm.buy_zone: zm.init(ohlc)
            else:
                aH = aL = aM = 0.0

            # 2. Trend Calculation (Display only)
            trend = "neutral"
            try:
                ho = get_ohlc(KRAKEN_PAIR, 60, 100)
                if ho: m, s, _ = calc_macd(ho); trend = "up" if m and s and m > s else "down"
            except: pass
            last_trend = trend

            # 3. Stop Loss Check
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                res = place_order('sell', token_amount, price, ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                if res and not res.get('error'):
                    txid = "N/A"
                    try:
                        txid_list = res.get('result', {}).get('txid', [])
                        if isinstance(txid_list, list) and len(txid_list) > 0:
                            txid = txid_list[0]
                    except: pass
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, txid=txid, trade_type="AUTO")
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # 4. ML Feature Extraction
            pos = {'active': active_position, 'entry': entry_price, 'time': last_trade_time}
            ef = ml.extract(price, zm, trend, get_order_book(KRAKEN_PAIR), pos) if ml else {}
            ec = ml.pred_entry(ef) if ml else 1.0  # 1.0 allows trading until ML trains
            ee = ml.pred_exit(ef) if ml else 0.0

            # 5. Auto BUY (Trend Independent + Zone Signal + ML Confidence)
            if not active_position and time.time() - last_trade_time > TRADE_MIN_INTERVAL:
                if zm.buy_sig(price) and ec > ML_CONFIDENCE:
                    a, e, sl = dyn_size(price, 'buy')
                    if a > 0 and (sl is None or sl <= MAX_SLIPPAGE_PCT):
                        res = place_order('buy', a, e or price)
                        if res and not res.get('error'):
                            active_position = True; entry_price = e or price; token_amount = a
                            last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                            txid = "N/A"
                            try:
                                txid_list = res.get('result', {}).get('txid', [])
                                if isinstance(txid_list, list) and len(txid_list) > 0:
                                    txid = txid_list[0]
                            except: pass
                            print_ticket("BUY", "SUCCESS", price, a, txid=txid, trade_type="AUTO")
                            if ml: ml.record(ef, e or price, e or price, a)

            # 6. Auto SELL (Trend Independent + Zone Signal + Min Profit + ML Expectation)
            if active_position:
                if zm.sell_sig(price, entry_price, token_amount) and ee >= MIN_PROFIT:
                    ob = get_order_book(KRAKEN_PAIR)
                    if ob:
                        f, ep, _, _ = simulate_fill('sell', token_amount, ob)
                        sl = abs(ep - price) / price if f else 1.0
                        if sum(v for _, v in ob['bids']) >= token_amount * MIN_LIQUIDITY_RATIO and sl <= MAX_SLIPPAGE_PCT:
                            res = place_order('sell', token_amount, ep)
                            if res and not res.get('error'):
                                active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                                txid = "N/A"
                                try:
                                    txid_list = res.get('result', {}).get('txid', [])
                                    if isinstance(txid_list, list) and len(txid_list) > 0:
                                        txid = txid_list[0]
                                except: pass
                                print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")
                                if ml: ml.record(ef, price, entry_price, token_amount)

            # 7. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount, calc_profit(entry_price, price, token_amount) if active_position else 0.0, last_trade_type, entry_price, aH, aL, aM)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}"); time.sleep(10)

if __name__ == "__main__": main()