    def predict_price(self, features):
        if not self.models_trained or features is None:
            return None
        try:
            X = self.price_scaler.transform(features.reshape(1, -1))
            return float(self.price_predictor.predict(X)[0])
        except:
            return None

    def predict_volatility(self, features):
        if not self.models_trained or features is None:
            return None
        try:
            X = self.volatility_scaler.transform(features.reshape(1, -1))
            return float(self.volatility_predictor.predict(X)[0])
        except:
            return None

    def predict_pattern(self, features):
        if not self.models_trained or features is None:
            return None, 0.0
        try:
            X = self.pattern_scaler.transform(features.reshape(1, -1))
            prediction = int(self.pattern_classifier.predict(X)[0])
            probabilities = self.pattern_classifier.predict_proba(X)[0]
            return prediction, float(np.max(probabilities))
        except:
            return None, 0.0

    def score_timing(self, features):
        if not self.models_trained or features is None:
            return 0.5
        try:
            X = self.timing_scaler.transform(features.reshape(1, -1))
            score = float(self.timing_scorer.predict(X)[0])
            return float(1 / (1 + np.exp(-score * 10)))
        except:
            return 0.5

    def calculate_risk_score(self, features, current_price, zone_status):
        if not self.models_trained or features is None:
            return 0.5
        try:
            pred_volatility = self.predict_volatility(features)
            volatility_risk = min(pred_volatility * 100, 1.0) if pred_volatility else 0.5
            pred_price = self.predict_price(features)
            direction_risk = (abs((pred_price - current_price) / current_price) * 10 if pred_price and current_price else 0.5)
            pattern, confidence = self.predict_pattern(features)
            confidence_risk = 1.0 - confidence if confidence else 1.0
            zone_risk = {"OUTSIDE": 0.8, "NEUTRAL": 0.5}.get(zone_status, 0.2)
            risk_score = (volatility_risk * 0.3 + direction_risk * 0.2 + confidence_risk * 0.3 + zone_risk * 0.2)
            return float(np.clip(risk_score, 0.0, 1.0))
        except:
            return 0.5

    def train_initial_models(self, historical_data):
        if len(historical_data) < ML_FEATURE_WINDOW + ML_PRICE_PRED_HORIZON:
            print(f"{COLOR_PURPLE}[ML] Insufficient historical data for training{COLOR_RESET}")
            return False
        
        print(f"{COLOR_PURPLE}[ML] Training on {len(historical_data)} real candles...{COLOR_RESET}")
        features_list = []
        price_targets, volatility_targets, pattern_targets = [], [], []
        
        for i in range(ML_FEATURE_WINDOW, len(historical_data) - ML_PRICE_PRED_HORIZON):
            window = historical_data[i-ML_FEATURE_WINDOW:i]
            prices = [x['close'] for x in window]
            volumes = [x['volume'] for x in window]
            ob_features = deque(maxlen=3)
            
            for j in range(i-ML_FEATURE_WINDOW, i):
                h, l, c = historical_data[j]['high'], historical_data[j]['low'], historical_data[j]['close']
                if c > 0:
                    buy_pressure = (h - c) / (c + 1e-8)
                    sell_pressure = (c - l) / (c + 1e-8)
                    imbalance = (buy_pressure - sell_pressure) / (buy_pressure + sell_pressure + 1e-8)
                else:
                    imbalance = 0.0
                ob_features.append({'bid_volume': max(0, imbalance + 1.0), 'ask_volume': max(0, 2.0 - imbalance)})
            
            features = self.extract_features(deque(prices, maxlen=ML_FEATURE_WINDOW), deque(volumes, maxlen=ML_FEATURE_WINDOW), ob_features)
            if features is None:
                continue
            
            features_list.append(features)
            future_price = historical_data[i + ML_PRICE_PRED_HORIZON]['close']
            price_targets.append(future_price)
            
            future_prices_list = [x['close'] for x in historical_data[i:i+ML_PRICE_PRED_HORIZON+1]]
            future_returns = np.diff(np.array(future_prices_list)) / (np.array(future_prices_list[:-1]) + 1e-10)
            volatility_targets.append(np.std(future_returns))
            
            current_price = prices[-1]
            if future_price > current_price * 1.005:
                pattern_targets.append(1)
            elif future_price < current_price * 0.995:
                pattern_targets.append(2)
            else:
                pattern_targets.append(0)
        
        if len(features_list) < 10:
            print(f"{COLOR_PURPLE}[ML] Insufficient feature samples for training{COLOR_RESET}")
            return False
        
        X = np.array(features_list)
        self.price_scaler.fit(X)
        self.volatility_scaler.fit(X)
        self.pattern_scaler.fit(X)
        
        self.price_predictor.fit(self.price_scaler.transform(X), price_targets)
        pred_prices = self.price_predictor.predict(self.price_scaler.transform(X))
        rmse = np.sqrt(mean_squared_error(price_targets, pred_prices))
        print(f"{COLOR_PURPLE}[ML] Price predictor trained. RMSE: ${rmse:.4f}{COLOR_RESET}")
        
        self.volatility_predictor.fit(self.volatility_scaler.transform(X), volatility_targets)
        self.pattern_classifier.fit(self.pattern_scaler.transform(X), pattern_targets)
        accuracy = self.pattern_classifier.score(self.pattern_scaler.transform(X), pattern_targets)
        print(f"{COLOR_PURPLE}[ML] Pattern classifier trained. Accuracy: {accuracy*100:.1f}%{COLOR_RESET}")
        
        timing_targets = [(price_targets[i] - X[i][4]) / (X[i][4] + 1e-10) for i in range(len(X))]
        self.timing_scaler.fit(X)
        self.timing_scorer.fit(self.timing_scaler.transform(X), timing_targets)
        
        self.models_trained = True
        self.scalers_fitted = True  # >>> FIX: Mark scalers as fitted
        return True

