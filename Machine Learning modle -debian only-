    def extract_features(self, price_hist, volume_hist, orderbook_hist):
        """Extract comprehensive features for ML models"""
        if len(price_hist) < ML_FEATURE_WINDOW:
            return None
            
        prices = np.array(list(price_hist)[-ML_FEATURE_WINDOW:])
        
        features = []
        
        # === PRICE-BASED FEATURES ===
        features.append(np.mean(prices))
        features.append(np.std(prices))
        features.append(np.max(prices))
        features.append(np.min(prices))
        features.append(prices[-1])
        features.append((prices[-1] - prices[0]) / prices[0])  # total return
        
        # Price percentiles
        features.append(np.percentile(prices, 25))
        features.append(np.percentile(prices, 75))
        
        # === MOMENTUM INDICATORS (multiple timeframes) ===
        for window in ML_MOMENTUM_WINDOWS:
            if len(prices) >= window * 2:
                recent_avg = np.mean(prices[-window:])
                previous_avg = np.mean(prices[-window*2:-window])
                features.append(recent_avg - previous_avg)
            else:
                features.append(0)
        
        # === VOLATILITY INDICATORS (multiple timeframes) ===
        for window in ML_VOLATILITY_WINDOWS:
            if len(prices) >= window:
                returns = np.diff(prices[-window:]) / prices[-window:-1]
                features.append(np.std(returns))
            else:
                features.append(0)
        
        # === TREND STRENGTH ===
        if len(prices) >= 3:
            x = np.arange(len(prices))
            z = np.polyfit(x, prices, 1)
            features.append(z[0])  # slope
            features.append(z[1])  # intercept
            # R-squared for trend strength
            p = np.poly1d(z)
            yhat = p(x)
            ybar = np.sum(prices) / len(prices)
            ssreg = np.sum((yhat - ybar)**2)
            sstot = np.sum((prices - ybar)**2)
            r_squared = ssreg / sstot if sstot != 0 else 0
            features.append(r_squared)
        else:
            features.extend([0, 0, 0])
        
        # === RSI ===
        if len(prices) >= ML_RSI_PERIOD + 1:
            deltas = np.diff(prices[-(ML_RSI_PERIOD+1):])
            gains = deltas[deltas > 0].sum()
            losses = abs(deltas[deltas < 0].sum())
            rs = gains / (losses + 1e-10)
            rsi = 100 - (100 / (1 + rs))
            features.append(rsi)
            # RSI momentum (current vs previous)
            if len(prices) >= ML_RSI_PERIOD * 2 + 1:
                prev_deltas = np.diff(prices[-(ML_RSI_PERIOD*2+1):-(ML_RSI_PERIOD+1)])
                prev_gains = prev_deltas[prev_deltas > 0].sum()
                prev_losses = abs(prev_deltas[prev_deltas < 0].sum())
                prev_rs = prev_gains / (prev_losses + 1e-10)
                prev_rsi = 100 - (100 / (1 + prev_rs))
                features.append(rsi - prev_rsi)
            else:
                features.append(0)
        else:
            features.extend([50, 0])
        
        # === MACD ===
        if len(prices) >= ML_MACD_SLOW:
            ema_fast = self._ema(prices, ML_MACD_FAST)
            ema_slow = self._ema(prices, ML_MACD_SLOW)
            macd_line = ema_fast - ema_slow
            features.append(macd_line)
            # MACD signal line (9-period EMA of MACD)
            if len(prices) >= ML_MACD_SLOW + 9:
                # Simplified: use current MACD vs average
                features.append(macd_line - np.mean([macd_line]))
            else:
                features.append(0)
        else:
            features.extend([0, 0])
        
        # === BOLLINGER BANDS ===
        if len(prices) >= ML_BOLLINGER_PERIOD:
            bb_middle = np.mean(prices[-ML_BOLLINGER_PERIOD:])
            bb_std = np.std(prices[-ML_BOLLINGER_PERIOD:])
            bb_upper = bb_middle + ML_BOLLINGER_STD * bb_std
            bb_lower = bb_middle - ML_BOLLINGER_STD * bb_std
            # Position within bands (0 = lower, 0.5 = middle, 1 = upper)
            bb_position = (prices[-1] - bb_lower) / (bb_upper - bb_lower) if bb_upper != bb_lower else 0.5
            features.append(bb_position)
            features.append(bb_std)  # band width
        else:
            features.extend([0.5, 0])
        
        # === VOLUME FEATURES ===
        if len(volume_hist) >= ML_FEATURE_WINDOW and ML_USE_VOLUME_PROFILE:
            volumes = np.array(list(volume_hist)[-ML_FEATURE_WINDOW:])
            features.append(np.mean(volumes))
            features.append(np.std(volumes))
            features.append(volumes[-1] / (np.mean(volumes) + 1e-10))  # volume ratio
            # Volume trend
            if len(volumes) >= 10:
                recent_vol = np.mean(volumes[-5:])
                previous_vol = np.mean(volumes[-10:-5])
                features.append(recent_vol / (previous_vol + 1e-10))
            else:
                features.append(1.0)
        else:
            features.extend([0, 0, 1, 1.0])
        
        # === ORDERBOOK FEATURES ===
        if len(orderbook_hist) >= 3 and ML_USE_ORDERBOOK_IMBALANCE:
            recent_ob = list(orderbook_hist)[-3:]
            bid_volumes = [ob.get('bid_volume', 0) for ob in recent_ob]
            ask_volumes = [ob.get('ask_volume', 0) for ob in recent_ob]
            avg_bid = np.mean(bid_volumes)
            avg_ask = np.mean(ask_volumes)
            features.append(avg_bid)
            features.append(avg_ask)
            # Bid-ask imbalance ratio
            imbalance = (avg_bid - avg_ask) / (avg_bid + avg_ask + 1e-10)
            features.append(imbalance)
            # Imbalance trend
            if len(orderbook_hist) >= 6:
                older_ob = list(orderbook_hist)[-6:-3]
                older_bid = np.mean([ob.get('bid_volume', 0) for ob in older_ob])
                older_ask = np.mean([ob.get('ask_volume', 0) for ob in older_ob])
                older_imbalance = (older_bid - older_ask) / (older_bid + older_ask + 1e-10)
                features.append(imbalance - older_imbalance)
            else:
                features.append(0)
        else:
            features.extend([0, 0, 0, 0])
        
        return np.array(features)
    
    def _ema(self, data, period):
        """Calculate Exponential Moving Average"""
        if len(data) < period:
            return np.mean(data)
        multiplier = 2 / (period + 1)
        ema = np.mean(data[:period])
        for price in data[period:]:
            ema = (price - ema) * multiplier + ema
        return ema
    
    def detect_market_regime(self, price_hist):
        """Detect if market is trending or ranging"""
        if not ML_DETECT_REGIME_CHANGE or len(price_hist) < 50:
            return "UNKNOWN", 0.0
        
        prices = np.array(list(price_hist)[-50:])
        
        # Calculate trend strength using linear regression
        x = np.arange(len(prices))
        z = np.polyfit(x, prices, 1)
        slope = z[0]
        p = np.poly1d(z)
        yhat = p(x)
        ybar = np.sum(prices) / len(prices)
        ssreg = np.sum((yhat - ybar)**2)
        sstot = np.sum((prices - ybar)**2)
        r_squared = ssreg / sstot if sstot != 0 else 0
        
        # Calculate volatility
        returns = np.diff(prices) / prices[:-1]
        volatility = np.std(returns)
        
        # Determine regime
        if r_squared > 0.6:  # Strong trend
            if slope > 0:
                regime = "TRENDING_UP"
            else:
                regime = "TRENDING_DOWN"
            confidence = r_squared
        elif r_squared < 0.3 and volatility < 0.02:  # Low trend, low volatility = ranging
            regime = "RANGING"
            confidence = 1 - r_squared
        else:
            regime = "TRANSITIONING"
            confidence = 0.5
        
        return regime, confidence
    
    def ensemble_vote(self, features, current_price, zone_status):
        """Combine multiple ML signals with weighted voting"""
        if not ML_USE_ENSEMBLE_VOTING or not self.models_trained or features is None:
            return None, 0.0
        
        votes = {'buy': 0.0, 'sell': 0.0, 'hold': 0.0}
        
        # Pattern classifier vote
        pattern, pattern_conf = self.predict_pattern(features)
        if pattern == 1:  # BUY
            votes['buy'] += ML_PATTERN_WEIGHT * pattern_conf
        elif pattern == 2:  # SELL
            votes['sell'] += ML_PATTERN_WEIGHT * pattern_conf
        else:  # HOLD
            votes['hold'] += ML_PATTERN_WEIGHT * pattern_conf
        
        # Price prediction vote
        pred_price = self.predict_price(features)
        if pred_price:
            price_change = (pred_price - current_price) / current_price
            if price_change > 0.01:  # Predicted 1%+ rise
                votes['buy'] += ML_PRICE_PRED_WEIGHT * min(abs(price_change) * 20, 1.0)
            elif price_change < -0.01:  # Predicted 1%+ fall
                votes['sell'] += ML_PRICE_PRED_WEIGHT * min(abs(price_change) * 20, 1.0)
            else:
                votes['hold'] += ML_PRICE_PRED_WEIGHT
        
        # Timing scorer vote
        timing = self.score_timing(features)
        if timing > 0.7:
            # Good timing enhances existing votes
            if zone_status == "BUY":
                votes['buy'] += ML_TIMING_WEIGHT * timing
            elif zone_status == "SELL":
                votes['sell'] += ML_TIMING_WEIGHT * timing
        else:
            votes['hold'] += ML_TIMING_WEIGHT * (1 - timing)
        
        # Risk score vote
        risk = self.calculate_risk_score(features, current_price, zone_status)
        if risk < 0.3:  # Low risk
            # Enhances buy signals in low risk
            if zone_status in ["BUY", "NEUTRAL"]:
                votes['buy'] += ML_RISK_WEIGHT * (1 - risk)
        elif risk > 0.7:  # High risk
            # Suggests caution/sell
            votes['sell'] += ML_RISK_WEIGHT * risk
            votes['hold'] += ML_RISK_WEIGHT * risk * 0.5
        
        # Determine winner
        winner = max(votes, key=votes.get)
        confidence = votes[winner] / sum(votes.values()) if sum(votes.values()) > 0 else 0.0
        
        return winner, confidence
    
    def update_adaptive_thresholds(self, prediction_accuracy):
        """Adjust thresholds based on recent prediction accuracy"""
        if not ML_ADAPTIVE_THRESHOLDS:
            return
        
        # If predictions are accurate, become more aggressive
        if prediction_accuracy > 0.7:
            self.adaptive_min_confidence = max(ML_MIN_CONFIDENCE - 0.05, 0.50)
            self.adaptive_risk_threshold = min(ML_MAX_RISK_THRESHOLD + 0.05, 0.80)
        # If predictions are poor, become more conservative
        elif prediction_accuracy < 0.5:
            self.adaptive_min_confidence = min(ML_MIN_CONFIDENCE + 0.10, 0.75)
            self.adaptive_risk_threshold = max(ML_MAX_RISK_THRESHOLD - 0.10, 0.55)
        
        if ML_VERBOSE_LOGGING:
            print(f"{COLOR_PURPLE}[ML] Adaptive thresholds updated: min_conf={self.adaptive_min_confidence:.2f}, max_risk={self.adaptive_risk_threshold:.2f}{COLOR_RESET}")
    
    def track_prediction_accuracy(self, actual_price):
        """Track prediction accuracy for adaptive learning"""
        if not ML_SAVE_PREDICTIONS or len(self.prediction_history) == 0:
            return 0.0
        
        # Check predictions that should have materialized by now
        correct = 0
        total = 0
        
        for pred_record in self.prediction_history:
            if pred_record['mature']:
                continue  # Already evaluated
            
            # Check if enough time has passed
            ticks_elapsed = ml_tick_count - pred_record['tick']
            if ticks_elapsed >= ML_PRICE_PRED_HORIZON:
                pred_record['mature'] = True
                pred_price = pred_record['predicted_price']
                direction_correct = False
                
                if pred_price > pred_record['current_price'] * 1.001:  # Predicted rise
                    if actual_price > pred_record['current_price']:
                        direction_correct = True
                elif pred_price < pred_record['current_price'] * 0.999:  # Predicted fall
                    if actual_price < pred_record['current_price']:
                        direction_correct = True
                
                if direction_correct:
                    correct += 1
                total += 1
        
        if total > 0:
            accuracy = correct / total
            self.update_adaptive_thresholds(accuracy)
            return accuracy
        
        return 0.0
    
    def train_initial_models(self, historical_data):
        """Train models on historical data for baseline"""
        if len(historical_data) < ML_FEATURE_WINDOW + ML_PRICE_PRED_HORIZON:
            print(f"{COLOR_PURPLE}[ML] Insufficient historical data for training{COLOR_RESET}")
            return False
            
        print(f"{COLOR_PURPLE}[ML] Training models on {len(historical_data)} historical candles...{COLOR_RESET}")
        
        features_list = []
        price_targets = []
        volatility_targets = []
        pattern_targets = []
        
        for i in range(ML_FEATURE_WINDOW, len(historical_data) - ML_PRICE_PRED_HORIZON):
            window = historical_data[i-ML_FEATURE_WINDOW:i]
            prices = [x['close'] for x in window]
            
            # Mock volume and orderbook for historical data
            volumes = [1.0] * len(prices)
            orderbooks = [{'bid_volume': 1.0, 'ask_volume': 1.0}] * len(prices)
            
            features = self.extract_features(
                deque(prices, maxlen=ML_FEATURE_WINDOW),
                deque(volumes, maxlen=ML_FEATURE_WINDOW),
                deque(orderbooks, maxlen=3)
            )
            
            if features is not None:
                features_list.append(features)
                
                # Price target (future price)
                future_price = historical_data[i + ML_PRICE_PRED_HORIZON]['close']
                price_targets.append(future_price)
                
                # Volatility target (future volatility)
                future_window = historical_data[i:i+ML_PRICE_PRED_HORIZON+1]
                future_prices = [x['close'] for x in future_window]
                future_returns = np.diff(future_prices) / future_prices[:-1]
                volatility_targets.append(np.std(future_returns))
                
                # Pattern target (0=hold, 1=buy, 2=sell)
                current_price = prices[-1]
                if future_price > current_price * 1.005:
                    pattern_targets.append(1)  # buy signal
                elif future_price < current_price * 0.995:
                    pattern_targets.append(2)  # sell signal
                else:
                    pattern_targets.append(0)  # hold
        
        if len(features_list) < 10:
            print(f"{COLOR_PURPLE}[ML] Insufficient feature samples for training{COLOR_RESET}")
            return False
        
        X = np.array(features_list)
        
        # Train price predictor
        X_scaled = self.price_scaler.fit_transform(X)
        self.price_predictor.fit(X_scaled, price_targets)
        pred_prices = self.price_predictor.predict(X_scaled)
        rmse = np.sqrt(mean_squared_error(price_targets, pred_prices))
        print(f"{COLOR_PURPLE}[ML] Price predictor trained. RMSE: ${rmse:.4f}{COLOR_RESET}")
        
        # Train volatility predictor
        X_scaled = self.volatility_scaler.fit_transform(X)
        self.volatility_predictor.fit(X_scaled, volatility_targets)
        print(f"{COLOR_PURPLE}[ML] Volatility predictor trained{COLOR_RESET}")
        
        # Train pattern classifier
        X_scaled = self.pattern_scaler.fit_transform(X)
        self.pattern_classifier.fit(X_scaled, pattern_targets)
        accuracy = self.pattern_classifier.score(X_scaled, pattern_targets)
        print(f"{COLOR_PURPLE}[ML] Pattern classifier trained. Accuracy: {accuracy*100:.1f}%{COLOR_RESET}")
        
        # Train timing scorer (use future return as target)
        timing_targets = [(price_targets[i] - X[i][4]) / X[i][4] for i in range(len(X))]
        X_scaled = self.timing_scaler.fit_transform(X)
        self.timing_scorer.fit(X_scaled, timing_targets)
        print(f"{COLOR_PURPLE}[ML] Timing scorer trained{COLOR_RESET}")
        
        self.models_trained = True
        return True
    
    def update_models_online(self, features, actual_price, actual_volatility, actual_pattern):
        """Update models with new live data"""
        self.training_features.append(features)
        self.training_prices.append(actual_price)
        self.training_volatility.append(actual_volatility)
        self.training_patterns.append(actual_pattern)
        
        # Keep only recent samples for online learning (configured buffer)
        if len(self.training_features) > ML_ONLINE_BUFFER_SIZE:
            self.training_features = self.training_features[-ML_ONLINE_BUFFER_SIZE:]
            self.training_prices = self.training_prices[-ML_ONLINE_BUFFER_SIZE:]
            self.training_volatility = self.training_volatility[-ML_ONLINE_BUFFER_SIZE:]
            self.training_patterns = self.training_patterns[-ML_ONLINE_BUFFER_SIZE:]
    
    def retrain_models(self):
        """Retrain all models with accumulated online data"""
        if len(self.training_features) < ML_MIN_TRAIN_SAMPLES:
            if ML_VERBOSE_LOGGING:
                print(f"{COLOR_PURPLE}[ML] Skipping retrain - only {len(self.training_features)} samples (need {ML_MIN_TRAIN_SAMPLES}){COLOR_RESET}")
            return
            
        print(f"{COLOR_PURPLE}[ML] Retraining models with {len(self.training_features)} new samples...{COLOR_RESET}")
        
        X = np.array(self.training_features)
        
        try:
            # Retrain price predictor
            X_scaled = self.price_scaler.transform(X)
            self.price_predictor.fit(X_scaled, self.training_prices)
            
            # Retrain volatility predictor
            X_scaled = self.volatility_scaler.transform(X)
            self.volatility_predictor.fit(X_scaled, self.training_volatility)
            
            # Retrain pattern classifier
            X_scaled = self.pattern_scaler.transform(X)
            self.pattern_classifier.fit(X_scaled, self.training_patterns)
            
            # Retrain timing scorer
            timing_targets = [(self.training_prices[i] - X[i][4]) / X[i][4] for i in range(len(X))]
            X_scaled = self.timing_scaler.transform(X)
            self.timing_scorer.fit(X_scaled, timing_targets)
            
            print(f"{COLOR_PURPLE}[ML] Models retrained successfully{COLOR_RESET}")
            
            # Log feature importance if enabled
            if ML_LOG_FEATURE_IMPORTANCE:
                self._log_feature_importance()
                
        except Exception as e:
            logging.error(f"[ML] Retraining error: {str(e)}")
    
    def _log_feature_importance(self):
        """Log feature importance from random forest models"""
        try:
            price_importance = self.price_predictor.feature_importances_
            top_5_idx = np.argsort(price_importance)[-5:]
            print(f"{COLOR_PURPLE}[ML] Top 5 Price Prediction Features: {top_5_idx} with importance {price_importance[top_5_idx]}{COLOR_RESET}")
        except Exception as e:
            logging.warning(f"[ML] Could not log feature importance: {str(e)}")
    
    def predict_price(self, features):
        """Predict future price"""
        if not self.models_trained or features is None:
            return None
        try:
            X = features.reshape(1, -1)
            X_scaled = self.price_scaler.transform(X)
            prediction = self.price_predictor.predict(X_scaled)[0]
            return float(prediction)
        except Exception as e:
            logging.error(f"[ML] Price prediction error: {str(e)}")
            return None
    
    def predict_volatility(self, features):
        """Predict future volatility"""
        if not self.models_trained or features is None:
            return None
        try:
            X = features.reshape(1, -1)
            X_scaled = self.volatility_scaler.transform(X)
            prediction = self.volatility_predictor.predict(X_scaled)[0]
            return float(prediction)
        except Exception as e:
            logging.error(f"[ML] Volatility prediction error: {str(e)}")
            return None
    
    def predict_pattern(self, features):
        """Predict buy/sell/hold pattern with confidence"""
        if not self.models_trained or features is None:
            return None, 0.0
        try:
            X = features.reshape(1, -1)
            X_scaled = self.pattern_scaler.transform(X)
            prediction = self.pattern_classifier.predict(X_scaled)[0]
            probabilities = self.pattern_classifier.predict_proba(X_scaled)[0]
            confidence = np.max(probabilities)
            return int(prediction), float(confidence)
        except Exception as e:
            logging.error(f"[ML] Pattern prediction error: {str(e)}")
            return None, 0.0
    
    def score_timing(self, features):
        """Score optimal timing for trade execution (higher = better)"""
        if not self.models_trained or features is None:
            return 0.5
        try:
            X = features.reshape(1, -1)
            X_scaled = self.timing_scaler.transform(X)
            score = self.timing_scorer.predict(X_scaled)[0]
            # Normalize to 0-1 range
            normalized = 1 / (1 + np.exp(-score * 10))  # sigmoid
            return float(normalized)
        except Exception as e:
            logging.error(f"[ML] Timing score error: {str(e)}")
            return 0.5
    
    def calculate_risk_score(self, features, current_price, zone_status):
        """Calculate comprehensive risk score (0-1, lower = safer)"""
        if not self.models_trained or features is None:
            return 0.5
            
        try:
            # Predict volatility
            pred_volatility = self.predict_volatility(features)
            if pred_volatility is None:
                volatility_risk = 0.5
            else:
                # High volatility = high risk
                volatility_risk = min(pred_volatility * 100, 1.0)
            
            # Predict price direction
            pred_price = self.predict_price(features)
            if pred_price is None:
                direction_risk = 0.5
            else:
                price_change = abs(pred_price - current_price) / current_price
                direction_risk = min(price_change * 10, 1.0)
            
            # Pattern confidence (low confidence = high risk)
            pattern, confidence = self.predict_pattern(features)
            confidence_risk = 1.0 - confidence
            
            # Zone risk (OUTSIDE = high risk)
            if zone_status == "OUTSIDE":
                zone_risk = 0.8
            elif zone_status == "NEUTRAL":
                zone_risk = 0.5
            else:
                zone_risk = 0.2
            
            # Weighted combination
            risk_score = (
                volatility_risk * 0.3 +
                direction_risk * 0.2 +
                confidence_risk * 0.3 +
                zone_risk * 0.2
            )
            
            return float(np.clip(risk_score, 0.0, 1.0))
            
        except Exception as e:
            logging.error(f"[ML] Risk score error: {str(e)}")
            return 0.5


