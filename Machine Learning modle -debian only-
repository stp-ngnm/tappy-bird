class BestValueZoneMachine4Dec:
    def __init__(self, pair):
        self.pair = pair
        self.zone_initialized = False
        self.buy_zone = None
        self.neutral_zone = None
        self.sell_zone = None
        self.median = None
        self.zone_set_time = None
        self.in_sell_zone = False
        self.sell_highs = []
        self.sell_lows = []
        self.best_sell_price = None
        self.max_avg_high_seen = None
        self.in_buy_zone = False
        self.buy_highs = []
        self.buy_lows = []
        self.best_buy_price = None
        self.min_avg_low_seen = None

    def initialize_zones(self, use_bollinger=False):
        print(f"{COLOR_CYAN}Calculating Zones...{COLOR_RESET}")
        ohlc_data = get_ohlc(self.pair, interval=1, lookback=MEDIAN_LOOKBACK)
        if not ohlc_data or len(ohlc_data) < 10:
            print(f"{COLOR_RED}Insufficient OHLC data for zone calculation!{COLOR_RESET}")
            return False

        if use_bollinger:
            closes = np.array([row['close'] for row in ohlc_data[-20:] if row.get('close') is not None])
            if len(closes) < 20:
                print(f"{COLOR_RED}Insufficient data for Bollinger zones!{COLOR_RESET}")
                return False
            sma = np.mean(closes)
            std = np.std(closes)
            upper = sma + 2 * std
            lower = sma - 2 * std
            self.median = float(np.mean([lower, upper]))
            neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
            neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
            self.neutral_zone = (neutral_lower, neutral_upper)
            self.buy_zone = (round(lower, 4), neutral_lower)
            self.sell_zone = (neutral_upper, round(upper, 4))
        else:
            highs = np.array([x['high'] for x in ohlc_data])
            lows = np.array([x['low'] for x in ohlc_data])
            self.median = float((np.median(highs) + np.median(lows)) / 2)
            neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
            neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
            self.neutral_zone = (neutral_lower, neutral_upper)
            self.buy_zone = (round(neutral_lower - BUY_ZONE_EXTRA, 4), neutral_lower)
            self.sell_zone = (neutral_upper, round(neutral_upper + SELL_ZONE_EXTRA, 4))

        self.zone_initialized = True
        self.zone_set_time = time.time()
        self.sell_highs = []
        self.sell_lows = []
        self.buy_highs = []
        self.buy_lows = []
        self.in_sell_zone = False
        self.in_buy_zone = False
        self.best_sell_price = None
        self.best_buy_price = None
        self.max_avg_high_seen = None
        self.min_avg_low_seen = None

        print(f"{COLOR_MAGENTA}=== ZONES INITIALIZED ==={COLOR_RESET}")
        print(f"Median:      ${self.median:.4f}")
        print(f"Buy Zone:    [${self.buy_zone[0]:.4f} - ${self.buy_zone[1]:.4f}]")
        print(f"Neutral Zone:[${self.neutral_zone[0]:.4f} - ${self.neutral_zone[1]:.4f}]")
        print(f"Sell Zone:   [${self.sell_zone[0]:.4f} - ${self.sell_zone[1]:.4f}]")
        print(f"{COLOR_MAGENTA}========================={COLOR_RESET}")

    def price_zone(self, price):
        if price is None:
            return "INVALID"
        if self.buy_zone and self.buy_zone[0] <= price < self.buy_zone[1]:
            return "BUY"
        elif self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]:
            return "NEUTRAL"
        elif self.sell_zone and self.sell_zone[0] < price <= self.sell_zone[1]:
            return "SELL"
        else:
            return "OUTSIDE"

    def zones_expired(self, price):
        global outside_zone_since
        zone_status = self.price_zone(price)
        now = time.time()
        if zone_status == "OUTSIDE":
            if outside_zone_since is None:
                outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME:
                print(f"{COLOR_YELLOW}Price outside all zones for >{ZONE_RESET_HOLD_TIME} seconds. Resetting zones...{COLOR_RESET}")
                outside_zone_since = None
                return True
        else:
            outside_zone_since = None
        return False

    def track_best_sell(self, price, entry_price, token_amount):
        if price is None:
            return None

        zone = self.price_zone(price)

        if zone == "SELL":
            self.sell_highs.append(price)
            self.sell_lows.append(price)
            if not self.in_sell_zone:
                self.in_sell_zone = True
                self.best_sell_price = price
                self.max_avg_high_seen = np.mean(self.sell_highs) if self.sell_highs else price
                if DEBUG:
                    print(f"{COLOR_BLUE}Entered SELL zone. Tracking highs. initial avg_high={self.max_avg_high_seen:.4f}{COLOR_RESET}")
            else:
                if price > self.best_sell_price:
                    self.best_sell_price = price
                avg_high = np.mean(self.sell_highs) if self.sell_highs else self.best_sell_price
                if self.max_avg_high_seen is None or avg_high > self.max_avg_high_seen:
                    self.max_avg_high_seen = avg_high
                    if DEBUG:
                        print(f"{COLOR_BLUE}New max_avg_high_seen: ${self.max_avg_high_seen:.4f}{COLOR_RESET}")

            if SELL_AT_HIGHEST_AVERAGE and self.max_avg_high_seen is not None:
                lower_thr = self.max_avg_high_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.max_avg_high_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr:
                    if DEBUG:
                        print(f"{COLOR_GREEN}SELL range condition met: price ${price:.4f} in [{lower_thr:.4f}, {upper_thr:.4f}]. Signaling sell at ref ${self.max_avg_high_seen:.4f}{COLOR_RESET}")
                    return float(self.max_avg_high_seen)
            return None

        else:
            if self.in_sell_zone:
                avg_high = np.mean(self.sell_highs) if self.sell_highs else None
                avg_low = np.mean(self.sell_lows) if self.sell_lows else None
                best_profit = calculate_precise_profit(entry_price, self.best_sell_price, token_amount)
