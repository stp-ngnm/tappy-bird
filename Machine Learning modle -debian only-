        receipt = f"[TRADE] BUY | Price: ${ref_price:.4f} | Zone: {zone_status} | Best Ref: ${best_zone_ref:.4f} | Exec: ${exec_price:.4f} (slip: {slippage_pct*100:+.2f}%) | Fee: ${fee_usd:.4f}"
    elif side == 'sell' and entry_for_profit is not None:
        profit = calculate_precise_profit(entry_for_profit, exec_price or ref_price, amount)
        receipt = f"[TRADE] SELL | Price: ${ref_price:.4f} | Zone: {zone_status} | Best Ref: ${best_zone_ref:.4f} | Exec: ${exec_price:.4f} (slip: {slippage_pct*100:+.2f}%) | Entry: ${entry_for_profit:.4f} | Profit: ${profit:.4f}"
    else:
        receipt = f"[TRADE] SELL | Price: ${ref_price:.4f} | Exec: ${exec_price or ref_price:.4f}"
        
    logging.info(receipt)
    print(f"{COLOR_BLUE}{receipt}{COLOR_RESET}")
    print("-" * 60)

