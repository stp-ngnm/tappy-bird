                                    print(f"{COLOR_RED}Sell error: {order_result['error']}{COLOR_RESET}")
                                else:
                                    print(f"{COLOR_GREEN}Sold {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ approx ${depth_info['exec_price']:.4f}{COLOR_RESET}")
                                    print(f"{COLOR_GREEN}Entry: ${entry_price:.4f} | Exit: ${depth_info['exec_price']:.4f} | Profit: ${best_profit:.4f}{COLOR_RESET}")
                                    if ml_override_sell:
                                        print(f"{COLOR_PURPLE}[ML] Trade executed based on ML signal{COLOR_RESET}")
                                    active_position = False
                                    position_investment = 0
                                    last_trade_time = now
                    else:
                        logging.info(f"Auto-sell waiting for trend down or ML override (current trend={trend})")

        # Per-tick active position profit log
        if active_position:
            current_profit = calculate_precise_profit(entry_price, price, token_amount)
            print(f"{COLOR_BLUE}Position: {token_amount:.{BOND_DECIMALS}f} {TRADING_PAIR} @ ${entry_price:.4f}")
            print(f"{COLOR_MAGENTA}Current Profit: ${current_profit:.4f}{COLOR_RESET}")

        # ML model management
        ml_tick_count += 1
        
        # Retrain models periodically
        if ML_ENABLED and ml_enhancer and ml_enhancer.models_trained and ml_tick_count % ML_RETRAIN_INTERVAL == 0:
            print(f"{COLOR_PURPLE}[ML] Periodic retraining triggered (tick {ml_tick_count})...{COLOR_RESET}")
            ml_enhancer.retrain_models()
        
        # Train initial models if not yet trained but enough data collected
        if ML_ENABLED and ml_enhancer and not ml_enhancer.models_trained:
            if len(price_history) >= ML_FEATURE_WINDOW + ML_PRICE_PRED_HORIZON:
                print(f"{COLOR_PURPLE}[ML] Sufficient live data collected. Training initial models...{COLOR_RESET}")
                # Convert live data to OHLC-like format for training
                live_ohlc = []
                for i in range(len(price_history)):
                    live_ohlc.append({
                        'timestamp': time.time() - (len(price_history) - i) * PRICE_CHECK_INTERVAL,
                        'open': price_history[i],
                        'high': price_history[i],
                        'low': price_history[i],
                        'close': price_history[i],
                        'volume': volume_history[i] if i < len(volume_history) else 1.0
                    })
                ml_enhancer.train_initial_models(live_ohlc)

        time.sleep(PRICE_CHECK_INTERVAL)

    except KeyboardInterrupt:
        print("\n\n" + "="*60)
        print(f"{COLOR_MAGENTA}Entering configuration mode... (type 'q' to resume trading){COLOR_RESET}")
        print("="*60)
        while config_thread.is_alive():
            time.sleep(1)
        config_thread = threading.Thread(target=config_monitor, daemon=True)
        config_thread.start()

    except Exception as e:
        logging.error(f"Main loop error: {str(e)}")
        print(f"{COLOR_RED}Main loop error: {str(e)}{COLOR_RESET}")
        import traceback
        traceback.print_exc()
        time.sleep(30)
