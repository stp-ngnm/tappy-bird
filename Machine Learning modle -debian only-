class BestValueZoneMachine4Dec:
    def __init__(self, pair):
        self.pair = pair
        self.zone_initialized = False
        self.buy_zone = None
        self.neutral_zone = None
        self.sell_zone = None
        self.median = None
        self.in_sell_zone = False
        self.sell_highs = []
        self.best_sell_price = None
        self.max_avg_high_seen = None
        self.in_buy_zone = False
        self.buy_highs = []
        self.buy_lows = []
        self.best_buy_price = None
        self.min_avg_low_seen = None

    def initialize_zones(self, use_bollinger=False):
        print(f"{COLOR_CYAN}Calculating Zones...{COLOR_RESET}")
        ohlc_data = get_ohlc(self.pair, interval=1, lookback=MEDIAN_LOOKBACK)
        if not ohlc_data or len(ohlc_data) < 10:
            print(f"{COLOR_RED}Insufficient OHLC data for zone calculation!{COLOR_RESET}")
            return False
            
        highs = np.array([x['high'] for x in ohlc_data])
        lows = np.array([x['low'] for x in ohlc_data])
        self.median = float((np.median(highs) + np.median(lows)) / 2)
        neutral_lower = round(self.median - ZONE_BUFFER / 2, 4)
        neutral_upper = round(self.median + ZONE_BUFFER / 2, 4)
        self.neutral_zone = (neutral_lower, neutral_upper)
        self.buy_zone = (round(neutral_lower - BUY_ZONE_EXTRA, 4), neutral_lower)
        self.sell_zone = (neutral_upper, round(neutral_upper + SELL_ZONE_EXTRA, 4))
            
        self.zone_initialized = True
        print(f"{COLOR_MAGENTA}=== ZONES INITIALIZED ==={COLOR_RESET}")
        print(f"Median: ${self.median:.4f}")
        print(f"Buy: [{self.buy_zone[0]:.4f}-{self.buy_zone[1]:.4f}]")
        print(f"Nutral: [{self.neutral_zone[0]:.2f}-{self.neutral_zone[1]:.2f}]") 
        print(f"Sell: [{self.sell_zone[0]:.4f}-{self.sell_zone[1]:.4f}]")

    def price_zone(self, price):
        if price is None: return "INVALID"
        if self.buy_zone and self.buy_zone[0] <= price < self.buy_zone[1]: return "BUY"
        elif self.neutral_zone and self.neutral_zone[0] <= price <= self.neutral_zone[1]: return "NEUTRAL"
        elif self.sell_zone and self.sell_zone[0] < price <= self.sell_zone[1]: return "SELL"
        else: return "OUTSIDE"

    def track_best_sell(self, price, entry_price, token_amount):
        if price is None: return None
        zone = self.price_zone(price)
        if zone == "SELL":
            self.sell_highs.append(price)
            if not self.in_sell_zone:
                self.in_sell_zone = True
                self.best_sell_price = price
                self.max_avg_high_seen = np.mean(self.sell_highs) if self.sell_highs else price
            else:
                if price > self.best_sell_price: self.best_sell_price = price
                avg_high = np.mean(self.sell_highs) if self.sell_highs else self.best_sell_price
                if self.max_avg_high_seen is None or avg_high > self.max_avg_high_seen:
                    self.max_avg_high_seen = avg_high
            if SELL_AT_HIGHEST_AVERAGE and self.max_avg_high_seen is not None:
                lower_thr = self.max_avg_high_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.max_avg_high_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr: return float(self.max_avg_high_seen)
        else:
            if self.in_sell_zone:
                best_profit = calculate_precise_profit(entry_price, self.best_sell_price, token_amount)
                self.in_sell_zone = False
                self.sell_highs = []
                self.max_avg_high_seen = None
                if best_profit is not None and best_profit >= MIN_PROFIT: return float(self.best_sell_price)
        return None

    def track_best_buy(self, price):
        if price is None: return None
        zone = self.price_zone(price)
        if zone == "BUY":
            self.buy_highs.append(price)
            self.buy_lows.append(price)
            if not self.in_buy_zone:
                self.in_buy_zone = True
                self.best_buy_price = price
                self.min_avg_low_seen = np.mean(self.buy_lows) if self.buy_lows else price
            else:
                if price < self.best_buy_price: self.best_buy_price = price
                avg_low = np.mean(self.buy_lows) if self.buy_lows else self.best_buy_price
                if self.min_avg_low_seen is None or avg_low < self.min_avg_low_seen:
                    self.min_avg_low_seen = avg_low
            if BUY_AT_LOWEST_AVERAGE and self.min_avg_low_seen is not None:
                lower_thr = self.min_avg_low_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.min_avg_low_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr: return float(self.min_avg_low_seen)
        else:
            if self.in_buy_zone:
                self.in_buy_zone = False
                self.buy_highs = []
                self.buy_lows = []
                tmp = self.min_avg_low_seen
                self.min_avg_low_seen = None
                if tmp is not None and tmp < np.mean(self.buy_zone): return float(tmp)
        return None

def log_trade_receipt(side, amount, zone_status, best_zone_ref, exec_price, ref_price, slippage_pct, entry_for_profit=None):
    fee_usd = amount * (exec_price or ref_price) * FEE_RATE
    
