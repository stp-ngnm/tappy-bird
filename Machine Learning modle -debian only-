            min_samples_split=ML_PATTERN_MIN_SAMPLES_SPLIT, random_state=42)
        self.timing_scorer = RandomForestRegressor(
            n_estimators=ML_TIMING_N_ESTIMATORS, max_depth=ML_TIMING_MAX_DEPTH,
            min_samples_split=ML_TIMING_MIN_SAMPLES_SPLIT, random_state=42, n_jobs=-1)
        
        self.price_scaler = StandardScaler()
        self.volatility_scaler = StandardScaler()
        self.pattern_scaler = StandardScaler()
        self.timing_scaler = StandardScaler()
        
        self.training_features = []
        self.training_prices = []
        self.training_volatility = []
        self.training_patterns = []
        self.models_trained = False
        
        self.prediction_history = deque(maxlen=ML_PREDICTION_HISTORY_SIZE)
        self.adaptive_min_confidence = ML_MIN_CONFIDENCE
        self.adaptive_risk_threshold = ML_MAX_RISK_THRESHOLD

    def extract_features(self, price_hist, volume_hist, orderbook_hist):
        if len(price_hist) < ML_FEATURE_WINDOW: return None
        prices = np.array(list(price_hist)[-ML_FEATURE_WINDOW:])
        features = []
        features.extend([np.mean(prices), np.std(prices), np.max(prices), np.min(prices), prices[-1],
                         (prices[-1] - prices[0]) / (prices[0] + 1e-10)])
        features.extend([np.percentile(prices, p) for p in [25, 75]])
        
        for window in ML_MOMENTUM_WINDOWS:
            if len(prices) >= window * 2:
                recent_avg = np.mean(prices[-window:])
                prev_avg = np.mean(prices[-window*2:-window])
                features.append(recent_avg - prev_avg)
            else: features.append(0)
                
        for window in ML_VOLATILITY_WINDOWS:
            if len(prices) >= window:
                returns = np.diff(prices[-window:]) / (prices[-window:-1] + 1e-10)
                features.append(np.std(returns))
            else: features.append(0)
            
        if len(prices) >= 3:
            x = np.arange(len(prices))
            z = np.polyfit(x, prices, 1)
            p = np.poly1d(z)
            yhat, ybar = p(x), np.mean(prices)
            ssreg = np.sum((yhat - ybar)**2)
            sstot = np.sum((prices - ybar)**2)
            r_squared = ssreg / (sstot + 1e-10)
            features.extend([z[0], z[1], r_squared])
        else: features.extend([0, 0, 0])
            
        if len(prices) >= ML_RSI_PERIOD + 1:
            deltas = np.diff(prices[-(ML_RSI_PERIOD+1):])
            gains = deltas[deltas > 0].sum()
            losses = abs(deltas[deltas < 0].sum())
            rs = gains / (losses + 1e-10)
            rsi = 100 - (100 / (1 + rs))
            features.append(rsi)
        else: features.extend([50, 0])
            
        if len(prices) >= ML_MACD_SLOW:
            ema_fast = self._ema(prices, ML_MACD_FAST)
            ema_slow = self._ema(prices, ML_MACD_SLOW)
            macd_line = ema_fast - ema_slow
            features.extend([macd_line, 0])
        else: features.extend([0, 0])
            
        if len(prices) >= ML_BOLLINGER_PERIOD:
            bb_middle = np.mean(prices[-ML_BOLLINGER_PERIOD:])
            bb_std = np.std(prices[-ML_BOLLINGER_PERIOD:])
            bb_upper = bb_middle + ML_BOLLINGER_STD * bb_std
            bb_lower = bb_middle - ML_BOLLINGER_STD * bb_std
            bb_position = (prices[-1] - bb_lower) / (bb_upper - bb_lower + 1e-10)
            features.extend([bb_position, bb_std])
        else: features.extend([0.5, 0])
            
        if len(volume_hist) >= ML_FEATURE_WINDOW and ML_USE_VOLUME_PROFILE:
            volumes = np.array(list(volume_hist)[-ML_FEATURE_WINDOW:])
            features.extend([np.mean(volumes), np.std(volumes), volumes[-1] / (np.mean(volumes) + 1e-10)])
        else: features.extend([0, 0, 1.0])
            
        if ML_USE_ORDERBOOK_IMBALANCE and len(orderbook_hist) >= 3:
            ob = list(orderbook_hist)[-3:]
            bid_vols = [o.get('bid_volume', 1.0) for o in ob]
            ask_vols = [o.get('ask_volume', 1.0) for o in ob]
            avg_bid, avg_ask = np.mean(bid_vols), np.mean(ask_vols)
            imbalance = (avg_bid - avg_ask) / (avg_bid + avg_ask + 1e-10)
            features.extend([avg_bid, avg_ask, imbalance])
        else: features.extend([0, 0, 0])
            
        return np.array(features)

    def _ema(self, data, period):
        if len(data) < period: return np.mean(data)
        multiplier = 2 / (period + 1)
        ema = np.mean(data[:period])
        for price in data[period:]: ema = (price - ema) * multiplier + ema
        return ema

    def ensemble_vote(self, features, current_price, zone_status):
        if not ML_USE_ENSEMBLE_VOTING or not self.models_trained or features is None: return None, 0.0
        votes = {'buy': 0.0, 'sell': 0.0, 'hold': 0.0}
        
        pattern, pattern_conf = self.predict_pattern(features)
        if pattern == 1: votes['buy'] += ML_PATTERN_WEIGHT * pattern_conf
        elif pattern == 2: votes['sell'] += ML_PATTERN_WEIGHT * pattern_conf
        else: votes['hold'] += ML_PATTERN_WEIGHT
            
        pred_price = self.predict_price(features)
        if pred_price:
            price_change = (pred_price - current_price) / current_price
            if price_change > 0.01: votes['buy'] += ML_PRICE_PRED_WEIGHT * min(abs(price_change)*20, 1.0)
            elif price_change < -0.01: votes['sell'] += ML_PRICE_PRED_WEIGHT * min(abs(price_change)*20, 1.0)
            else: votes['hold'] += ML_PRICE_PRED_WEIGHT
                
        timing = self.score_timing(features)
        if zone_status == "BUY" and timing > 0.7: votes['buy'] += ML_TIMING_WEIGHT * timing
        elif zone_status == "SELL" and timing > 0.7: votes['sell'] += ML_TIMING_WEIGHT * timing
        else: votes['hold'] += ML_TIMING_WEIGHT * (1 - timing)
            
        risk = self.calculate_risk_score(features, current_price, zone_status)
        if risk < 0.3:
            if zone_status in ["BUY", "NEUTRAL"]: votes['buy'] += ML_RISK_WEIGHT * (1 - risk)
        elif risk > 0.7:
            votes['sell'] += ML_RISK_WEIGHT * risk
            votes['hold'] += ML_RISK_WEIGHT * risk * 0.5
            
        winner = max(votes, key=votes.get)
        confidence = votes[winner] / (sum(votes.values()) + 1e-10)
        return winner, confidence

    def update_adaptive_thresholds(self, prediction_accuracy):
        if not ML_ADAPTIVE_THRESHOLDS: return
        if prediction_accuracy > 0.7:
            self.adaptive_min_confidence = max(ML_MIN_CONFIDENCE - 0.05, 0.50)
            self.adaptive_risk_threshold = min(ML_MAX_RISK_THRESHOLD + 0.05, 0.80)
        elif prediction_accuracy < 0.5:
            self.adaptive_min_confidence = min(ML_MIN_CONFIDENCE + 0.10, 0.75)
            self.adaptive_risk_threshold = max(ML_MAX_RISK_THRESHOLD - 0.10, 0.55)

    def train_initial_models(self, historical_data):
        if len(historical_data) < ML_FEATURE_WINDOW + ML_PRICE_PRED_HORIZON:
            print(f"{COLOR_PURPLE}[ML] Insufficient historical data for training{COLOR_RESET}")
            return False
        print(f"{COLOR_PURPLE}[ML] Training on {len(historical_data)} real candles...{COLOR_RESET}")
        features_list = []
        price_targets, volatility_targets, pattern_targets = [], [], []
        
        for i in range(ML_FEATURE_WINDOW, len(historical_data) - ML_PRICE_PRED_HORIZON):
            window = historical_data[i-ML_FEATURE_WINDOW:i]
            prices = [x['close'] for x in window]
            volumes = [x['volume'] for x in window]
            ob_features = deque(maxlen=3)
            for j in range(i-ML_FEATURE_WINDOW, i):
                h, l, c = historical_data[j]['high'], historical_data[j]['low'], historical_data[j]['close']
                if c > 0:
                    buy_pressure = (h - c) / (c + 1e-8)
                    sell_pressure = (c - l) / (c + 1e-8)
                    imbalance = (buy_pressure - sell_pressure) / (buy_pressure + sell_pressure + 1e-8)
                else: imbalance = 0.0
                ob_features.append({'bid_volume': max(0, imbalance + 1.0), 'ask_volume': max(0, 2.0 - imbalance)})
            
            features = self.extract_features(deque(prices, maxlen=ML_FEATURE_WINDOW), deque(volumes, maxlen=ML_FEATURE_WINDOW), ob_features)
            if features is None: continue
            
            features_list.append(features)
            future_price = historical_data[i + ML_PRICE_PRED_HORIZON]['close']
            price_targets.append(future_price)
            
            future_prices_list = [x['close'] for x in historical_data[i:i+ML_PRICE_PRED_HORIZON+1]]
            future_returns = np.diff(np.array(future_prices_list)) / (np.array(future_prices_list[:-1]) + 1e-10)
            volatility_targets.append(np.std(future_returns))
            
            current_price = prices[-1]
            if future_price > current_price * 1.005: pattern_targets.append(1)
            elif future_price < current_price * 0.995: pattern_targets.append(2)
            else: pattern_targets.append(0)
            
        if len(features_list) < 10:
            print(f"{COLOR_PURPLE}[ML] Insufficient feature samples for training{COLOR_RESET}")
            return False
            
        X = np.array(features_list)
        self.price_scaler.fit(X)
        self.volatility_scaler.fit(X)
        self.pattern_scaler.fit(X)
        
        self.price_predictor.fit(self.price_scaler.transform(X), price_targets)
        pred_prices = self.price_predictor.predict(self.price_scaler.transform(X))
        rmse = np.sqrt(mean_squared_error(price_targets, pred_prices))
        print(f"{COLOR_PURPLE}[ML] Price predictor trained. RMSE: ${rmse:.4f}{COLOR_RESET}")
        
        self.volatility_predictor.fit(self.volatility_scaler.transform(X), volatility_targets)
        self.pattern_classifier.fit(self.pattern_scaler.transform(X), pattern_targets)
        accuracy = self.pattern_classifier.score(self.pattern_scaler.transform(X), pattern_targets)
        print(f"{COLOR_PURPLE}[ML] Pattern classifier trained. Accuracy: {accuracy*100:.1f}%{COLOR_RESET}")
        
        timing_targets = [(price_targets[i] - X[i][4]) / (X[i][4] + 1e-10) for i in range(len(X))]
        self.timing_scaler.fit(X)
        self.timing_scorer.fit(self.timing_scaler.transform(X), timing_targets)
        
        self.models_trained = True
        return True

    def retrain_models(self):
        if len(self.training_features) < ML_MIN_TRAIN_SAMPLES: return
        print(f"{COLOR_PURPLE}[ML] Retraining models with {len(self.training_features)} new samples...{COLOR_RESET}")
        X = np.array(self.training_features)
        try:
            self.price_predictor.fit(self.price_scaler.transform(X), self.training_prices)
            self.volatility_predictor.fit(self.volatility_scaler.transform(X), self.training_volatility)
            self.pattern_classifier.fit(self.pattern_scaler.transform(X), self.training_patterns)
            timing_targets = [(self.training_prices[i] - X[i][4]) / (X[i][4] + 1e-10) for i in range(len(X))]
            self.timing_scorer.fit(self.timing_scaler.transform(X), timing_targets)
            print(f"{COLOR_PURPLE}[ML] Models retrained successfully{COLOR_RESET}")
        except Exception as e:
            logging.error(f"[ML] Retraining error: {str(e)}")

    def predict_price(self, features):
        if not self.models_trained or features is None: return None
        try:
            X = self.price_scaler.transform(features.reshape(1, -1))
            return float(self.price_predictor.predict(X)[0])
        except: return None

    def predict_volatility(self, features):
        if not self.models_trained or features is None: return None
        try:
            X = self.volatility_scaler.transform(features.reshape(1, -1))
            return float(self.volatility_predictor.predict(X)[0])
        except: return None

    def predict_pattern(self, features):
        if not self.models_trained or features is None: return None, 0.0
        try:
            X = self.pattern_scaler.transform(features.reshape(1, -1))
            prediction = int(self.pattern_classifier.predict(X)[0])
            probabilities = self.pattern_classifier.predict_proba(X)[0]
            return prediction, float(np.max(probabilities))
        except: return None, 0.0

    def score_timing(self, features):
        if not self.models_trained or features is None: return 0.5
        try:
            X = self.timing_scaler.transform(features.reshape(1, -1))
            score = float(self.timing_scorer.predict(X)[0])
            return float(1 / (1 + np.exp(-score * 10)))
        except: return 0.5

    def calculate_risk_score(self, features, current_price, zone_status):
        if not self.models_trained or features is None: return 0.5
        try:
            pred_volatility = self.predict_volatility(features)
            volatility_risk = min(pred_volatility * 100, 1.0) if pred_volatility else 0.5
            pred_price = self.predict_price(features)
            direction_risk = (abs((pred_price - current_price) / current_price) * 10 if pred_price and current_price else 0.5)
            pattern, confidence = self.predict_pattern(features)
            confidence_risk = 1.0 - confidence if confidence else 1.0
            zone_risk = {"OUTSIDE": 0.8, "NEUTRAL": 0.5}.get(zone_status, 0.2)
            risk_score = (volatility_risk * 0.3 + direction_risk * 0.2 + confidence_risk * 0.3 + zone_risk * 0.2)
            return float(np.clip(risk_score, 0.0, 1.0))
        except: return 0.5

