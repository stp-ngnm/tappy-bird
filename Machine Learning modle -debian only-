                self.in_buy_zone = False
                self.buy_highs = []
                self.buy_lows = []
                tmp = self.min_avg_low_seen
                self.min_avg_low_seen = None
                buy_zone_mid = np.mean(self.buy_zone)
                if tmp is not None and tmp < buy_zone_mid:
