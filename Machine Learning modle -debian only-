                self.in_sell_zone = False
                self.sell_highs = []
                self.sell_lows = []
                tmp = self.max_avg_high_seen
                self.max_avg_high_seen = None
                if best_profit is not None and best_profit >= MIN_PROFIT:
                    return float(self.best_sell_price)
                else:
                    if DEBUG:
                        print(f"{COLOR_YELLOW}Exit-based sell condition not met (profit {best_profit}).{COLOR_RESET}")
            return None

    def track_best_buy(self, price):
        if price is None:
            return None

        zone = self.price_zone(price)

        if zone == "BUY":
            self.buy_highs.append(price)
            self.buy_lows.append(price)
            if not self.in_buy_zone:
                self.in_buy_zone = True
                self.best_buy_price = price
                self.min_avg_low_seen = np.mean(self.buy_lows) if self.buy_lows else price
                if DEBUG:
                    print(f"{COLOR_BLUE}Entered BUY zone. Tracking lows. initial avg_low={self.min_avg_low_seen:.4f}{COLOR_RESET}")
            else:
                if price < self.best_buy_price:
                    self.best_buy_price = price
                avg_low = np.mean(self.buy_lows) if self.buy_lows else self.best_buy_price
                if self.min_avg_low_seen is None or avg_low < self.min_avg_low_seen:
                    self.min_avg_low_seen = avg_low
                    if DEBUG:
                        print(f"{COLOR_BLUE}New min_avg_low_seen: ${self.min_avg_low_seen:.4f}{COLOR_RESET}")

            if BUY_AT_LOWEST_AVERAGE and self.min_avg_low_seen is not None:
                lower_thr = self.min_avg_low_seen * (1.0 - ENTRY_RANGE_PCT)
                upper_thr = self.min_avg_low_seen * (1.0 + ENTRY_RANGE_PCT)
                if lower_thr <= price <= upper_thr:
                    if DEBUG:
                        print(f"{COLOR_GREEN}BUY range condition met: price ${price:.4f} in [{lower_thr:.4f}, {upper_thr:.4f}]. Signaling buy at ref ${self.min_avg_low_seen:.4f}{COLOR_RESET}")
                    return float(self.min_avg_low_seen)
            return None

        else:
            if self.in_buy_zone:
                avg_high = np.mean(self.buy_highs) if self.buy_highs else None
                avg_low = np.mean(self.buy_lows) if self.buy_lows else None
                if DEBUG:
