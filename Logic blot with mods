# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time
    global last_trend, last_trade_type, trading_paused, KRAKEN_PAIR

    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zm = ZoneMachine()
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}")

    while True:
        try:
            # --- PAUSE MENU ---
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    continue
                if cmd == 'r':
                    trading_paused = False
                    print(f"{PROF_P}▶️ RESUMED{RESET}")
                    continue
                elif cmd == 'q':
                    print("👋 Exiting...")
                    sys.exit(0)
                elif cmd in ('b', 's'):
                    execute_manual(cmd)
                    continue
                else:
                    print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}")
                    continue

            # --- FETCH PRICE ---
            price = get_ticker()
            if not price:
                time.sleep(PRICE_CHECK_INTERVAL)
                continue
            price = round(price, 6)
            price_history.append(price)

            # --- 1. FETCH OHLC & CALCULATE ALL MATH ENGINES ---
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 50:
                aH = np.max([x['high'] for x in ohlc])
                aL = np.min([x['low'] for x in ohlc])
                aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2)

                if not zm.buy_zone:
                    zm.init(ohlc)

                # Zone expiry check
                if zm.expired(price):
                    zm.init(ohlc)

                # Hurst Exponent (Regime Detection)
                closes = np.array([x['close'] for x in ohlc])
                hurst_val = hurst_exponent(closes)
                regime = classify_market_regime(hurst_val)

                # MACD (Directional Bias)
                macd_line, sig_line, _ = calc_macd(ohlc)
                macd_trend = "up" if macd_line and sig_line and macd_line > sig_line else "down"
            else:
                aH = aL = aM = 0.0
                hurst_val = 0.5
                regime = "random_walk"
                macd_trend = "neutral"

            last_trend = macd_trend

            # --- 2. STOP LOSS ---
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                res = place_order('sell', token_amount, price,
                                  ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                if res and not res.get('error'):
                    trade_history.append({'profit': calc_profit(entry_price, price, token_amount)})
                    active_position = False
                    token_amount = 0
                    last_trade_time = time.time()
                    last_trade_type = "STOP-LOSS"
                    print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL)
                continue

            # --- 3. SMART BUY (Kelly Sizing + Hurst/MACD Regime Gate) ---
            cooldown_elapsed = (time.time() - last_trade_time) > AUTO_COOLDOWN_SEC
            if not active_position and cooldown_elapsed and zm.buy_sig(price):
                # Math Confidence Check:
                # Mean-reverting = aggressive zone targeting
                # Random walk = only if MACD not pointing down
                # Trending down = BLOCK (don't catch falling knife)
                can_buy = False
                if regime == "mean_reverting":
                    can_buy = True
                elif regime == "random_walk" and macd_trend != "down":
                    can_buy = True
                # trending + down = blocked
                # trending + up = could buy but zones unlikely to trigger in a trend

                if can_buy:
                    # Kelly Sizing Logic
                    base_invest = INVESTMENT_AMOUNT
                    if USE_KELLY_SIZING and len(trade_history) >= 5:
                        wins = [t for t in trade_history if t['profit'] > 0]
                        losses = [t for t in trade_history if t['profit'] <= 0]
                        win_rate = len(wins) / len(trade_history)
                        avg_win = np.mean([t['profit'] for t in wins]) if wins else 0.15
                        avg_loss = abs(np.mean([t['profit'] for t in losses])) if losses else 0.08
                        kelly_invest = kelly_position_size(base_invest, win_rate, avg_win, avg_loss)
                        # 🛡️ CAP: Never exceed base + MAX_KELLY_INCREASE_PCT
                        max_allowed = base_invest * (1 + MAX_KELLY_INCREASE_PCT)
                        actual_invest = min(kelly_invest, max_allowed)
                    else:
                        actual_invest = base_invest

                    amt = actual_invest / price
                    if amt * price < MIN_ORDER_USD:
                        time.sleep(PRICE_CHECK_INTERVAL)
                        continue

                    res = place_order('buy', amt, price)
                    if res and not res.get('error'):
                        active_position = True
                        entry_price = price
                        token_amount = amt
                        last_trade_time = time.time()
                        last_trade_type = "AUTO BUY"
                        txid = "N/A"
                        try:
                            txid = res.get('result', {}).get('txid', [])[0]
                        except:
                            pass
                        print_ticket("BUY", "SUCCESS", price, amt, txid=txid, trade_type="AUTO")

            # --- 4. SMART SELL (Optimal Stopping + Zone + Average) ---
            if active_position:
                target_profit, trailing_stop = calculate_dynamic_exit_threshold(
                    list(price_history), entry_price
                )
                current_profit = calc_profit(entry_price, price, token_amount)

                can_sell = False
                # Trigger A: Hit dynamic profit target
                if current_profit >= target_profit:
                    can_sell = True
                # Trigger B: Price breaks trailing stop while in profit (instant lock)
                elif trailing_stop > 0 and price <= trailing_stop and current_profit > 0:
                    can_sell = True
                # Trigger C: Zone sell signal + average high confirmation + min profit
                elif zm.sell_sig(price, entry_price, token_amount):
                    can_sell = True

                if can_sell:
                    res = place_order('sell', token_amount, price)
                    if res and not res.get('error'):
                        trade_history.append({'profit': current_profit})
                        active_position = False
                        token_amount = 0
                        last_trade_time = time.time()
                        last_trade_type = "AUTO SELL"
                        txid = "N/A"
                        try:
                            txid = res.get('result', {}).get('txid', [])[0]
                        except:
                            pass
                        print_ticket("SELL", "SUCCESS", price, token_amount, txid=txid, trade_type="AUTO")

            # --- 5. PRINT DASHBOARD ---
            prof = calc_profit(entry_price, price, token_amount) if active_position else 0.0
            print_dash(price, zm, last_trend, active_position, token_amount,
                       prof, last_trade_type, entry_price, aH, aL, aM, regime, hurst_val)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, "
                  f"{SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}")
            time.sleep(10)


