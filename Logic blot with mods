# ========================== 🧠 MAIN LOOP ==========================
def main():
    global active_position, entry_price, token_amount, last_trade_time, last_trend, last_trade_type, trading_paused, KRAKEN_PAIR
    KRAKEN_PAIR = get_valid_kraken_pair(TRADING_PAIR)
    zm = ZoneMachine()
    print(f"🚀 Bot Started. Monitoring {KRAKEN_PAIR} continuously...")
    print(f"{BORDER}Press Ctrl+C anytime to pause.{RESET}")
    
    while True:
        try:
            # ======== PAUSED STATE (Priority Input Loop) ========
            if trading_paused:
                try:
                    cmd = input(f"\n{BORDER}[PAUSED] > {RESET}").strip().lower()
                except (EOFError, KeyboardInterrupt): continue
                if cmd == 'r': trading_paused = False; print(f"{PROF_P}▶️ RESUMED{RESET}"); continue
                elif cmd == 'q': print("👋 Exiting..."); sys.exit(0)
                elif cmd in ('b', 's'): execute_manual(cmd); continue
                else: print(f"{SUB}Unknown command. Use: r, q, b, s{RESET}"); continue

            # ======== RUNNING STATE ========
            price = get_ticker()
            if not price: time.sleep(PRICE_CHECK_INTERVAL); continue
            price = round(price, 4)

            # 1. Fetch 5-Hour OHLC (Drives all parameters & zones)
            ohlc = get_ohlc(KRAKEN_PAIR, 1, MEDIAN_LOOKBACK)
            if ohlc and len(ohlc) >= 10:
                aH = np.max([x['high'] for x in ohlc])
                aL = np.min([x['low'] for x in ohlc])
                aM = float((np.median([x['high'] for x in ohlc]) + np.median([x['low'] for x in ohlc])) / 2)
                if not zm.ceiling_price: zm.init(ohlc)
                
                # Hurst Exponent for Trend Classification
                closes = np.array([x['close'] for x in ohlc])
                hurst_val = hurst_exponent(closes) if len(closes) >= 40 else 0.5
            else:
                aH = aL = aM = 0.0; hurst_val = 0.5

            # MACD for Trend Direction
            macd_line, sig_line, _ = calc_macd(ohlc) if ohlc else (None, None, None)
            
            # Combine Hurst Regime + MACD Direction for Trend Display
            if hurst_val > 0.55: trend = "up" if macd_line and macd_line > sig_line else "down"
            elif hurst_val < 0.45: trend = "soft up" if macd_line and macd_line > sig_line else "soft down"
            else: trend = "neutral"
            last_trend = trend

            # 2. Determine Overlay Zone State
            zone_state = zm.get_action_zone(price)
            current_profit = calc_profit(entry_price, price, token_amount) if active_position else 0.0
            profit_met = current_profit >= MIN_PROFIT

            # 3. Stop Loss Check (Overrides All)
            if active_position and price < entry_price * (1 - STOP_LOSS_PCT):
                place_order('sell', token_amount, price, ot='stop-loss-limit', p2=price * (1 - STOP_LOSS_LIMIT_BUFFER))
                active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "STOP-LOSS"
                print_ticket("SELL", "STOP-LOSS", price, token_amount, trade_type="AUTO")
                time.sleep(PRICE_CHECK_INTERVAL); continue

            # 4. AUTO BUY GATE (Only in ACTION_BUY or EXPECTANT_B, Block NEUTRAL/OUT)
            cooldown_elapsed = (time.time() - last_trade_time) > AUTO_COOLDOWN_SEC
            if not active_position and cooldown_elapsed and zone_state in ["ACTION_BUY", "EXPECTANT_B"]:
                amt = INVESTMENT_AMOUNT / price
                if amt * price >= MIN_ORDER_USD:
                    res = place_order('buy', amt, price)
                    if res and not res.get('error'):
                        active_position = True; entry_price = price; token_amount = amt
                        last_trade_time = time.time(); last_trade_type = "AUTO BUY"
                        print_ticket("BUY", "SUCCESS", price, amt, trade_type="AUTO")

            # 5. AUTO SELL GATE (Only in ACTION_SELL or EXPECTANT_S, Block NEUTRAL/OUT)
            if active_position and zone_state in ["ACTION_SELL", "EXPECTANT_S"] and profit_met:
                res = place_order('sell', token_amount, price)
                if res and not res.get('error'):
                    active_position = False; token_amount = 0; last_trade_time = time.time(); last_trade_type = "AUTO SELL"
                    print_ticket("SELL", "SUCCESS", price, token_amount, trade_type="AUTO")

            # 6. Print Dashboard
            print_dash(price, zm, last_trend, active_position, token_amount, current_profit, last_trade_type, entry_price, aH, aL, aM, hurst_val)
            time.sleep(PRICE_CHECK_INTERVAL)

        except KeyboardInterrupt:
            trading_paused = True
            print(f"\n{BORDER}⏸️ PAUSED{RESET} | Commands: {SUB}r{RESET}=resume, {SUB}q{RESET}=quit, {SUB}b{RESET}=buy, {SUB}s{RESET}=sell")
        except Exception as e:
            logging.error(f"Error: {e}"); time.sleep(10)

if __name__ == "__main__": main()