# ========================== 🧮 COMPLEX MATHEMATICAL ENGINES ==========================

def calculate_adaptive_zones(ohlc):
    """IQR + Rolling StdDev Volatility-Adaptive Zones"""
    if not ohlc or len(ohlc) < 50:
        return None, None, None, 0.0
    closes = np.array([x['close'] for x in ohlc])
    median_price = np.median(closes)

    # Rolling Standard Deviation (short-term volatility)
    vl = min(VOLATILITY_LOOKBACK, len(closes))
    roll_std = np.std(closes[-vl:])

    # Interquartile Range (smoothed distribution)
    il = min(IQR_LOOKBACK, len(closes))
    q25, q75 = np.percentile(closes[-il:], [25, 75])
    iqr = q75 - q25

    # Combined volatility factor
    vol_factor = max(roll_std, iqr * IQR_WEIGHT)
    if vol_factor == 0:
        vol_factor = median_price * 0.01

    # Build zones from the median outward
    neutral_width = vol_factor * NEUTRAL_ZONE_FACTOR
    buy_extra = vol_factor * ZONE_EXPANSION_FACTOR
    sell_extra = vol_factor * ZONE_EXPANSION_FACTOR

    buy_zone = (round(median_price - neutral_width - buy_extra, 6),
                round(median_price - neutral_width, 6))
    neutral_zone = (round(median_price - neutral_width, 6),
                    round(median_price + neutral_width, 6))
    sell_zone = (round(median_price + neutral_width, 6),
                 round(median_price + neutral_width + sell_extra, 6))

    return buy_zone, neutral_zone, sell_zone, median_price


def calculate_fixed_zones(median_price):
    """Fallback Fixed Dollar Zones (used when USE_IQR_ADAPTIVE_ZONES = False)"""
    nl = round(median_price - ZONE_BUFFER / 2, 6)
    nu = round(median_price + ZONE_BUFFER / 2, 6)
    neutral_zone = (nl, nu)
    buy_zone = (round(nl - BUY_ZONE_EXTRA, 6), nl)
    sell_zone = (nu, round(nu + SELL_ZONE_EXTRA, 6))
    return buy_zone, neutral_zone, sell_zone


def hurst_exponent(prices, max_lag=20):
    """Rescaled Range Analysis for Market Regime Classification"""
    n = len(prices)
    if n < max_lag * 2:
        return 0.5
    lags = np.arange(2, max_lag)
    tau = []
    for lag in lags:
        diff = prices[lag:] - prices[:-lag]
        std_val = np.std(diff)
        tau.append(std_val if std_val > 0 else 1e-9)
    tau = np.array(tau)
    poly = np.polyfit(np.log(lags), np.log(tau), 1)
    return poly[0] * 2.0


def classify_market_regime(h):
    if h > 0.55:
        return "trending"
    elif h < 0.45:
        return "mean_reverting"
    else:
        return "random_walk"


def calculate_dynamic_exit_threshold(prices, entry_p, k=1.5):
    """Ornstein-Uhlenbeck Optimal Stopping Threshold + Trailing Stop"""
    if len(prices) < 20:
        return MIN_PROFIT, 0.0
    recent = np.array(prices)
    mean = np.mean(recent)
    sigma = np.std(recent)
    if sigma == 0:
        return MIN_PROFIT, 0.0
    dynamic_target = mean + (k * sigma)
    trailing_stop = mean - (k * 0.6 * sigma)
    target_profit = max(dynamic_target - entry_p, MIN_PROFIT)
    return target_profit, trailing_stop


def kelly_position_size(max_bet, win_rate, avg_win, avg_loss, max_fraction=0.25):
    """Fractional Kelly Criterion for Dynamic Position Sizing"""
    if avg_loss == 0 or win_rate == 0:
        return max_bet * 0.05
    b = avg_win / avg_loss
    p = win_rate
    q = 1 - p
    kelly_f = (b * p - q) / b
    safe_f = min(max(kelly_f * 0.5, 0.01), max_fraction)
    return max_bet * safe_f


def calc_macd(ohlc):
    """Proper EMA-based MACD"""
    if len(ohlc) < MACD_SLOW + MACD_SIGNAL:
        return None, None, None
    c = [x['close'] for x in ohlc]

    def ema(d, sp):
        a = 2 / (sp + 1)
        v = [d[0]]
        for x in d[1:]:
            v.append(a * x + (1 - a) * v[-1])
        return v

    fast_ema = ema(c, MACD_FAST)
    slow_ema = ema(c, MACD_SLOW)
    ml = [x - y for x, y in zip(fast_ema, slow_ema)]
    sl = ema(ml, MACD_SIGNAL)
    return ml[-1], sl[-1], (ml[-1] - sl[-1])


# ========================== API / UTILS ==========================

def get_valid_kraken_pair(pair):
    variations = [pair, f"X{pair}", f"{pair}Z", f"X{pair}Z", pair.replace("USD", "ZUSD")]
    for v in variations:
        try:
            r = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={v}', timeout=5).json()
            if 'error' not in r or not r['error']:
                return v
        except:
            continue
    return pair


def get_ticker():
    try:
        r = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={KRAKEN_PAIR}', timeout=5).json()
        if 'error' not in r or not r['error']:
            return float(r['result'][list(r['result'].keys())[0]]['c'][0])
    except:
        pass
    return None


def get_ohlc(pair, interval, lookback):
    since = int((time.time() - lookback * interval * 60) // 1)
    try:
        r = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC",
                         params={'pair': pair, 'interval': interval, 'since': since}, timeout=10).json()
        if 'error' in r and r['error']:
            return []
        pk = list(r['result'].keys())[0]
        return [{'timestamp': float(x[0]), 'high': float(x[2]), 'low': float(x[3]), 'close': float(x[4])}
                for x in r['result'][pk]]
    except:
        return []


def get_order_book(pair, count=ORDERBOOK_DEPTH_LEVELS):
    try:
        r = requests.get(f"{API_URL}/{API_VERSION}/public/Depth",
                         params={'pair': pair, 'count': min(count, 500)}, timeout=10).json()
        if 'error' in r and r['error']:
            return None
        pk = list(r['result'].keys())[0]
        ob = r['result'][pk]
        return {'bids': [(float(p), float(v)) for p, v, *_ in ob.get('bids', [])],
                'asks': [(float(p), float(v)) for p, v, *_ in ob.get('asks', [])]}
    except:
        return None


def kraken_req(path, data):
    h = {'API-Key': API_KEY}
    n = str(int(time.time() * 1000))
    data['nonce'] = n
    msg = path.encode() + hashlib.sha256((n + urllib.parse.urlencode(data)).encode()).digest()
    sec = API_SECRET.strip().replace('\n', '').replace(' ', '')
    if len(sec) % 4:
        sec += '=' * (4 - len(sec) % 4)
    try:
        h['API-Sign'] = base64.b64encode(
            hmac.new(base64.b64decode(sec), msg, hashlib.sha512).digest()
        ).decode()
        for a in range(3):
            try:
                r = requests.post(API_URL + path, data=data, headers=h, timeout=10)
                if r.status_code == 429:
                    time.sleep(min(60, 2 ** a + 1))
                    continue
                return r.json()
            except:
                time.sleep(2 ** a)
        return {'error': ['Max retries']}
    except Exception as e:
        return {'error': [str(e)]}


def place_order(otype, amt, price, ot='market', p2=None):
    # ✅ PRECISION FIX: Kraken rejects 8 decimals on sub-$1 pairs
    if price < 1.0:
        amt = round(amt, 4)
    else:
        amt = round(amt, BOND_DECIMALS)

    d = {'ordertype': ot, 'type': otype, 'volume': str(amt), 'pair': KRAKEN_PAIR, 'validate': 'false'}
    if ot == 'limit':
        d['price'] = str(round(price, 8))
    elif ot == 'stop-loss-limit':
        d['price'] = str(round(price, 8))
        d['price2'] = str(round(p2, 8))
    return kraken_req(f'/{API_VERSION}/private/AddOrder', d)


def calc_profit(entry, exit_p, amt):
    if entry and exit_p and amt:
        return (amt * exit_p * (1 - FEE_RATE)) - (amt * entry * (1 + FEE_RATE))
    return 0.0


# ========================== 🗺️ ZONE MACHINE ==========================
class ZoneMachine:
    def __init__(self):
        self.buy_zone = self.neutral_zone = self.sell_zone = None
        self.median = 0.0
        self.avg_high = 0.0
        self.avg_low = 0.0
        self.bl = []
        self.sh = []
        self.mal = self.mah = None

    def init(self, ohlc):
        if not ohlc or len(ohlc) < 10:
            return False
        h = np.array([x['high'] for x in ohlc])
        l = np.array([x['low'] for x in ohlc])
        self.median = float((np.median(h) + np.median(l)) / 2)
        self.avg_high = float(np.max(h))
        self.avg_low = float(np.min(l))

        if USE_IQR_ADAPTIVE_ZONES:
            bz, nz, sz, _ = calculate_adaptive_zones(ohlc)
            if bz:
                self.buy_zone, self.neutral_zone, self.sell_zone = bz, nz, sz
            else:
                self.buy_zone, self.neutral_zone, self.sell_zone = calculate_fixed_zones(self.median)
        else:
            self.buy_zone, self.neutral_zone, self.sell_zone = calculate_fixed_zones(self.median)

        self._reset()
        return True

    def _reset(self):
        self.bl = []
        self.sh = []
        self.mal = self.mah = None

    def zone(self, p):
        if self.buy_zone and self.buy_zone[0] <= p < self.buy_zone[1]:
            return "BUY"
        if self.neutral_zone and self.neutral_zone[0] <= p <= self.neutral_zone[1]:
            return "NEUTRAL"
        if self.sell_zone and self.sell_zone[0] < p <= self.sell_zone[1]:
            return "SELL"
        return "OUTSIDE"

    def expired(self, p):
        global outside_zone_since
        now = time.time()
        if self.zone(p) == "OUTSIDE":
            if outside_zone_since is None:
                outside_zone_since = now
            elif now - outside_zone_since > ZONE_RESET_HOLD_TIME:
                outside_zone_since = None
                return True
        else:
            outside_zone_since = None
        return False

    def buy_sig(self, p):
        if self.zone(p) == "BUY":
            self.bl.append(p)
            if self.mal is None or np.mean(self.bl) < self.mal:
                self.mal = np.mean(self.bl)
            if BUY_AT_LOWEST_AVERAGE and self.mal:
                return self.mal * (1 - ENTRY_RANGE_PCT) <= p <= self.mal * (1 + ENTRY_RANGE_PCT)
            return True
        return False

    def sell_sig(self, p, ep, amt):
        if self.zone(p) == "SELL":
            self.sh.append(p)
            if self.mah is None or np.mean(self.sh) > self.mah:
                self.mah = np.mean(self.sh)
            if SELL_AT_HIGHEST_AVERAGE and self.mah:
                return self.mah * (1 - ENTRY_RANGE_PCT) <= p <= self.mah * (1 + ENTRY_RANGE_PCT)
            return calc_profit(ep, p, amt) >= MIN_PROFIT
        return False


