# ========================== API / UTILS ==========================
def get_valid_kraken_pair(pair):
    variations = [pair, f"X{pair}", f"{pair}Z", f"X{pair}Z", pair.replace("USD", "ZUSD"), f"X{pair.replace('USD', '')}ZUSD"]
    for variation in variations:
        try:
            response = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={variation}', timeout=5)
            data = response.json()
            if 'error' not in data or not data['error']: return variation
        except: continue
    return pair

def get_ticker():
    try:
        r = requests.get(f'{API_URL}/{API_VERSION}/public/Ticker?pair={KRAKEN_PAIR}', timeout=5).json()
        if 'error' not in r or not r['error']: return float(r['result'][list(r['result'].keys())[0]]['c'][0])
    except: pass
    return None

def get_ohlc(pair, interval, lookback):
    since = int((time.time() - lookback * interval * 60) // 1)
    try:
        r = requests.get(f"{API_URL}/{API_VERSION}/public/OHLC", params={'pair': pair, 'interval': interval, 'since': since}, timeout=10).json()
        if 'error' in r and r['error']: return []
        pk = list(r['result'].keys())[0]
        return [{'timestamp': float(x[0]), 'high': float(x[2]), 'low': float(x[3]), 'close': float(x[4])} for x in r['result'][pk]]
    except: return []

def get_order_book(pair, count=ORDERBOOK_DEPTH_LEVELS):
    try:
        r = requests.get(f"{API_URL}/{API_VERSION}/public/Depth", params={'pair': pair, 'count': min(count, 500)}, timeout=10).json()
        if 'error' in r and r['error']: return None
        pk = list(r['result'].keys())[0]
        ob = r['result'][pk]
        return {'bids': [(float(p), float(v)) for p, v, *_ in ob.get('bids', [])], 'asks': [(float(p), float(v)) for p, v, *_ in ob.get('asks', [])]}
    except: return None

def kraken_req(path, data):
    h = {'API-Key': API_KEY}; n = str(int(time.time()*1000)); data['nonce'] = n
    msg = path.encode() + hashlib.sha256((n + urllib.parse.urlencode(data)).encode()).digest()
    sec = API_SECRET.strip().replace('\n','').replace(' ','')
    if len(sec)%4: sec += '='*(4-len(sec)%4)
    try:
        h['API-Sign'] = base64.b64encode(hmac.new(base64.b64decode(sec), msg, hashlib.sha512).digest()).decode()
        for a in range(3):
            try:
                r = requests.post(API_URL+path, data=data, headers=h, timeout=10)
                if r.status_code == 429: time.sleep(min(60, 2**a+1)); continue
                return r.json()
            except: time.sleep(2**a)
        return {'error':['Max retries']}
    except Exception as e: return {'error':[str(e)]}

def place_order(otype, amt, price, ot='market', p2=None):
    if price < 1.0: amt = round(amt, 4) # Precision fix for sub-$1 pairs
    else: amt = round(amt, BOND_DECIMALS)
    d = {'ordertype':ot, 'type':otype, 'volume':str(amt), 'pair':KRAKEN_PAIR, 'validate':'false'}
    if ot=='limit': d['price']=str(round(price,8))
    elif ot=='stop-loss-limit': d['price'], d['price2'] = str(round(price,8)), str(round(p2,8))
    return kraken_req(f'/{API_VERSION}/private/AddOrder', d)

def calc_profit(entry, exit_p, amt):
    return (amt*exit_p*(1-FEE_RATE)) - (amt*entry*(1+FEE_RATE)) if entry and exit_p and amt else 0.0

def calc_macd(ohlc, f=MACD_FAST, s=MACD_SLOW, sig=MACD_SIGNAL):
    if len(ohlc)<s+sig: return None, None, None
    c = [x['close'] for x in ohlc]
    def ema(d, sp): a=2/(sp+1); v=[d[0]]; [v.append(a*x+(1-a)*v[-1]) for x in d[1:]]; return v
    ml = [x-y for x,y in zip(ema(c,f), ema(c,s))]
    sl = ema(ml, sig)
    return ml[-1], sl[-1], None

def hurst_exponent(prices, max_lag=20):
    """Fast vectorized Hurst calculation for regime detection"""
    n = len(prices)
    if n < max_lag * 2: return 0.5
    lags = np.arange(2, max_lag)
    tau = [np.std(np.subtract(prices[lag:], prices[:-lag])) for lag in lags]
    tau = [t if t > 0 else 1e-9 for t in tau]
    poly = np.polyfit(np.log(lags), np.log(tau), 1)
    return poly[0] * 2.0

# ========================== 🗺️ 7-LAYER OVERLAY ZONE MACHINE ==========================
class ZoneMachine:
    def __init__(self):
        self.median = 0.0
        self.neutral_low = 0.0; self.neutral_high = 0.0
        self.sell_range = 0.0; self.buy_range = 0.0
        self.expectant_sell = 0.0; self.expectant_buy = 0.0
        self.ceiling_price = 0.0; self.floor_price = 0.0

    def init(self, ohlc):
        if not ohlc or len(ohlc) < 10: return False
        h = np.array([x['high'] for x in ohlc])
        l = np.array([x['low'] for x in ohlc])
        c = np.array([x['close'] for x in ohlc])
        
        self.median = float((np.median(h) + np.median(l)) / 2)
        
        # 1. Neutral Zone (Static Buffer)
        self.neutral_low = round(self.median - ZONE_BUFFER / 2, 4)
        self.neutral_high = round(self.median + ZONE_BUFFER / 2, 4)
        
        # 2. Volatility Factor (Dynamic Math)
        vol_factor = max(np.std(c[-60:]), 0.0001) 
        
        # 3. Action Ranges (Logic Triggers - 2.0 Sigma)
        self.sell_range = round(self.neutral_high + (vol_factor * 2.0), 4)
        self.buy_range = round(self.neutral_low - (vol_factor * 2.0), 4)
        
        # 4. Expectant Ranges (ML Watch Zones - 4.0 Sigma)
        self.expectant_sell = round(self.neutral_high + (vol_factor * 4.0), 4)
        self.expectant_buy = round(self.neutral_low - (vol_factor * 4.0), 4)
        
        # 5. Hard Boundaries (Structural Limits - Config Extras)
        self.ceiling_price = round(self.neutral_high + SELL_ZONE_EXTRA, 4)
        self.floor_price = round(self.neutral_low - BUY_ZONE_EXTRA, 4)
        
        return True

    def get_action_zone(self, p):
        """Maps price to the 7-layer overlay architecture"""
        if p >= self.ceiling_price: return "OUT_HIGH"
        if p >= self.expectant_sell: return "EXPECTANT_S"
        if p >= self.sell_range: return "ACTION_SELL"
        if p >= self.neutral_high: return "NEUTRAL"
        if p >= self.neutral_low: return "NEUTRAL"
        if p >= self.buy_range: return "ACTION_BUY"
        if p >= self.expectant_buy: return "EXPECTANT_B"
        if p >= self.floor_price: return "EXPECTANT_B"
        return "OUT_LOW"

